ddn "0.3";
module "ddn.usecases.governance";

// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    object product "Customer data product" {
        kind: data_product;
    }
    object contract "Customer export contract" {
        kind: dct;
    }
    object team "Customer data team" {
        kind: team;
    }
    relation r_contract @product -> @contract { kind: contract; }
    relation r_owner @contract -> @team { kind: steward; scope: "contract stewardship"; }
}
