ddn "0.3";
module "ddn.examples.spacing-hints";
import "shared.ddn" as shared;
data model {
 object orders "Order capture" { kind: application; role: authoritative; }
 object ledger "Ledger posting" { kind: application; role: authoritative; }
 object journal "Posted journals" { kind: table; role: authoritative; fields { field journal_id; field period_id; } }
 object analytics "Margin analytics" { kind: dataset; role: derived; }
 relation posts "Posts every approved order into the ledger for reconciliation" @orders -> @ledger { kind: flow; }
 relation records @ledger -> @journal { kind: assoc; }
 relation feeds @journal -> @analytics { kind: assoc; }
}
view tight "Spacing / tight" {
 data: [@model]; format: @shared.styles.technical; spacing: tight;
 publication { size: content; fit: none; overflow: error; minimum_text: 8pt; }
}
view normal "Spacing / normal (default)" {
 data: [@model]; format: @shared.styles.technical;
 publication { size: content; fit: none; overflow: error; minimum_text: 8pt; }
}
view loose "Spacing / loose" {
 data: [@model]; format: @shared.styles.technical; spacing: loose;
 publication { size: content; fit: none; overflow: error; minimum_text: 8pt; }
}
view expanded "Spacing / expanded" {
 data: [@model]; format: @shared.styles.technical; spacing: expanded;
 publication { size: content; fit: none; overflow: error; minimum_text: 8pt; }
}
