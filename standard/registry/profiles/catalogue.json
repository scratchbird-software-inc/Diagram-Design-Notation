  "profiles": [
    {
      "id": "ddn@1",
      "projection": "graph",
      "diagramFamilies": [
        "DDN graph"
      ],
      "scope": "Existing DDN notation",
      "validation": [
        "existing core contracts"
      ],
      "unsupported": []
    },
    {
      "id": "flow.basic@1",
      "projection": "graph",
      "diagramFamilies": [
        "Conventional flowchart",
        "Accounting/audit flowchart"
      ],
      "scope": "Start/end, process, decision, I/O, document and predefined process; named branches.",
      "validation": [
        "start has no incoming edge; end has no outgoing edge",
        "decisions have >=2 distinct nonempty branch labels",
        "every process reachable from a start and can reach an end"
      ],
      "unsupported": [
        "execution",
        "complete standardized accounting symbol inventory"
      ]
    },
    {
      "id": "dfd.gane_sarson@1",
      "projection": "graph",
      "diagramFamilies": [
        "Gane\u2013Sarson DFD"
      ],
      "scope": "Numbered three-compartment processes; open-ended stores and external entities.",
      "validation": [
        "data flows cannot directly connect two non-process elements",
        "process has input/output",
        "unique process numbers"
      ],
      "unsupported": [
        "method certification",
        "automatic context balancing across arbitrary diagrams"
      ]
    },
    {
      "id": "dfd.yourdon@1",
      "projection": "graph",
      "diagramFamilies": [
        "Yourdon-style DFD"
      ],
      "scope": "Circular processes; parallel-line stores; rectangular external entities.",
      "validation": [
        "same structural checks as Gane\u2013Sarson"
      ],
      "unsupported": [
        "complete SSADM lifecycle",
        "method certification"
      ]
    },
    {
      "id": "uml.structure@1",
      "projection": "graph",
      "diagramFamilies": [
        "UML class subset",
        "UML package subset",
        "UML component subset"
      ],
      "scope": "Class/interface attribute and operation compartments; package tabs; component markers; generalization/dependency/realization.",
      "validation": [
        "profile endpoint restrictions",
        "acyclic generalization",
        "same-kind generalization",
        "operation/attribute visibility enumeration"
      ],
      "unsupported": [
        "XMI",
        "OCL",
        "full UML type/parameter model",
        "assembly interfaces",
        "formal UML conformance"
      ]
    },
    {
      "id": "uml.usecase@1",
      "projection": "graph",
      "diagramFamilies": [
        "Use-case diagram subset"
      ],
      "scope": "Actors, use-case ellipses, associations, include/extend/generalization.",
      "validation": [
        "correct actor/use-case endpoints",
        "acyclic include and generalization"
      ],
      "unsupported": [
        "extension-point model",
        "full UML behavior semantics"
      ]
    },
    {
      "id": "requirements.basic@1",
      "projection": "graph",
      "diagramFamilies": [
        "Requirements traceability"
      ],
      "scope": "Requirement IDs/text, satisfies/verifies/derives links.",
      "validation": [
        "nonempty unique requirement codes",
        "compatible verification/implementation endpoints"
      ],
      "unsupported": [
        "SysML conformance",
        "evidence of operating effectiveness"
      ]
    },
    {
      "id": "chen.basic@1",
      "projection": "chen",
      "diagramFamilies": [
        "Chen ER binary subset"
      ],
      "scope": "Entity rectangles; field-derived attribute ovals with key underlining; binary association diamonds.",
      "validation": [
        "scalar attribute projection",
        "binary association mapping with stable provenance"
      ],
      "unsupported": [
        "weak entities",
        "n-ary association model",
        "multivalued/derived attributes",
        "faithful all-Chen conformance"
      ]
    },
    {
      "id": "matrix.raci@1",
      "projection": "matrix",
      "diagramFamilies": [
        "RACI matrix"
      ],
