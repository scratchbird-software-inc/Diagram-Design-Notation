{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ddn:layout-state:1",
  "type": "object",
  "required": [
    "format",
    "view",
    "positions"
  ],
  "properties": {
    "format": {
      "const": "ddn-layout-state@1"
    },
    "view": {
      "type": "string",
      "minLength": 1
    },
    "positions": {
      "type": "object",
      "maxProperties": 500,
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "additionalProperties": false
}
