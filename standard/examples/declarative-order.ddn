ddn "0.7";
module "declarative.order";
architecture project { files: ["declarative-order.ddna"]; }
data totals {
  object gross "Gross total" { kind: object; }
  object net "Discounted total" { kind: object; }
  relation dependency @gross -> @net { kind: assoc; }
}
view main "Declarative order calculation" {
  data: [@totals];
  layout { algorithm: grid; }
  publication { size: content; fit: none; }
}
