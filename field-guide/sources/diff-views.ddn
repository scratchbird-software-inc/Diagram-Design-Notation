ddn "0.6";
module "ddn.fieldguide.diff";

// Diff views (spec ch. 55 §55.6): diff: [@v1, @v2] renders the union of both
// views' visible models with per-member states. Members match by local
// source id in the data block — before.keep correlates with after.keep.

data before {
  object store "Shared store" { kind: cache; }
  object legacy "Legacy queue" { kind: queue; }
  object worker "Worker v1" { kind: service; fields { load: number; } }
  relation r1 @store -> @legacy { kind: flow; }
  relation r2 @store -> @worker { kind: flow; }
}

data after {
  object store "Shared store" { kind: cache; }
  object worker "Worker v2" { kind: service; fields { load: number; retries: number; } }
  object ingest "New ingest" { kind: service; }
  relation r2 @store -> @worker { kind: flow; }
  relation r3 @worker -> @ingest { kind: flow; }
}

view v1 "Before" {
  data: [@before];
}

view v2 "After" {
  data: [@after];
}

view main "Before → after" {
  diff: [@v1, @v2];
  publication { size: content; fit: none; }
}
