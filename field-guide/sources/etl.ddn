ddn "0.5";
module "ddn.fieldguide.etl";

// Synthetic nightly ETL pipeline (all systems invented): two operational
// sources land in a raw staging area, conformance transforms integrate and
// deduplicate, and two marts serve reporting. Drawn in the data-flow idiom:
// activities transform, datasets hold, read/write relations mark direction.
data pipeline {
    dataset shop "Shop OLTP" {description: "Synthetic order-taking source: orders, customers, payments."; }
    dataset crm "CRM extracts" {description: "Synthetic nightly customer-master extract files."; }
    activity land "Nightly landing" {description: "Synthetic copy job: source-faithful, no business rules."; }
    dataset raw "Raw staging" {description: "Synthetic landing zone: immutable copies with arrival metadata."; }
    activity conform "Conform and deduplicate" {description: "Synthetic transform: key mapping, survivorship, type alignment."; }
    dataset warehouse "Integrated warehouse" {description: "Synthetic conformed store: one customer, one order line."; }
    activity feed_sales "Sales slice build" {description: "Synthetic daily slice for order reporting."; }
    activity feed_churn "Churn feature build" {description: "Synthetic feature build for retention analysis."; }
    dataset sales_mart "Sales mart" {description: "Synthetic star for order reporting."; }
    dataset churn_mart "Churn mart" {description: "Synthetic features for retention analysis."; }
    read r1 @shop -> @land;
    read r2 @crm -> @land;
    write r3 @land -> @raw;
    read r4 @raw -> @conform;
    write r5 @conform -> @warehouse;
    read r6 @warehouse -> @feed_sales;
    write r7 @feed_sales -> @sales_mart;
    read r8 @warehouse -> @feed_churn;
    write r9 @feed_churn -> @churn_mart;
}

view diagram "Synthetic ETL / sources to marts": [@pipeline] as "ddn@1" {
    layout { algorithm: layered; direction: right; }
    publication { size: content; fit: none; }
}
