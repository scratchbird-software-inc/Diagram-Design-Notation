ddn "0.5";
module "ddn.fieldguide.etl";

// Synthetic nightly ETL pipeline (all systems invented): two operational
// sources land in a raw staging area, conformance transforms integrate and
// deduplicate, and two marts serve reporting. Drawn in the data-flow idiom:
// activities transform, datasets hold, read/write relations mark direction.
data pipeline {
    object shop "Shop OLTP" { kind: "dataset"; description: "Synthetic order-taking source: orders, customers, payments."; }
    object crm "CRM extracts" { kind: "dataset"; description: "Synthetic nightly customer-master extract files."; }
    object land "Nightly landing" { kind: "activity"; description: "Synthetic copy job: source-faithful, no business rules."; }
    object raw "Raw staging" { kind: "dataset"; description: "Synthetic landing zone: immutable copies with arrival metadata."; }
    object conform "Conform and deduplicate" { kind: "activity"; description: "Synthetic transform: key mapping, survivorship, type alignment."; }
    object warehouse "Integrated warehouse" { kind: "dataset"; description: "Synthetic conformed store: one customer, one order line."; }
    object feed_sales "Sales slice build" { kind: "activity"; description: "Synthetic daily slice for order reporting."; }
    object feed_churn "Churn feature build" { kind: "activity"; description: "Synthetic feature build for retention analysis."; }
    object sales_mart "Sales mart" { kind: "dataset"; description: "Synthetic star for order reporting."; }
    object churn_mart "Churn mart" { kind: "dataset"; description: "Synthetic features for retention analysis."; }
    relation r1 @shop -> @land { kind: read; }
    relation r2 @crm -> @land { kind: read; }
    relation r3 @land -> @raw { kind: write; }
    relation r4 @raw -> @conform { kind: read; }
    relation r5 @conform -> @warehouse { kind: write; }
    relation r6 @warehouse -> @feed_sales { kind: read; }
    relation r7 @feed_sales -> @sales_mart { kind: write; }
    relation r8 @warehouse -> @feed_churn { kind: read; }
    relation r9 @feed_churn -> @churn_mart { kind: write; }
}

view diagram "Synthetic ETL / sources to marts" {
    data: [@pipeline];
    projection { profile: "ddn@1"; }
    layout { algorithm: layered; direction: right; }
    publication { size: content; fit: none; }
}
