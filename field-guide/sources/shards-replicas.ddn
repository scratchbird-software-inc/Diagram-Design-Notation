ddn "0.5";
module "ddn.fieldguide.shards";

// Synthetic shard-and-replica placement (all infrastructure invented): the
// orders keyspace split into three shards, each shard led in one zone with
// its replicas placed in the other two. The diagram is the placement claim:
// which copy lives where, and which copy leads.
data cluster {
    object zone_a "Zone A" { kind: "zone"; description: "Synthetic failure zone A."; }
    object zone_b "Zone B" { kind: "zone"; description: "Synthetic failure zone B."; }
    object zone_c "Zone C" { kind: "zone"; description: "Synthetic failure zone C."; }
    object shard1 "Shard 1 (hash 0-33%)" { kind: "shard"; description: "Synthetic first key range; leader in zone A."; }
    object shard2 "Shard 2 (hash 34-66%)" { kind: "shard"; description: "Synthetic second key range; leader in zone B."; }
    object shard3 "Shard 3 (hash 67-100%)" { kind: "shard"; description: "Synthetic third key range; leader in zone C."; }
    object router "Query router" { kind: "application"; description: "Synthetic router: maps key to shard, reads from replicas."; }
    relation lead1 "leads in" @shard1 -> @zone_a { kind: "assoc"; }
    relation lead2 "leads in" @shard2 -> @zone_b { kind: "assoc"; }
    relation lead3 "leads in" @shard3 -> @zone_c { kind: "assoc"; }
    relation repl1b "replica" @shard1 -> @zone_b { kind: "assoc"; }
    relation repl1c "replica" @shard1 -> @zone_c { kind: "assoc"; }
    relation repl2a "replica" @shard2 -> @zone_a { kind: "assoc"; }
    relation repl2c "replica" @shard2 -> @zone_c { kind: "assoc"; }
    relation repl3a "replica" @shard3 -> @zone_a { kind: "assoc"; }
    relation repl3b "replica" @shard3 -> @zone_b { kind: "assoc"; }
    relation route1 "routes" @router -> @shard1 { kind: "flow"; }
    relation route2 "routes" @router -> @shard2 { kind: "flow"; }
    relation route3 "routes" @router -> @shard3 { kind: "flow"; }
}

view diagram "Synthetic shards and replicas / placement" {
    data: [@cluster];
    projection { profile: "ddn@1"; }
    layout { algorithm: layered; direction: right; }
    publication { size: content; fit: none; }
}
