[
  {
    "format": "ddn-designer-descriptor@1",
    "id": "editor.table",
    "version": "0.1",
    "status": "proposed",
    "targets": [
      "table"
    ],
    "basicLimit": 6,
    "conversionPolicy": "preview-conversion-never-recipe-only",
    "controls": [
      {
        "id": "name",
        "label": "Name",
        "scope": "model",
        "group": "basic",
        "widget": "text",
        "command": "setLabel",
        "adapterStatus": "existing",
        "valueStates": [
          "unset",
          "known"
        ],
        "defaultVisible": true,
        "reset": "remove-assertion",
        "multiEdit": false,
        "sourceBinding": "definition.label",
        "help": "Display name. Stable identity is unchanged.",
        "requiredFor": "draft"
      },
      {
        "id": "kind",
        "label": "Type",
        "scope": "model",
        "group": "basic",
        "widget": "select",
        "command": "planKindConversion",
        "adapterStatus": "new-core-required",
        "valueStates": [
          "unset",
          "known"
        ],
        "defaultVisible": true,
        "reset": "remove-assertion",
        "multiEdit": false,
        "sourceBinding": "definition.kind",
        "options": [
          {
            "value": "table",
            "label": "Table"
          },
          {
            "value": "view",
            "label": "SQL view"
          }
        ],
        "destructive": true,
        "help": "Changes meaning, not silhouette. Preview constraints, fields and affected views."
      },
      {
        "id": "fields",
        "label": "Fields",
        "scope": "model",
        "group": "basic",
        "widget": "fields_tree",
        "command": "editMembers",
        "adapterStatus": "new-core-required",
        "valueStates": [
          "unset",
          "known"
        ],
        "defaultVisible": true,
        "reset": "remove-assertion",
        "multiEdit": false,
        "sourceBinding": "definition.fields",
        "help": "Names first; domains and implementation types are optional. Existing single-field insertion can be wrapped."
      },
      {
        "id": "description",
        "label": "Description",
        "scope": "model",
        "group": "basic",
        "widget": "multiline",
        "command": "setProperty",
        "adapterStatus": "existing",
        "valueStates": [
          "unset",
          "known"
        ],
        "defaultVisible": true,
        "reset": "remove-assertion",
        "multiEdit": false,
        "sourceBinding": "definition.description"
      },
      {
        "id": "maturity",
        "label": "Design status",
        "scope": "model",
        "group": "basic",
        "widget": "select",
        "command": "setProperty",
        "adapterStatus": "existing",
        "valueStates": [
          "unset",
          "undecided",
          "known"
        ],
        "defaultVisible": true,
        "reset": "remove-assertion",
        "multiEdit": false,
        "sourceBinding": "definition.maturity",
        "options": [
          {
            "value": "draft",
            "label": "Draft"
          },
          {
            "value": "approved",
            "label": "Approved"
          }
        ],
        "help": "Approval is not evidence of deployment."
      },
