        "options": [
          {
            "value": "free",
            "label": "Automatic"
          },
          {
            "value": "pinned",
            "label": "Pinned"
          }
        ]
      },
      {
        "id": "namespace",
        "label": "Namespace",
        "scope": "model",
        "group": "advanced",
        "widget": "reference",
        "command": "setMembership",
        "adapterStatus": "new-core-required",
        "valueStates": [
          "unset",
          "known"
