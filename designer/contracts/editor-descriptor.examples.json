        "id": "detail",
        "label": "Show",
        "scope": "view",
        "group": "appearance",
        "widget": "select",
        "command": "setViewOverride",
        "adapterStatus": "wrapper-required",
        "valueStates": [
          "unset",
          "known"
        ],
        "defaultVisible": false,
        "reset": "remove-override",
        "multiEdit": false,
        "sourceBinding": "view.display.fields",
        "options": [
          {
            "value": "names",
            "label": "Field names"
          },
          {
            "value": "none",
            "label": "Name only"
          }
        ]
      },
      {
        "id": "kindIndicator",
        "label": "Type indicator",
        "scope": "view",
        "group": "appearance",
        "widget": "select",
        "command": "setViewOverride",
        "adapterStatus": "wrapper-required",
        "valueStates": [
          "unset",
          "known"
        ],
        "defaultVisible": false,
