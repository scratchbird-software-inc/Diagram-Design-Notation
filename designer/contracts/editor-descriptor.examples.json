        "visibleWhen": {
          "op": "capability",
          "name": "membership.namespace"
        }
      },
      {
        "id": "owner",
        "label": "Responsible team",
        "scope": "model",
        "group": "advanced",
        "widget": "reference",
        "command": "setMembership",
        "adapterStatus": "new-core-required",
        "valueStates": [
          "unset",
          "known"
        ],
        "defaultVisible": false,
        "reset": "remove-assertion",
        "multiEdit": false,
        "help": "Ownership does not move data to another server."
      }
    ]
  },
