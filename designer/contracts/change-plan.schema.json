{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed Designer change preview",
  "type": "object",
  "required": [
    "format",
    "commandId",
    "baseRevision",
    "planHash",
    "edits",
    "impact",
    "diagnostics"
  ],
  "properties": {
    "format": {
      "const": "ddn-change-plan@1"
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0
    },
    "planHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "edits": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "oldTextHash": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "file",
          "start",
          "end",
          "text",
          "oldTextHash"
        ],
        "additionalProperties": false
      }
    },
    "impact": {
      "type": "object",
      "properties": {
        "changedDefinitionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "affectedViewIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "requiresConfirmation": {
          "type": "boolean"
        }
      },
      "required": [
        "changedDefinitionIds",
        "affectedViewIds",
        "requiresConfirmation"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "incomplete",
              "information"
            ]
          },
          "message": {
            "type": "string"
          },
          "subjectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
