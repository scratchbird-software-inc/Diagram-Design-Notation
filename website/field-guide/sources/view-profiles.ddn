                    id "ddn.fieldguide.viewprofiles::model.begin"
                item
                    id "ddn.fieldguide.viewprofiles::model.capture"
                item
                    id "ddn.fieldguide.viewprofiles::model.review"
                item
                    id "ddn.fieldguide.viewprofiles::model.done"
                item
                    id "ddn.fieldguide.viewprofiles::model.s1"
                item
                    id "ddn.fieldguide.viewprofiles::model.s2"
                item
                    id "ddn.fieldguide.viewprofiles::model.s3"
                item
                    id "ddn.fieldguide.viewprofiles::model.s4"
        layout
            center "pins"
            algorithm "auto"
        background
            color "#ffffff"
        style
            theme "neutral"
        publication
            id "publication:flow_mono"

    use "ddn.fieldguide.viewprofiles::model.begin" named "appearance:flow_mono:ddn.fieldguide.viewprofiles::model.begin"
        with
