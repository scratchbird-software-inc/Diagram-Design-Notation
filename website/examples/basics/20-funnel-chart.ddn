version ddn-next-1

publication "publication:funnel"
    with
        id "publication:funnel"
        title "Synthetic sales pipeline / funnel"
        targets
            item
                target
                    id "funnel"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.examples.funnel-chart::pipeline.s1" as "record"
    with
        id "ddn.examples.funnel-chart::pipeline.s1"
        title "Visits"
        metadata
            x_record
                stage "Visits"
                value 1200
                unit "deals"


element "ddn.examples.funnel-chart::pipeline.s2" as "record"
    with
        id "ddn.examples.funnel-chart::pipeline.s2"
        title "Signups"
        metadata
            x_record
                stage "Signups"
                value 480
                unit "deals"


element "ddn.examples.funnel-chart::pipeline.s3" as "record"
    with
        id "ddn.examples.funnel-chart::pipeline.s3"
        title "Trials"
        metadata
            x_record
                stage "Trials"
                value 210
                unit "deals"


element "ddn.examples.funnel-chart::pipeline.s4" as "record"
    with
        id "ddn.examples.funnel-chart::pipeline.s4"
        title "Qualified"
        metadata
            x_record
                stage "Qualified"
                value 96
                unit "deals"


element "ddn.examples.funnel-chart::pipeline.s5" as "record"
    with
        id "ddn.examples.funnel-chart::pipeline.s5"
        title "Closed"
        metadata
            x_record
                stage "Closed"
                value 42
                unit "deals"


view "funnel" as "chart.funnel@1"
    with
        id "funnel"
        title "Synthetic sales pipeline / funnel"
        selection
            include empty list
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.funnel-chart::pipeline.s1"
                    item
                        id "ddn.examples.funnel-chart::pipeline.s2"
                    item
                        id "ddn.examples.funnel-chart::pipeline.s3"
                    item
                        id "ddn.examples.funnel-chart::pipeline.s4"
                    item
                        id "ddn.examples.funnel-chart::pipeline.s5"
                mark "funnel"
                x "metadata.x_record.stage"
                y "metadata.x_record.value"
                unit "deals"
                width 1120
                height 620
