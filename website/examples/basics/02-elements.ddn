view "classic" as "ddn@1"
    with
        id "classic"
        title "Classic / fixed semantic notation"
        selection
            include
                item
                    id "ddn.examples.elements::model.customer"
                item
                    id "ddn.examples.elements::model.history"
                item
                    id "ddn.examples.elements::model.profile"
