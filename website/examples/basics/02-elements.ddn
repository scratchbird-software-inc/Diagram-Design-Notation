                item
                    id "ddn.examples.elements::model.cloud"
                item
                    id "ddn.examples.elements::model.note"
                item
                    id "ddn.examples.elements::model.example"
        layout
            algorithm "grid"
            gap 80
        legend
            placement "none"
            width 280
        background
            color "#f6f8fc"
        publication
            id "publication:classic"

    use "ddn.examples.elements::model.customer" named "appearance:classic:ddn.examples.elements::model.customer"
