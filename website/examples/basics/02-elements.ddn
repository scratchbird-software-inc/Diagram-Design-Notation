version ddn-next-1

publication "publication:classic"
    with
        id "publication:classic"
        title "Classic / fixed semantic notation"
        targets
            item
                target
                    id "classic"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1600
                unit "px"
            height
                value 1050
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


