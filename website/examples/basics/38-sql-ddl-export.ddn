ddn "0.5";
module "ddn.examples.sql-ddl";
import "shared.ddn" as shared;
data shop {
 table customer "Customer" {fields { customer_id { key: primary; } display_name; } }
 table purchase "Purchase" {fields { purchase_id { key: primary; } customer_id; ordered_on; } }
 note note "Review note" {description: "Synthetic DDL export example; not a deployable schema."; }
 ref purchase_customer "purchase belongs to customer" @purchase.customer_id [zeromany] -> @customer.customer_id [one] {
     enforcement: database;
 }
 note note_customer "note annotates customer" @note -> @customer;
}
view publish "Synthetic shop / approved SQL DDL" {
 data: [@shop];
 format: @shared.styles.technical;
 export {
  mode: redacted;
  format: sql;
  identifier_mode: preserve;
  elements: [@shop.customer, @shop.purchase, @shop.note];
  fields: [@shop.customer.customer_id, @shop.customer.display_name, @shop.purchase.purchase_id, @shop.purchase.customer_id, @shop.purchase.ordered_on];
  properties: [kind, key];
  title: "Synthetic shop DDL";
 }
 publication {size: content; fit: none; overflow: error;}
}
