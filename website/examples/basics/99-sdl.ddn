version ddn-next-1

publication "publication:system"
    with
        id "publication:system"
        title "SDL system"
        targets
            item
                target
                    id "system"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:process"
    with
        id "publication:process"
        title "Order process"
        targets
            item
                target
                    id "process"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.sdl::sys.net.g1" as "core::Port"
    with
        id "ddn.examples.sdl::sys.net.g1"
        title "g1"
        content
            owner
                id "ddn.examples.sdl::sys.net"
            direction "inout"


element "ddn.examples.sdl::sys.net" as "sdl.block"
    with
        id "ddn.examples.sdl::sys.net"
        title "Network block"
        members
            item
                id "ddn.examples.sdl::sys.net.g1"


element "ddn.examples.sdl::sys.app.g2" as "core::Port"
    with
        id "ddn.examples.sdl::sys.app.g2"
        title "g2"
        content
            owner
                id "ddn.examples.sdl::sys.app"
            direction "inout"


element "ddn.examples.sdl::sys.app" as "sdl.block"
    with
        id "ddn.examples.sdl::sys.app"
        title "Application block"
        members
            item
                id "ddn.examples.sdl::sys.app.g2"


element "ddn.examples.sdl::sys.sig" as "sdl.signal"
    with
        id "ddn.examples.sdl::sys.sig"
        title "OrderReq"


element "ddn.examples.sdl::sys.sigs" as "sdl.signalset"
    with
        id "ddn.examples.sdl::sys.sigs"
        title "Order signals"


element "ddn.examples.sdl::sys.ack" as "sdl.signal"
    with
        id "ddn.examples.sdl::sys.ack"
        title "OrderAck"


relation "ddn.examples.sdl::sys.ch" as "sdl.channel"
    with
        id "ddn.examples.sdl::sys.ch"
        title "[OrderReq, OrderAck]"
        metadata
            x_sdl
                signals
                    item
                        id "ddn.examples.sdl::sys.sig"
                    item
                        id "ddn.examples.sdl::sys.ack"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::sys.net"
                member
                    id "ddn.examples.sdl::sys.net.g1"
            item
                definition
                    id "ddn.examples.sdl::sys.app"
                member
                    id "ddn.examples.sdl::sys.app.g2"


relation "ddn.examples.sdl::sys.l1" as "sdl.links"
    with
        id "ddn.examples.sdl::sys.l1"
        title "Links"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::sys.sig"
            item
                definition
                    id "ddn.examples.sdl::sys.net"


relation "ddn.examples.sdl::sys.l2" as "sdl.links"
    with
        id "ddn.examples.sdl::sys.l2"
        title "Links"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::sys.sigs"
            item
                definition
                    id "ddn.examples.sdl::sys.app"


element "ddn.examples.sdl::p.start" as "state.initial"
    with
        id "ddn.examples.sdl::p.start"
        title "start"


element "ddn.examples.sdl::p.idle" as "state.state"
    with
        id "ddn.examples.sdl::p.idle"
        title "Idle"


element "ddn.examples.sdl::p.in1" as "sdl.input"
    with
        id "ddn.examples.sdl::p.in1"
        title "OrderReq"
        metadata
            x_sdl
                priority "high"


element "ddn.examples.sdl::p.tmr" as "sdl.timer"
    with
        id "ddn.examples.sdl::p.tmr"
        title "T1"


element "ddn.examples.sdl::p.sett" as "sdl.set"
    with
        id "ddn.examples.sdl::p.sett"
        title "set(now+5, T1)"
        metadata
            x_sdl
                timer
                    id "ddn.examples.sdl::p.tmr"
                duration "5s"


element "ddn.examples.sdl::p.rstm" as "sdl.reset"
    with
        id "ddn.examples.sdl::p.rstm"
        title "reset(T1)"
        metadata
            x_sdl
                timer
                    id "ddn.examples.sdl::p.tmr"


element "ddn.examples.sdl::p.waiting" as "sdl.input"
    with
        id "ddn.examples.sdl::p.waiting"
        title "waiting"
        metadata
            x_sdl
                active
                    id "ddn.examples.sdl::p.tmr"


element "ddn.examples.sdl::p.work" as "sdl.task"
    with
        id "ddn.examples.sdl::p.work"
        title "Process order"


element "ddn.examples.sdl::p.dec" as "state.junction"
    with
        id "ddn.examples.sdl::p.dec"
        title "dec"


element "ddn.examples.sdl::p.out1" as "sdl.output"
    with
        id "ddn.examples.sdl::p.out1"
        title "OrderAck"


element "ddn.examples.sdl::p.store" as "sdl.save"
    with
        id "ddn.examples.sdl::p.store"
        title "Save order"


element "ddn.examples.sdl::p.proc" as "sdl.procedure"
    with
        id "ddn.examples.sdl::p.proc"
        title "Billing"


element "ddn.examples.sdl::p.newstate" as "sdl.create"
    with
        id "ddn.examples.sdl::p.newstate"
        title "Tracking"


element "ddn.examples.sdl::p.done" as "state.final"
    with
        id "ddn.examples.sdl::p.done"
        title "done"


relation "ddn.examples.sdl::p.t1" as "state.transition"
    with
        id "ddn.examples.sdl::p.t1"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.start"
            item
                definition
                    id "ddn.examples.sdl::p.idle"


relation "ddn.examples.sdl::p.t2" as "state.transition"
    with
        id "ddn.examples.sdl::p.t2"
        title "OrderReq"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.idle"
            item
                definition
                    id "ddn.examples.sdl::p.in1"


relation "ddn.examples.sdl::p.t2b" as "state.transition"
    with
        id "ddn.examples.sdl::p.t2b"
        title "timeout"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.idle"
            item
                definition
                    id "ddn.examples.sdl::p.waiting"


relation "ddn.examples.sdl::p.t3" as "state.transition"
    with
        id "ddn.examples.sdl::p.t3"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.in1"
            item
                definition
                    id "ddn.examples.sdl::p.sett"


relation "ddn.examples.sdl::p.t3b" as "state.transition"
    with
        id "ddn.examples.sdl::p.t3b"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.sett"
            item
                definition
                    id "ddn.examples.sdl::p.work"


relation "ddn.examples.sdl::p.t3c" as "state.transition"
    with
        id "ddn.examples.sdl::p.t3c"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.waiting"
            item
                definition
                    id "ddn.examples.sdl::p.rstm"


relation "ddn.examples.sdl::p.t3d" as "state.transition"
    with
        id "ddn.examples.sdl::p.t3d"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.rstm"
            item
                definition
                    id "ddn.examples.sdl::p.work"


relation "ddn.examples.sdl::p.t4" as "state.transition"
    with
        id "ddn.examples.sdl::p.t4"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.work"
            item
                definition
                    id "ddn.examples.sdl::p.dec"


relation "ddn.examples.sdl::p.t5" as "state.transition"
    with
        id "ddn.examples.sdl::p.t5"
        title "ok"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.dec"
            item
                definition
                    id "ddn.examples.sdl::p.out1"


relation "ddn.examples.sdl::p.t6" as "state.transition"
    with
        id "ddn.examples.sdl::p.t6"
        title "hold"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.dec"
            item
                definition
                    id "ddn.examples.sdl::p.store"


relation "ddn.examples.sdl::p.t7" as "state.transition"
    with
        id "ddn.examples.sdl::p.t7"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.out1"
            item
                definition
                    id "ddn.examples.sdl::p.proc"


relation "ddn.examples.sdl::p.t8" as "state.transition"
    with
        id "ddn.examples.sdl::p.t8"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.store"
            item
                definition
                    id "ddn.examples.sdl::p.proc"


relation "ddn.examples.sdl::p.t9" as "state.transition"
    with
        id "ddn.examples.sdl::p.t9"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.proc"
            item
                definition
                    id "ddn.examples.sdl::p.newstate"


relation "ddn.examples.sdl::p.t10" as "state.transition"
    with
        id "ddn.examples.sdl::p.t10"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.sdl::p.newstate"
            item
                definition
                    id "ddn.examples.sdl::p.done"


view "system" as "sdl.basic@1"
    with
        id "system"
        title "SDL system"
        selection
            include
                item
                    id "ddn.examples.sdl::sys.net"
                item
                    id "ddn.examples.sdl::sys.app"
                item
                    id "ddn.examples.sdl::sys.sig"
                item
                    id "ddn.examples.sdl::sys.sigs"
                item
                    id "ddn.examples.sdl::sys.ack"
                item
                    id "ddn.examples.sdl::sys.ch"
                item
                    id "ddn.examples.sdl::sys.l1"
                item
                    id "ddn.examples.sdl::sys.l2"
            exclude
                item
                    id "ddn.examples.sdl::p.t1"
                item
                    id "ddn.examples.sdl::p.t2"
                item
                    id "ddn.examples.sdl::p.t2b"
                item
                    id "ddn.examples.sdl::p.t3"
                item
                    id "ddn.examples.sdl::p.t3b"
                item
                    id "ddn.examples.sdl::p.t3c"
                item
                    id "ddn.examples.sdl::p.t3d"
                item
                    id "ddn.examples.sdl::p.t4"
                item
                    id "ddn.examples.sdl::p.t5"
                item
                    id "ddn.examples.sdl::p.t6"
                item
                    id "ddn.examples.sdl::p.t7"
                item
                    id "ddn.examples.sdl::p.t8"
                item
                    id "ddn.examples.sdl::p.t9"
                item
                    id "ddn.examples.sdl::p.t10"
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        regions
            item
                id "ddn.examples.sdl::system.nb"
                name "Network"
                scope
                    id "ddn.examples.sdl::sys.net"
                members
                    item
                        id "ddn.examples.sdl::sys.sig"
        publication
            id "publication:system"

    use "ddn.examples.sdl::sys.net" named "appearance:system:ddn.examples.sdl::sys.net"
        with
            id "appearance:system:ddn.examples.sdl::sys.net"

    use "ddn.examples.sdl::sys.app" named "appearance:system:ddn.examples.sdl::sys.app"
        with
            id "appearance:system:ddn.examples.sdl::sys.app"

    use "ddn.examples.sdl::sys.sig" named "appearance:system:ddn.examples.sdl::sys.sig"
        with
            id "appearance:system:ddn.examples.sdl::sys.sig"

    use "ddn.examples.sdl::sys.sigs" named "appearance:system:ddn.examples.sdl::sys.sigs"
        with
            id "appearance:system:ddn.examples.sdl::sys.sigs"

    use "ddn.examples.sdl::sys.ack" named "appearance:system:ddn.examples.sdl::sys.ack"
        with
            id "appearance:system:ddn.examples.sdl::sys.ack"

    use "ddn.examples.sdl::sys.ch" named "appearance:system:ddn.examples.sdl::sys.ch"
        with
            id "appearance:system:ddn.examples.sdl::sys.ch"

    use "ddn.examples.sdl::sys.l1" named "appearance:system:ddn.examples.sdl::sys.l1"
        with
            id "appearance:system:ddn.examples.sdl::sys.l1"

    use "ddn.examples.sdl::sys.l2" named "appearance:system:ddn.examples.sdl::sys.l2"
        with
            id "appearance:system:ddn.examples.sdl::sys.l2"


