    use "ddn.examples.mind-map::ideas.creep" named "appearance:mindmap:ddn.examples.mind-map::ideas.creep"
        with
            id "appearance:mindmap:ddn.examples.mind-map::ideas.creep"

    use "ddn.examples.mind-map::ideas.r1" named "appearance:mindmap:ddn.examples.mind-map::ideas.r1"
        with
            id "appearance:mindmap:ddn.examples.mind-map::ideas.r1"

    use "ddn.examples.mind-map::ideas.r2" named "appearance:mindmap:ddn.examples.mind-map::ideas.r2"
