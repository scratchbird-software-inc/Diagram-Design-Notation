                item
                    id "ddn.examples.curved-relations::capabilities.shipments"
                item
                    id "ddn.examples.curved-relations::capabilities.employment"
                item
                    id "ddn.examples.curved-relations::capabilities.f01"
                item
                    id "ddn.examples.curved-relations::capabilities.f02"
                item
                    id "ddn.examples.curved-relations::capabilities.f03"
                item
                    id "ddn.examples.curved-relations::capabilities.f04"
