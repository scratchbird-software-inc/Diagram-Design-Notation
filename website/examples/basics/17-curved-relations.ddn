view "mindmap_classic" as "ddn@1"
    with
        id "mindmap_classic"
        title "Curved mind-map / classic"
        selection
            include
                item
                    id "ddn.examples.curved-relations::capabilities.enterprise"
                item
                    id "ddn.examples.curved-relations::capabilities.finance"
                item
                    id "ddn.examples.curved-relations::capabilities.inventory"
