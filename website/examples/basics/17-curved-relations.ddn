                item
                    id "ddn.examples.curved-relations::capabilities.f09"
                item
                    id "ddn.examples.curved-relations::capabilities.f10"
            exclude
                item
                    id "ddn.examples.curved-relations::crossing.orders"
                item
                    id "ddn.examples.curved-relations::crossing.stock"
                item
                    id "ddn.examples.curved-relations::obstruction.deliver"
                item
                    id "ddn.examples.curved-relations::exchange.request"
                item
                    id "ddn.examples.curved-relations::exchange.response"
                item
                    id "ddn.examples.curved-relations::exchange.verify"
        layout
            algorithm "mindmap"
            routing "curved"
            gap 150
            root
                id "ddn.examples.curved-relations::capabilities.enterprise"
            hierarchy "assoc"
        display
            fields "none"
        legend
            mode "numbers"
            width 350
            keys
                f01 "1"
                f02 "2"
                f03 "3"
                f04 "4"
                f05 "5"
                f06 "6"
                f07 "7"
                f08 "8"
                f09 "9"
                f10 "10"
        background
            color "#f6f8fc"
        publication
            id "publication:mindmap_classic"

