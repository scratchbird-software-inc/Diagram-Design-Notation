version ddn-next-1

publication "publication:sankey"
    with
        id "publication:sankey"
        title "Synthetic energy spend across three stages / sankey"
        targets
            item
                target
                    id "sankey"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.examples.sankey::energy.f1" as "record"
    with
        id "ddn.examples.sankey::energy.f1"
        title "grid → heating"
        metadata
            x_record
                source "grid"
                target "heating"
                value 40
                unit "MWh"


element "ddn.examples.sankey::energy.f2" as "record"
    with
        id "ddn.examples.sankey::energy.f2"
        title "grid → it"
        metadata
            x_record
                source "grid"
                target "it"
                value 30
                unit "MWh"


element "ddn.examples.sankey::energy.f3" as "record"
    with
        id "ddn.examples.sankey::energy.f3"
        title "gas → heating"
        metadata
            x_record
                source "gas"
                target "heating"
                value 35
                unit "MWh"


element "ddn.examples.sankey::energy.f4" as "record"
    with
        id "ddn.examples.sankey::energy.f4"
        title "solar → it"
        metadata
            x_record
                source "solar"
                target "it"
                value 15
                unit "MWh"


element "ddn.examples.sankey::energy.f5" as "record"
    with
        id "ddn.examples.sankey::energy.f5"
        title "heating → building_a"
        metadata
            x_record
                source "heating"
                target "building_a"
                value 45
                unit "MWh"


element "ddn.examples.sankey::energy.f6" as "record"
    with
        id "ddn.examples.sankey::energy.f6"
        title "heating → building_b"
        metadata
            x_record
                source "heating"
                target "building_b"
                value 30
                unit "MWh"


element "ddn.examples.sankey::energy.f7" as "record"
    with
        id "ddn.examples.sankey::energy.f7"
        title "it → building_a"
        metadata
            x_record
                source "it"
                target "building_a"
                value 45
                unit "MWh"


view "sankey" as "chart.sankey@1"
    with
        id "sankey"
        title "Synthetic energy spend across three stages / sankey"
        selection
            include empty list
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.sankey::energy.f1"
                    item
                        id "ddn.examples.sankey::energy.f2"
                    item
                        id "ddn.examples.sankey::energy.f3"
                    item
                        id "ddn.examples.sankey::energy.f4"
                    item
                        id "ddn.examples.sankey::energy.f5"
                    item
                        id "ddn.examples.sankey::energy.f6"
                    item
                        id "ddn.examples.sankey::energy.f7"
                mark "sankey"
                x "metadata.x_record.source"
                target "metadata.x_record.target"
                y "metadata.x_record.value"
                unit "MWh"
                width 1120
                height 620
