ddn "0.5";
module "ddn.examples.sankey";

import "shared.ddn" as shared;

// Synthetic energy-spend dataset: seven flows across three stages.
// All data is synthetic.
data energy {
    record f1 "grid → heating" {x_record: {"source": "grid", "target": "heating", "value": 40, "unit": "MWh"}; }
    record f2 "grid → it" {x_record: {"source": "grid", "target": "it", "value": 30, "unit": "MWh"}; }
    record f3 "gas → heating" {x_record: {"source": "gas", "target": "heating", "value": 35, "unit": "MWh"}; }
    record f4 "solar → it" {x_record: {"source": "solar", "target": "it", "value": 15, "unit": "MWh"}; }
    record f5 "heating → building_a" {x_record: {"source": "heating", "target": "building_a", "value": 45, "unit": "MWh"}; }
    record f6 "heating → building_b" {x_record: {"source": "heating", "target": "building_b", "value": 30, "unit": "MWh"}; }
    record f7 "it → building_a" {x_record: {"source": "it", "target": "building_a", "value": 45, "unit": "MWh"}; }
}

view sankey "Synthetic energy spend across three stages / sankey" {
    data: [@energy]; format: @shared.styles.technical;
    projection { kind:chart; profile:"chart.sankey@1"; records:[@energy.f1, @energy.f2, @energy.f3, @energy.f4, @energy.f5, @energy.f6, @energy.f7]; mark:sankey; x:"x_record.source"; target:"x_record.target"; y:"x_record.value"; unit:"MWh"; width:1120px; height:620px; }
    publication { size: content; fit: none; overflow: error; minimum_text: 8pt; }
}
