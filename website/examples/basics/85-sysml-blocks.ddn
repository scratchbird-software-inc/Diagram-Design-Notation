version ddn-next-1

publication "publication:bdd"
    with
        id "publication:bdd"
        title "Pump block definition"
        targets
            item
                target
                    id "bdd"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:ibd"
    with
        id "publication:ibd"
        title "Pump station internals"
        targets
            item
                target
                    id "ibd"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:parametric"
    with
        id "publication:parametric"
        title "Flow balance"
        targets
            item
                target
                    id "parametric"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.sysmlblocks::m.pump.capacity" as "field"
    with
        id "ddn.examples.sysmlblocks::m.pump.capacity"
        title "capacity"
        metadata
            x_block
                compartment "values"
            x_unit
                unit "L/min"
        content
            parent
                id "ddn.examples.sysmlblocks::m.pump"
            ordinal 0


element "ddn.examples.sysmlblocks::m.pump.mass" as "field"
    with
        id "ddn.examples.sysmlblocks::m.pump.mass"
