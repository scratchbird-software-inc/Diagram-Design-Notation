view "bdd" as "sysml.bdd@2"
    with
        id "bdd"
        title "Pump block definition"
        selection
            include
                item
                    id "ddn.examples.sysmlblocks::m.pump"
                item
                    id "ddn.examples.sysmlblocks::m.reservoir"
                item
                    id "ddn.examples.sysmlblocks::m.pumpBase"
                item
                    id "ddn.examples.sysmlblocks::m.litres"
                item
                    id "ddn.examples.sysmlblocks::m.pumpIf"
                item
                    id "ddn.examples.sysmlblocks::m.waterSpec"
                item
                    id "ddn.examples.sysmlblocks::m.gen"
                item
                    id "ddn.examples.sysmlblocks::m.comp"
                item
                    id "ddn.examples.sysmlblocks::m.typed"
                item
                    id "ddn.examples.sysmlblocks::m.water"
            exclude
                item
                    id "ddn.examples.sysmlblocks::m.b1"
                item
                    id "ddn.examples.sysmlblocks::m.b2"
                item
                    id "ddn.examples.sysmlblocks::m.b3"
        layout
            algorithm "layered"
            direction "down"
        background
            color "#f6f8fc"
        publication
            id "publication:bdd"

    use "ddn.examples.sysmlblocks::m.pump" named "appearance:bdd:ddn.examples.sysmlblocks::m.pump"
        with
            id "appearance:bdd:ddn.examples.sysmlblocks::m.pump"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.sysmlblocks::m.reservoir" named "appearance:bdd:ddn.examples.sysmlblocks::m.reservoir"
        with
            id "appearance:bdd:ddn.examples.sysmlblocks::m.reservoir"

    use "ddn.examples.sysmlblocks::m.pumpBase" named "appearance:bdd:ddn.examples.sysmlblocks::m.pumpBase"
        with
            id "appearance:bdd:ddn.examples.sysmlblocks::m.pumpBase"

    use "ddn.examples.sysmlblocks::m.litres" named "appearance:bdd:ddn.examples.sysmlblocks::m.litres"
        with
            id "appearance:bdd:ddn.examples.sysmlblocks::m.litres"

    use "ddn.examples.sysmlblocks::m.pumpIf" named "appearance:bdd:ddn.examples.sysmlblocks::m.pumpIf"
        with
            id "appearance:bdd:ddn.examples.sysmlblocks::m.pumpIf"

    use "ddn.examples.sysmlblocks::m.waterSpec" named "appearance:bdd:ddn.examples.sysmlblocks::m.waterSpec"
        with
            id "appearance:bdd:ddn.examples.sysmlblocks::m.waterSpec"

    use "ddn.examples.sysmlblocks::m.gen" named "appearance:bdd:ddn.examples.sysmlblocks::m.gen"
        with
            id "appearance:bdd:ddn.examples.sysmlblocks::m.gen"

    use "ddn.examples.sysmlblocks::m.comp" named "appearance:bdd:ddn.examples.sysmlblocks::m.comp"
        with
            id "appearance:bdd:ddn.examples.sysmlblocks::m.comp"

    use "ddn.examples.sysmlblocks::m.typed" named "appearance:bdd:ddn.examples.sysmlblocks::m.typed"
        with
            id "appearance:bdd:ddn.examples.sysmlblocks::m.typed"

    use "ddn.examples.sysmlblocks::m.water" named "appearance:bdd:ddn.examples.sysmlblocks::m.water"
        with
            id "appearance:bdd:ddn.examples.sysmlblocks::m.water"


