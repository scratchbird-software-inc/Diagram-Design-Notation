element "ddn.examples.sysmlblocks::m.pump.outlet" as "core::Port"
    with
        id "ddn.examples.sysmlblocks::m.pump.outlet"
        title "outlet"
        metadata
            x_port
                type "full"
                multiplicity "1..2"
                nested
                    item
                        name "seal"
                        direction "out"
        content
            owner
                id "ddn.examples.sysmlblocks::m.pump"
            direction "output"


