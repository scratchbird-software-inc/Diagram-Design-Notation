relation "ddn.examples.sysmlblocks::m.gen" as "uml.generalization"
    with
        id "ddn.examples.sysmlblocks::m.gen"
        title "Generalization"
        endpoints
            item
                definition
                    id "ddn.examples.sysmlblocks::m.pump"
            item
                definition
                    id "ddn.examples.sysmlblocks::m.pumpBase"


relation "ddn.examples.sysmlblocks::m.comp" as "sysml.composition"
    with
