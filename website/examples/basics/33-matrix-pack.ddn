view "bcg" as "matrix.bcg@1"
    with
        id "bcg"
        title "Synthetic portfolio / BCG"
        selection
            include
                item
                    id "ddn.examples.matrix-pack::axes.g_high"
                item
                    id "ddn.examples.matrix-pack::axes.g_low"
                item
                    id "ddn.examples.matrix-pack::axes.s_high"
                item
                    id "ddn.examples.matrix-pack::axes.s_low"
                item
                    id "ddn.examples.matrix-pack::items.bcg_star"
                item
                    id "ddn.examples.matrix-pack::items.bcg_star2"
                item
                    id "ddn.examples.matrix-pack::items.bcq_question"
                item
                    id "ddn.examples.matrix-pack::items.bcg_cow"
                item
                    id "ddn.examples.matrix-pack::items.bcg_dog"
        layout
            algorithm "grid"
            gap 112
            row_gap 112
        legend
            width 280
        background
            color "#f6f8fc"
        projection
            options
                rows
                    item
                        id "ddn.examples.matrix-pack::axes.g_high"
                    item
                        id "ddn.examples.matrix-pack::axes.g_low"
                columns
                    item
                        id "ddn.examples.matrix-pack::axes.s_high"
                    item
                        id "ddn.examples.matrix-pack::axes.s_low"
                relation "assoc"
                value "title"
                duplicates "join"


