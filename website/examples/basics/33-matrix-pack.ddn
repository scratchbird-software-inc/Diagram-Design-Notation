version ddn-next-1

publication "publication:bcg"
    with
        id "publication:bcg"
        title "Synthetic portfolio / BCG"
        targets
            item
                target
                    id "bcg"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


publication "publication:ansoff"
    with
        id "publication:ansoff"
        title "Synthetic portfolio / Ansoff"
        targets
            item
                target
                    id "ansoff"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


publication "publication:tows"
    with
        id "publication:tows"
        title "Synthetic portfolio / TOWS"
        targets
            item
                target
                    id "tows"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


element "ddn.examples.matrix-pack::axes.g_high" as "record"
    with
        id "ddn.examples.matrix-pack::axes.g_high"
        title "Market growth: high"
        description "Synthetic: fast-growing beverage segments in Fizzberry's markets."
        metadata
            x_category
                axis "growth"
                level "high"


element "ddn.examples.matrix-pack::axes.g_low" as "record"
    with
        id "ddn.examples.matrix-pack::axes.g_low"
        title "Market growth: low"
        description "Synthetic: flat or declining beverage segments in Fizzberry's markets."
        metadata
            x_category
                axis "growth"
                level "low"


element "ddn.examples.matrix-pack::axes.s_high" as "record"
    with
        id "ddn.examples.matrix-pack::axes.s_high"
        title "Relative share: high"
        description "Synthetic: Fizzberry leads the segment versus the largest rival."
        metadata
            x_category
                axis "share"
                level "high"


element "ddn.examples.matrix-pack::axes.s_low" as "record"
    with
        id "ddn.examples.matrix-pack::axes.s_low"
        title "Relative share: low"
        description "Synthetic: Fizzberry trails the segment leader."
        metadata
            x_category
                axis "share"
                level "low"


element "ddn.examples.matrix-pack::axes.m_existing" as "record"
    with
        id "ddn.examples.matrix-pack::axes.m_existing"
        title "Market: existing"
        description "Synthetic: regions and channels Fizzberry already serves."
        metadata
            x_category
                axis "market"
                level "existing"


element "ddn.examples.matrix-pack::axes.m_new" as "record"
    with
        id "ddn.examples.matrix-pack::axes.m_new"
        title "Market: new"
        description "Synthetic: regions and channels Fizzberry does not yet serve."
        metadata
            x_category
                axis "market"
                level "new"


element "ddn.examples.matrix-pack::axes.p_existing" as "record"
    with
        id "ddn.examples.matrix-pack::axes.p_existing"
        title "Product: existing"
        description "Synthetic: Fizzberry's current beverage lines."
        metadata
            x_category
                axis "product"
                level "existing"


element "ddn.examples.matrix-pack::axes.p_new" as "record"
    with
        id "ddn.examples.matrix-pack::axes.p_new"
        title "Product: new"
        description "Synthetic: beverage lines Fizzberry has not launched yet."
        metadata
            x_category
                axis "product"
                level "new"


element "ddn.examples.matrix-pack::axes.int_s" as "record"
    with
        id "ddn.examples.matrix-pack::axes.int_s"
        title "Internal: strength"
        description "Synthetic: brand recognition for botanical sparkling drinks."
        metadata
            x_category
                axis "internal"
                level "strength"


element "ddn.examples.matrix-pack::axes.int_w" as "record"
    with
        id "ddn.examples.matrix-pack::axes.int_w"
        title "Internal: weakness"
        description "Synthetic: limited cold-chain distribution inland."
        metadata
            x_category
                axis "internal"
                level "weakness"


element "ddn.examples.matrix-pack::axes.ext_o" as "record"
    with
        id "ddn.examples.matrix-pack::axes.ext_o"
        title "External: opportunity"
        description "Synthetic: subscription delivery apps growing in coastal cities."
        metadata
            x_category
                axis "external"
                level "opportunity"


element "ddn.examples.matrix-pack::axes.ext_t" as "record"
    with
        id "ddn.examples.matrix-pack::axes.ext_t"
        title "External: threat"
        description "Synthetic: proposed sugar levy on sweetened beverages."
        metadata
            x_category
                axis "external"
                level "threat"


relation "ddn.examples.matrix-pack::items.bcg_star" as "assoc"
    with
        id "ddn.examples.matrix-pack::items.bcg_star"
        title "Sparkling tea"
        endpoints
            item
                definition
                    id "ddn.examples.matrix-pack::axes.g_high"
            item
                definition
                    id "ddn.examples.matrix-pack::axes.s_high"


relation "ddn.examples.matrix-pack::items.bcg_star2" as "assoc"
    with
        id "ddn.examples.matrix-pack::items.bcg_star2"
