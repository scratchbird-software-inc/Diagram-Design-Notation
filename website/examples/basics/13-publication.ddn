version ddn-next-1

publication "publication:paper"
    with
        id "publication:paper"
        title "A4 / explicit minimum text"
        targets
            item
                target
                    id "paper"
                kind "view"
        format "svg"
        page
            size "a4"
            fit "reflow"
            orientation "landscape"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30.236220472440948
                right 30.236220472440948
                bottom 30.236220472440948
                left 30.236220472440948
            minimum_text 9.333333333333332


publication "publication:screen"
    with
        id "publication:screen"
        title "Content-sized / same semantic model"
        targets
            item
                target
                    id "screen"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.examples.publication::model.source.order_id" as "field"
    with
