relation "ddn.examples.publication::model.check" as "flow"
    with
        id "ddn.examples.publication::model.check"
        title "Validated input"
        endpoints
            item
                definition
                    id "ddn.examples.publication::model.source"
            item
                definition
                    id "ddn.examples.publication::model.validated"


view "paper" as "ddn@1"
    with
        id "paper"
        title "A4 / explicit minimum text"
        selection
            include
                item
                    id "ddn.examples.publication::model.source"
                item
                    id "ddn.examples.publication::model.validated"
                item
                    id "ddn.examples.publication::model.check"
        layout
            algorithm "layered"
            gap 80
        display
            fields "none"
        legend
            mode "numbers"
            placement "bottom"
            width 280
            keys
                check "1"
        background
            color "#f6f8fc"
        publication
            id "publication:paper"

    use "ddn.examples.publication::model.source" named "appearance:paper:ddn.examples.publication::model.source"
        with
            id "appearance:paper:ddn.examples.publication::model.source"
            body "title"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.publication::model.validated" named "appearance:paper:ddn.examples.publication::model.validated"
        with
            id "appearance:paper:ddn.examples.publication::model.validated"
            body "title"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.publication::model.check" named "appearance:paper:ddn.examples.publication::model.check"
        with
            id "appearance:paper:ddn.examples.publication::model.check"


