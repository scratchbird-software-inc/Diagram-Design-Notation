version ddn-next-1

publication "publication:plan"
    with
        id "publication:plan"
        title "Release plan"
        targets
            item
                target
                    id "plan"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.examples.pertcpm::m.design" as "analysis.task"
    with
        id "ddn.examples.pertcpm::m.design"
        title "Design"
        metadata
            x_estimate 3


element "ddn.examples.pertcpm::m.build_api" as "analysis.task"
    with
        id "ddn.examples.pertcpm::m.build_api"
        title "Build API"
        metadata
            x_estimate 4


element "ddn.examples.pertcpm::m.build_ui" as "analysis.task"
    with
        id "ddn.examples.pertcpm::m.build_ui"
        title "Build UI"
        metadata
            x_estimate 5


element "ddn.examples.pertcpm::m.integrate" as "analysis.task"
    with
        id "ddn.examples.pertcpm::m.integrate"
        title "Integrate"
        metadata
            x_estimate 2


element "ddn.examples.pertcpm::m.test" as "analysis.task"
    with
        id "ddn.examples.pertcpm::m.test"
        title "Test"
        metadata
            x_estimate 2


element "ddn.examples.pertcpm::m.ship" as "analysis.task"
    with
        id "ddn.examples.pertcpm::m.ship"
        title "Ship"
        metadata
            x_estimate 1


relation "ddn.examples.pertcpm::m.d_api" as "analysis.precedes"
    with
        id "ddn.examples.pertcpm::m.d_api"
        title "before"
        endpoints
            item
                definition
                    id "ddn.examples.pertcpm::m.design"
            item
                definition
                    id "ddn.examples.pertcpm::m.build_api"


relation "ddn.examples.pertcpm::m.d_ui" as "analysis.precedes"
    with
        id "ddn.examples.pertcpm::m.d_ui"
        title "before"
        endpoints
            item
                definition
                    id "ddn.examples.pertcpm::m.design"
            item
                definition
                    id "ddn.examples.pertcpm::m.build_ui"


relation "ddn.examples.pertcpm::m.api_int" as "analysis.precedes"
    with
        id "ddn.examples.pertcpm::m.api_int"
        title "before"
        endpoints
            item
                definition
                    id "ddn.examples.pertcpm::m.build_api"
            item
                definition
                    id "ddn.examples.pertcpm::m.integrate"


relation "ddn.examples.pertcpm::m.ui_int" as "analysis.precedes"
    with
        id "ddn.examples.pertcpm::m.ui_int"
        title "before"
        endpoints
            item
                definition
                    id "ddn.examples.pertcpm::m.build_ui"
            item
                definition
                    id "ddn.examples.pertcpm::m.integrate"


relation "ddn.examples.pertcpm::m.int_test" as "analysis.precedes"
    with
        id "ddn.examples.pertcpm::m.int_test"
        title "before"
        endpoints
            item
                definition
                    id "ddn.examples.pertcpm::m.integrate"
            item
                definition
                    id "ddn.examples.pertcpm::m.test"


relation "ddn.examples.pertcpm::m.test_ship" as "analysis.precedes"
    with
        id "ddn.examples.pertcpm::m.test_ship"
        title "before"
        endpoints
            item
                definition
                    id "ddn.examples.pertcpm::m.test"
            item
                definition
                    id "ddn.examples.pertcpm::m.ship"


view "plan" as "pert.cpm@1"
    with
        id "plan"
        title "Release plan"
        selection
            include
                item
                    id "ddn.examples.pertcpm::m.design"
                item
                    id "ddn.examples.pertcpm::m.build_api"
                item
                    id "ddn.examples.pertcpm::m.build_ui"
                item
                    id "ddn.examples.pertcpm::m.integrate"
                item
                    id "ddn.examples.pertcpm::m.test"
                item
                    id "ddn.examples.pertcpm::m.ship"
                item
                    id "ddn.examples.pertcpm::m.d_api"
                item
                    id "ddn.examples.pertcpm::m.d_ui"
                item
                    id "ddn.examples.pertcpm::m.api_int"
                item
                    id "ddn.examples.pertcpm::m.ui_int"
                item
                    id "ddn.examples.pertcpm::m.int_test"
                item
                    id "ddn.examples.pertcpm::m.test_ship"
        layout
            algorithm "layered"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        publication
            id "publication:plan"

    use "ddn.examples.pertcpm::m.design" named "appearance:plan:ddn.examples.pertcpm::m.design"
        with
            id "appearance:plan:ddn.examples.pertcpm::m.design"

    use "ddn.examples.pertcpm::m.build_api" named "appearance:plan:ddn.examples.pertcpm::m.build_api"
        with
            id "appearance:plan:ddn.examples.pertcpm::m.build_api"

    use "ddn.examples.pertcpm::m.build_ui" named "appearance:plan:ddn.examples.pertcpm::m.build_ui"
        with
            id "appearance:plan:ddn.examples.pertcpm::m.build_ui"

    use "ddn.examples.pertcpm::m.integrate" named "appearance:plan:ddn.examples.pertcpm::m.integrate"
        with
            id "appearance:plan:ddn.examples.pertcpm::m.integrate"

    use "ddn.examples.pertcpm::m.test" named "appearance:plan:ddn.examples.pertcpm::m.test"
        with
            id "appearance:plan:ddn.examples.pertcpm::m.test"

    use "ddn.examples.pertcpm::m.ship" named "appearance:plan:ddn.examples.pertcpm::m.ship"
        with
            id "appearance:plan:ddn.examples.pertcpm::m.ship"

    use "ddn.examples.pertcpm::m.d_api" named "appearance:plan:ddn.examples.pertcpm::m.d_api"
        with
            id "appearance:plan:ddn.examples.pertcpm::m.d_api"

    use "ddn.examples.pertcpm::m.d_ui" named "appearance:plan:ddn.examples.pertcpm::m.d_ui"
        with
            id "appearance:plan:ddn.examples.pertcpm::m.d_ui"

    use "ddn.examples.pertcpm::m.api_int" named "appearance:plan:ddn.examples.pertcpm::m.api_int"
        with
            id "appearance:plan:ddn.examples.pertcpm::m.api_int"

    use "ddn.examples.pertcpm::m.ui_int" named "appearance:plan:ddn.examples.pertcpm::m.ui_int"
        with
            id "appearance:plan:ddn.examples.pertcpm::m.ui_int"

    use "ddn.examples.pertcpm::m.int_test" named "appearance:plan:ddn.examples.pertcpm::m.int_test"
        with
            id "appearance:plan:ddn.examples.pertcpm::m.int_test"

    use "ddn.examples.pertcpm::m.test_ship" named "appearance:plan:ddn.examples.pertcpm::m.test_ship"
        with
            id "appearance:plan:ddn.examples.pertcpm::m.test_ship"
