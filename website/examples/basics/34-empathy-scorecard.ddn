element "empathy::panel::says" as "note"
    with
        id "empathy::panel::says"
        title "SAYS"
        metadata
            x_record
                id "says"
                row 0
                column 0
                rowspan 1
                colspan 1
                items
                    item
                        id "ddn.examples.empathy-scorecard::research.says_a"
                    item
                        id "ddn.examples.empathy-scorecard::research.says_b"


element "empathy::panel::thinks" as "note"
    with
        id "empathy::panel::thinks"
        title "THINKS"
        metadata
            x_record
                id "thinks"
                row 0
                column 1
                rowspan 1
                colspan 1
                items
                    item
                        id "ddn.examples.empathy-scorecard::research.thinks"


element "empathy::panel::persona" as "note"
    with
        id "empathy::panel::persona"
        title "PERSONA"
        metadata
            x_record
                id "persona"
                row 1
                column 0
                rowspan 1
                colspan 2
                items
                    item
                        id "ddn.examples.empathy-scorecard::research.persona"


element "empathy::panel::does" as "note"
    with
        id "empathy::panel::does"
        title "DOES"
        metadata
            x_record
                id "does"
                row 2
                column 0
                rowspan 1
                colspan 1
                items
                    item
                        id "ddn.examples.empathy-scorecard::research.does"


element "empathy::panel::feels" as "note"
    with
        id "empathy::panel::feels"
        title "FEELS"
        metadata
            x_record
                id "feels"
                row 2
                column 1
                rowspan 1
                colspan 1
                items
                    item
                        id "ddn.examples.empathy-scorecard::research.feels"


element "scorecard::panel::financial" as "note"
    with
        id "scorecard::panel::financial"
        title "FINANCIAL"
        metadata
            x_record
                id "financial"
                row 0
                column 0
                rowspan 1
                colspan 1
                items
                    item
                        id "ddn.examples.empathy-scorecard::research.fin_1"
                    item
                        id "ddn.examples.empathy-scorecard::research.fin_2"


element "scorecard::panel::customer" as "note"
    with
        id "scorecard::panel::customer"
        title "CUSTOMER"
        metadata
            x_record
                id "customer"
                row 0
                column 1
                rowspan 1
                colspan 1
                items
                    item
                        id "ddn.examples.empathy-scorecard::research.cus_1"
                    item
                        id "ddn.examples.empathy-scorecard::research.cus_2"


element "scorecard::panel::internal" as "note"
    with
        id "scorecard::panel::internal"
        title "INTERNAL PROCESS"
        metadata
            x_record
                id "internal"
                row 1
                column 0
                rowspan 1
                colspan 1
                items
                    item
                        id "ddn.examples.empathy-scorecard::research.int_1"
                    item
                        id "ddn.examples.empathy-scorecard::research.int_2"


element "scorecard::panel::learning" as "note"
    with
        id "scorecard::panel::learning"
        title "LEARNING & GROWTH"
        metadata
            x_record
                id "learning"
                row 1
                column 1
                rowspan 1
                colspan 1
                items
                    item
                        id "ddn.examples.empathy-scorecard::research.lrn_1"
                    item
                        id "ddn.examples.empathy-scorecard::research.lrn_2"


view "empathy" as "canvas.empathy@1"
    with
        id "empathy"
        title "Support team / empathy map"
        selection
            include empty list
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        projection
            options
                columns 2
                panels
                    item
                        target
                            id "empathy::panel::says"
                        kind "text"
                        title "SAYS"
                    item
                        target
                            id "empathy::panel::thinks"
                        kind "text"
                        title "THINKS"
                    item
                        target
                            id "empathy::panel::persona"
                        kind "text"
                        title "PERSONA"
                    item
                        target
                            id "empathy::panel::does"
                        kind "text"
                        title "DOES"
                    item
                        target
                            id "empathy::panel::feels"
                        kind "text"
                        title "FEELS"


view "scorecard" as "canvas.scorecard@1"
    with
        id "scorecard"
        title "Department / balanced scorecard"
        selection
            include empty list
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        projection
            options
                columns 2
                panels
                    item
                        target
                            id "scorecard::panel::financial"
                        kind "text"
                        title "FINANCIAL"
                    item
                        target
                            id "scorecard::panel::customer"
                        kind "text"
                        title "CUSTOMER"
                    item
                        target
                            id "scorecard::panel::internal"
                        kind "text"
                        title "INTERNAL PROCESS"
                    item
                        target
                            id "scorecard::panel::learning"
                        kind "text"
                        title "LEARNING & GROWTH"
