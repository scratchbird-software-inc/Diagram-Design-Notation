    with
        id "ddn.examples.empathy-scorecard::research.thinks"
        title "Thinks"
        description "Synthetic: worries that automation metrics reward closing tickets fast, not solving the root cause."
        content
            text "Synthetic: worries that automation metrics reward closing tickets fast, not solving the root cause."
        draft
