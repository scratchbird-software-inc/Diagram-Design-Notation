version ddn-next-1

publication "publication:empathy"
    with
        id "publication:empathy"
        title "Support team / empathy map"
        targets
            item
                target
                    id "empathy"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


publication "publication:scorecard"
    with
        id "publication:scorecard"
        title "Department / balanced scorecard"
        targets
            item
                target
                    id "scorecard"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


element "ddn.examples.empathy-scorecard::research.persona" as "note"
    with
        id "ddn.examples.empathy-scorecard::research.persona"
        title "Persona"
        description "Synthetic persona: a support agent on the night shift."
        content
            text "Synthetic persona: a support agent on the night shift."
        draft
            text "Synthetic persona: a support agent on the night shift."


element "ddn.examples.empathy-scorecard::research.says_a" as "note"
    with
        id "ddn.examples.empathy-scorecard::research.says_a"
        title "Says (1)"
        description "Synthetic: ""I spend half the shift retyping ticket details into the billing tool."""
        content
            text "Synthetic: ""I spend half the shift retyping ticket details into the billing tool."""
        draft
            text "Synthetic: ""I spend half the shift retyping ticket details into the billing tool."""


