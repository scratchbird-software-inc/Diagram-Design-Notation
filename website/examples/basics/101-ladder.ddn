version ddn-next-1

publication "publication:d"
    with
        id "publication:d"
        title "Motor control ladder"
        targets
            item
                target
                    id "d"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.ladder::rung1.l1" as "ladder.label"
    with
        id "ddn.examples.ladder::rung1.l1"
        title "L1"


element "ddn.examples.ladder::rung1.start" as "ladder.contact"
    with
        id "ddn.examples.ladder::rung1.start"
        title "START"
        metadata
            x_contact
                form "no"


element "ddn.examples.ladder::rung1.stop" as "ladder.contact"
    with
        id "ddn.examples.ladder::rung1.stop"
        title "STOP"
        metadata
            x_contact
                form "nc"


element "ddn.examples.ladder::rung1.motor" as "ladder.coil"
    with
        id "ddn.examples.ladder::rung1.motor"
        title "MOTOR"
        metadata
            x_coil
                mode "normal"


element "ddn.examples.ladder::rung2.auto_start" as "ladder.contact"
    with
        id "ddn.examples.ladder::rung2.auto_start"
        title "AUTO"


element "ddn.examples.ladder::rung2.manual_start" as "ladder.contact"
    with
        id "ddn.examples.ladder::rung2.manual_start"
        title "MANUAL"


element "ddn.examples.ladder::rung2.latch" as "ladder.coil"
    with
        id "ddn.examples.ladder::rung2.latch"
        title "LATCH"
        metadata
            x_coil
                mode "set"


element "ddn.examples.ladder::rung3.run" as "ladder.contact"
    with
        id "ddn.examples.ladder::rung3.run"
        title "RUN"


element "ddn.examples.ladder::rung3.t1.in1" as "core::Port"
    with
        id "ddn.examples.ladder::rung3.t1.in1"
        title "in1"
        metadata
            x_fbd
                type "BOOL"
        content
            owner
                id "ddn.examples.ladder::rung3.t1"
            direction "input"


element "ddn.examples.ladder::rung3.t1.pt" as "core::Port"
    with
        id "ddn.examples.ladder::rung3.t1.pt"
        title "pt"
        metadata
            x_fbd
                type "TIME"
        content
            owner
                id "ddn.examples.ladder::rung3.t1"
            direction "input"


element "ddn.examples.ladder::rung3.t1.q" as "core::Port"
    with
        id "ddn.examples.ladder::rung3.t1.q"
        title "q"
        metadata
            x_fbd
                type "BOOL"
        content
            owner
                id "ddn.examples.ladder::rung3.t1"
            direction "output"


element "ddn.examples.ladder::rung3.t1" as "fbd.block"
    with
        id "ddn.examples.ladder::rung3.t1"
        title "T1"
        members
            item
                id "ddn.examples.ladder::rung3.t1.in1"
            item
                id "ddn.examples.ladder::rung3.t1.pt"
            item
                id "ddn.examples.ladder::rung3.t1.q"
        metadata
            x_record
                block_type "TON"
        notes
            item
                title "Additional source details"
                text
                    {
                      "datatype": "TON"
                    }
                format "plain"


element "ddn.examples.ladder::rung3.done" as "ladder.coil"
    with
        id "ddn.examples.ladder::rung3.done"
        title "DONE"
        metadata
            x_coil
                mode "reset"


element "ddn.examples.ladder::rung3.j1" as "ladder.jump"
    with
        id "ddn.examples.ladder::rung3.j1"
        title "NEXT"
        metadata
            x_jump
                target
                    id "ddn.examples.ladder::rung1.l1"


relation "ddn.examples.ladder::rung1.s1" as "ladder.series"
    with
        id "ddn.examples.ladder::rung1.s1"
        title "Series connection"
        endpoints
            item
                definition
                    id "ddn.examples.ladder::rung1.start"
            item
                definition
                    id "ddn.examples.ladder::rung1.stop"


relation "ddn.examples.ladder::rung1.s2" as "ladder.series"
    with
        id "ddn.examples.ladder::rung1.s2"
        title "Series connection"
        endpoints
            item
                definition
                    id "ddn.examples.ladder::rung1.stop"
            item
                definition
                    id "ddn.examples.ladder::rung1.motor"


relation "ddn.examples.ladder::rung2.s3" as "ladder.series"
    with
        id "ddn.examples.ladder::rung2.s3"
        title "Series connection"
        endpoints
            item
                definition
                    id "ddn.examples.ladder::rung2.auto_start"
            item
                definition
                    id "ddn.examples.ladder::rung2.latch"


relation "ddn.examples.ladder::rung2.s4" as "ladder.series"
    with
        id "ddn.examples.ladder::rung2.s4"
        title "Series connection"
        endpoints
            item
                definition
                    id "ddn.examples.ladder::rung2.manual_start"
            item
                definition
                    id "ddn.examples.ladder::rung2.latch"


relation "ddn.examples.ladder::rung3.s5" as "ladder.series"
    with
        id "ddn.examples.ladder::rung3.s5"
        title "Series connection"
        endpoints
            item
                definition
                    id "ddn.examples.ladder::rung3.run"
            item
                definition
                    id "ddn.examples.ladder::rung3.t1"
                member
                    id "ddn.examples.ladder::rung3.t1.in1"


relation "ddn.examples.ladder::rung3.s6" as "ladder.series"
    with
        id "ddn.examples.ladder::rung3.s6"
        title "Series connection"
        endpoints
            item
                definition
                    id "ddn.examples.ladder::rung3.t1"
                member
                    id "ddn.examples.ladder::rung3.t1.q"
            item
                definition
                    id "ddn.examples.ladder::rung3.done"


view "d" as "ladder.basic@1"
    with
        id "d"
        title "Motor control ladder"
        selection
            include
                item
                    id "ddn.examples.ladder::rung1.l1"
                item
                    id "ddn.examples.ladder::rung1.start"
                item
                    id "ddn.examples.ladder::rung1.stop"
                item
                    id "ddn.examples.ladder::rung1.motor"
                item
                    id "ddn.examples.ladder::rung2.auto_start"
                item
                    id "ddn.examples.ladder::rung2.manual_start"
                item
                    id "ddn.examples.ladder::rung2.latch"
                item
                    id "ddn.examples.ladder::rung3.run"
                item
                    id "ddn.examples.ladder::rung3.t1"
                item
                    id "ddn.examples.ladder::rung3.done"
                item
                    id "ddn.examples.ladder::rung3.j1"
                item
                    id "ddn.examples.ladder::rung1.s1"
                item
                    id "ddn.examples.ladder::rung1.s2"
                item
                    id "ddn.examples.ladder::rung2.s3"
                item
                    id "ddn.examples.ladder::rung2.s4"
                item
                    id "ddn.examples.ladder::rung3.s5"
                item
                    id "ddn.examples.ladder::rung3.s6"
        layout
            algorithm "ladder"
            gap 112
            row_gap 112
        background
            color "#f6f8fc"
        publication
            id "publication:d"

    use "ddn.examples.ladder::rung1.l1" named "appearance:d:ddn.examples.ladder::rung1.l1"
        with
            id "appearance:d:ddn.examples.ladder::rung1.l1"

    use "ddn.examples.ladder::rung1.start" named "appearance:d:ddn.examples.ladder::rung1.start"
        with
            id "appearance:d:ddn.examples.ladder::rung1.start"

    use "ddn.examples.ladder::rung1.stop" named "appearance:d:ddn.examples.ladder::rung1.stop"
        with
            id "appearance:d:ddn.examples.ladder::rung1.stop"

    use "ddn.examples.ladder::rung1.motor" named "appearance:d:ddn.examples.ladder::rung1.motor"
        with
            id "appearance:d:ddn.examples.ladder::rung1.motor"

    use "ddn.examples.ladder::rung2.auto_start" named "appearance:d:ddn.examples.ladder::rung2.auto_start"
        with
            id "appearance:d:ddn.examples.ladder::rung2.auto_start"

    use "ddn.examples.ladder::rung2.manual_start" named "appearance:d:ddn.examples.ladder::rung2.manual_start"
        with
            id "appearance:d:ddn.examples.ladder::rung2.manual_start"

    use "ddn.examples.ladder::rung2.latch" named "appearance:d:ddn.examples.ladder::rung2.latch"
        with
            id "appearance:d:ddn.examples.ladder::rung2.latch"

    use "ddn.examples.ladder::rung3.run" named "appearance:d:ddn.examples.ladder::rung3.run"
        with
            id "appearance:d:ddn.examples.ladder::rung3.run"

    use "ddn.examples.ladder::rung3.t1" named "appearance:d:ddn.examples.ladder::rung3.t1"
        with
            id "appearance:d:ddn.examples.ladder::rung3.t1"

    use "ddn.examples.ladder::rung3.done" named "appearance:d:ddn.examples.ladder::rung3.done"
        with
            id "appearance:d:ddn.examples.ladder::rung3.done"

    use "ddn.examples.ladder::rung3.j1" named "appearance:d:ddn.examples.ladder::rung3.j1"
        with
            id "appearance:d:ddn.examples.ladder::rung3.j1"

    use "ddn.examples.ladder::rung1.s1" named "appearance:d:ddn.examples.ladder::rung1.s1"
        with
            id "appearance:d:ddn.examples.ladder::rung1.s1"

    use "ddn.examples.ladder::rung1.s2" named "appearance:d:ddn.examples.ladder::rung1.s2"
        with
            id "appearance:d:ddn.examples.ladder::rung1.s2"

    use "ddn.examples.ladder::rung2.s3" named "appearance:d:ddn.examples.ladder::rung2.s3"
        with
            id "appearance:d:ddn.examples.ladder::rung2.s3"

    use "ddn.examples.ladder::rung2.s4" named "appearance:d:ddn.examples.ladder::rung2.s4"
        with
            id "appearance:d:ddn.examples.ladder::rung2.s4"

    use "ddn.examples.ladder::rung3.s5" named "appearance:d:ddn.examples.ladder::rung3.s5"
        with
            id "appearance:d:ddn.examples.ladder::rung3.s5"

    use "ddn.examples.ladder::rung3.s6" named "appearance:d:ddn.examples.ladder::rung3.s6"
        with
            id "appearance:d:ddn.examples.ladder::rung3.s6"
