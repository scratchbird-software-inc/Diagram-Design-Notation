element "ddn.examples.reuse::model.events" as "queue"
    with
        id "ddn.examples.reuse::model.events"
        title "Order events"


relation "ddn.examples.reuse::model.places" as "ref"
    with
        id "ddn.examples.reuse::model.places"
        title "places"
        properties
            source_mark "zeromany"
            target_mark "one"
            enforcement "database"
        endpoints
            item
                definition
                    id "ddn.examples.reuse::model.order"
                member
                    id "ddn.examples.reuse::model.order.customer_id"
            item
                definition
                    id "ddn.examples.reuse::model.customer"
                member
                    id "ddn.examples.reuse::model.customer.customer_id"
        notes
            item
                title "Additional source metadata"
                text
                    {
                      "x_owner": "data-governance"
                    }
                format "plain"


relation "ddn.examples.reuse::model.logs" as "ref"
    with
        id "ddn.examples.reuse::model.logs"
        title "logs to"
        properties
            enforcement "database"
        endpoints
            item
                definition
                    id "ddn.examples.reuse::model.customer"
            item
                definition
                    id "ddn.examples.reuse::model.audit_log"
        notes
            item
                title "Additional source metadata"
                text
                    {
                      "x_owner": "data-governance"
                    }
                format "plain"


relation "ddn.examples.reuse::model.notifies" as "flow"
    with
        id "ddn.examples.reuse::model.notifies"
        title "notifies"
        properties
            motion "pulse"
            pulse_color "#0E7490"
            speed 60
        endpoints
            item
                definition
                    id "ddn.examples.reuse::model.order"
            item
                definition
                    id "ddn.examples.reuse::model.events"


view "reuse" as "ddn@1"
    with
        id "reuse"
        title "Reusable presets / customer orders"
        selection
            include
                item
                    id "ddn.examples.reuse::model.audit_log"
                item
                    id "ddn.examples.reuse::model.customer"
                item
                    id "ddn.examples.reuse::model.order"
                item
                    id "ddn.examples.reuse::model.events"
                item
                    id "ddn.examples.reuse::model.places"
                item
                    id "ddn.examples.reuse::model.logs"
                item
                    id "ddn.examples.reuse::model.notifies"
        layout
            algorithm "grid"
            gap 80
        legend
            placement "bottom"
            width 280
        background
            color "#f6f8fc"
        publication
            id "publication:reuse"

    use "ddn.examples.reuse::model.audit_log" named "appearance:reuse:ddn.examples.reuse::model.audit_log"
        with
            id "appearance:reuse:ddn.examples.reuse::model.audit_log"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.reuse::model.customer" named "appearance:reuse:ddn.examples.reuse::model.customer"
        with
            id "appearance:reuse:ddn.examples.reuse::model.customer"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.reuse::model.order" named "appearance:reuse:ddn.examples.reuse::model.order"
        with
            id "appearance:reuse:ddn.examples.reuse::model.order"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.reuse::model.events" named "appearance:reuse:ddn.examples.reuse::model.events"
        with
            id "appearance:reuse:ddn.examples.reuse::model.events"

    use "ddn.examples.reuse::model.places" named "appearance:reuse:ddn.examples.reuse::model.places"
        with
            id "appearance:reuse:ddn.examples.reuse::model.places"

    use "ddn.examples.reuse::model.logs" named "appearance:reuse:ddn.examples.reuse::model.logs"
        with
            id "appearance:reuse:ddn.examples.reuse::model.logs"

    use "ddn.examples.reuse::model.notifies" named "appearance:reuse:ddn.examples.reuse::model.notifies"
        with
            id "appearance:reuse:ddn.examples.reuse::model.notifies"


view "traced" as "ddn@1"
    with
        id "traced"
        title "Reusable presets / event trace"
        selection
            include
                item
                    id "ddn.examples.reuse::model.audit_log"
                item
                    id "ddn.examples.reuse::model.customer"
                item
                    id "ddn.examples.reuse::model.order"
                item
                    id "ddn.examples.reuse::model.events"
                item
                    id "ddn.examples.reuse::model.places"
                item
                    id "ddn.examples.reuse::model.logs"
                item
                    id "ddn.examples.reuse::model.notifies"
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        animation
            steps
                item
                    id "ddn.examples.reuse::model.order"
                item
                    id "ddn.examples.reuse::model.customer"
                item
                    id "ddn.examples.reuse::model.audit_log"
            marker "square"
            marker_color "#1D4ED8"
            speed 80
            rate 2
            label "Order path"
            uid "ddn.examples.reuse::traced.order_path"
        publication
            id "publication:traced"

    use "ddn.examples.reuse::model.audit_log" named "appearance:traced:ddn.examples.reuse::model.audit_log"
        with
            id "appearance:traced:ddn.examples.reuse::model.audit_log"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.reuse::model.customer" named "appearance:traced:ddn.examples.reuse::model.customer"
        with
            id "appearance:traced:ddn.examples.reuse::model.customer"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.reuse::model.order" named "appearance:traced:ddn.examples.reuse::model.order"
        with
            id "appearance:traced:ddn.examples.reuse::model.order"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.reuse::model.events" named "appearance:traced:ddn.examples.reuse::model.events"
        with
            id "appearance:traced:ddn.examples.reuse::model.events"

    use "ddn.examples.reuse::model.places" named "appearance:traced:ddn.examples.reuse::model.places"
        with
            id "appearance:traced:ddn.examples.reuse::model.places"

    use "ddn.examples.reuse::model.logs" named "appearance:traced:ddn.examples.reuse::model.logs"
        with
            id "appearance:traced:ddn.examples.reuse::model.logs"

    use "ddn.examples.reuse::model.notifies" named "appearance:traced:ddn.examples.reuse::model.notifies"
        with
            id "appearance:traced:ddn.examples.reuse::model.notifies"
