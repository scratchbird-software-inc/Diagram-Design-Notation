version ddn-next-1

publication "publication:reuse"
    with
        id "publication:reuse"
        title "Reusable presets / customer orders"
        targets
            item
                target
                    id "reuse"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


publication "publication:traced"
    with
        id "publication:traced"
        title "Reusable presets / event trace"
        targets
            item
                target
                    id "traced"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


