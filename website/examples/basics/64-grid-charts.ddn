view "heatmap" as "chart.heatmap@1"
    with
        id "heatmap"
        title "Requests by hour and endpoint / heatmap"
        selection
            include empty list
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.grid-charts::cells.h1"
                    item
                        id "ddn.examples.grid-charts::cells.h2"
                    item
                        id "ddn.examples.grid-charts::cells.h3"
                    item
                        id "ddn.examples.grid-charts::cells.h4"
                    item
                        id "ddn.examples.grid-charts::cells.h5"
                    item
                        id "ddn.examples.grid-charts::cells.h6"
                    item
                        id "ddn.examples.grid-charts::cells.h7"
                    item
                        id "ddn.examples.grid-charts::cells.h8"
                    item
                        id "ddn.examples.grid-charts::cells.h9"
                mark "heatmap"
                x "metadata.x_record.hour"
                y "metadata.x_record.n"
                series "metadata.x_record.endpoint"
                unit "req"
                width 1120
                height 620


view "densityheatmap" as "chart.densityheatmap@1"
    with
        id "densityheatmap"
        title "Latency vs payload / density heatmap"
        selection
            include empty list
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.grid-charts::scatter.p1"
                    item
                        id "ddn.examples.grid-charts::scatter.p2"
                    item
                        id "ddn.examples.grid-charts::scatter.p3"
                    item
                        id "ddn.examples.grid-charts::scatter.p4"
                    item
                        id "ddn.examples.grid-charts::scatter.p5"
                    item
                        id "ddn.examples.grid-charts::scatter.p6"
                    item
                        id "ddn.examples.grid-charts::scatter.p7"
                    item
                        id "ddn.examples.grid-charts::scatter.p8"
                    item
                        id "ddn.examples.grid-charts::scatter.p9"
                    item
                        id "ddn.examples.grid-charts::scatter.p10"
                mark "densityheatmap"
                x "metadata.x_record.size"
                x_type "number"
                y "metadata.x_record.ms"
                bin_count 5
                width 1120
                height 620


