version ddn-next-1

publication "publication:heatmap"
    with
        id "publication:heatmap"
        title "Requests by hour and endpoint / heatmap"
        targets
            item
                target
                    id "heatmap"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:densityheatmap"
    with
        id "publication:densityheatmap"
        title "Latency vs payload / density heatmap"
        targets
            item
                target
                    id "densityheatmap"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:calendar"
    with
        id "publication:calendar"
        title "Deploys per day / calendar"
        targets
            item
                target
                    id "calendar"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:parallelcoords"
    with
        id "publication:parallelcoords"
        title "Service metric vectors / parallel coordinates"
        targets
            item
                target
                    id "parallelcoords"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:wordcloud"
    with
        id "publication:wordcloud"
        title "Incident tags / word cloud"
        targets
            item
                target
                    id "wordcloud"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


