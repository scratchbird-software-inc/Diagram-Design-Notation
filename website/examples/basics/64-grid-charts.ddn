ddn "0.5";
module "ddn.examples.grid-charts";

// Synthetic telemetry: request counts by hour and endpoint, a latency scatter,
// daily deploy counts, per-service metric vectors, and incident-tag weights.
// All data is synthetic.
data cells {
    record h1 "api × morning" {x_record: {"hour": "morning", "endpoint": "api", "n": 420, "unit": "req"}; }
    record h2 "api × midday" {x_record: {"hour": "midday", "endpoint": "api", "n": 610, "unit": "req"}; }
    record h3 "api × evening" {x_record: {"hour": "evening", "endpoint": "api", "n": 380, "unit": "req"}; }
    record h4 "web × morning" {x_record: {"hour": "morning", "endpoint": "web", "n": 250, "unit": "req"}; }
    record h5 "web × midday" {x_record: {"hour": "midday", "endpoint": "web", "n": 470, "unit": "req"}; }
    record h6 "web × evening" {x_record: {"hour": "evening", "endpoint": "web", "n": 520, "unit": "req"}; }
    record h7 "batch × morning" {x_record: {"hour": "morning", "endpoint": "batch", "n": 90, "unit": "req"}; }
    record h8 "batch × midday" {x_record: {"hour": "midday", "endpoint": "batch", "n": 140, "unit": "req"}; }
    record h9 "batch × evening" {x_record: {"hour": "evening", "endpoint": "batch", "n": 60, "unit": "req"}; }
}

data scatter {
    record p1 "s1" {x_record: {"size": 12, "ms": 44}; }
    record p2 "s2" {x_record: {"size": 18, "ms": 51}; }
    record p3 "s3" {x_record: {"size": 25, "ms": 63}; }
    record p4 "s4" {x_record: {"size": 31, "ms": 70}; }
    record p5 "s5" {x_record: {"size": 44, "ms": 95}; }
    record p6 "s6" {x_record: {"size": 52, "ms": 101}; }
    record p7 "s7" {x_record: {"size": 63, "ms": 130}; }
    record p8 "s8" {x_record: {"size": 70, "ms": 128}; }
    record p9 "s9" {x_record: {"size": 88, "ms": 170}; }
    record p10 "s10" {x_record: {"size": 95, "ms": 182}; }
}

data deploys {
    record w1 "2026-03-02" {x_record: {"day": "2026-03-02", "n": 3, "unit": "deploys"}; }
    record w2 "2026-03-03" {x_record: {"day": "2026-03-03", "n": 5, "unit": "deploys"}; }
    record w3 "2026-03-04" {x_record: {"day": "2026-03-04", "n": 2, "unit": "deploys"}; }
    record w4 "2026-03-06" {x_record: {"day": "2026-03-06", "n": 4, "unit": "deploys"}; }
    record w5 "2026-03-09" {x_record: {"day": "2026-03-09", "n": 6, "unit": "deploys"}; }
    record w6 "2026-03-10" {x_record: {"day": "2026-03-10", "n": 1, "unit": "deploys"}; }
    record w7 "2026-03-12" {x_record: {"day": "2026-03-12", "n": 4, "unit": "deploys"}; }
    record w8 "2026-03-13" {x_record: {"day": "2026-03-13", "n": 7, "unit": "deploys"}; }
    record w9 "2026-03-16" {x_record: {"day": "2026-03-16", "n": 2, "unit": "deploys"}; }
    record w10 "2026-03-18" {x_record: {"day": "2026-03-18", "n": 5, "unit": "deploys"}; }
    record w11 "2026-03-20" {x_record: {"day": "2026-03-20", "n": 3, "unit": "deploys"}; }
    record w12 "2026-03-24" {x_record: {"day": "2026-03-24", "n": 8, "unit": "deploys"}; }
    record w13 "2026-03-27" {x_record: {"day": "2026-03-27", "n": 2, "unit": "deploys"}; }
    record w14 "2026-03-31" {x_record: {"day": "2026-03-31", "n": 4, "unit": "deploys"}; }
}

data metrics {
    record m1 "auth · cpu" {x_record: {"service": "auth", "metric": "cpu", "v": 62}; }
    record m2 "auth · mem" {x_record: {"service": "auth", "metric": "mem", "v": 48}; }
    record m3 "auth · p99" {x_record: {"service": "auth", "metric": "p99", "v": 210}; }
    record m4 "auth · rps" {x_record: {"service": "auth", "metric": "rps", "v": 900}; }
    record m5 "store · cpu" {x_record: {"service": "store", "metric": "cpu", "v": 81}; }
    record m6 "store · mem" {x_record: {"service": "store", "metric": "mem", "v": 74}; }
    record m7 "store · p99" {x_record: {"service": "store", "metric": "p99", "v": 340}; }
    record m8 "store · rps" {x_record: {"service": "store", "metric": "rps", "v": 640}; }
    record m9 "relay · cpu" {x_record: {"service": "relay", "metric": "cpu", "v": 35}; }
    record m10 "relay · mem" {x_record: {"service": "relay", "metric": "mem", "v": 41}; }
    record m11 "relay · p99" {x_record: {"service": "relay", "metric": "p99", "v": 120}; }
    record m12 "relay · rps" {x_record: {"service": "relay", "metric": "rps", "v": 1250}; }
}

data tags {
    record t1 "latency" {x_record: {"tag": "latency", "n": 34}; }
    record t2 "timeout" {x_record: {"tag": "timeout", "n": 28}; }
    record t3 "cache" {x_record: {"tag": "cache", "n": 19}; }
    record t4 "deploy" {x_record: {"tag": "deploy", "n": 15}; }
    record t5 "dns" {x_record: {"tag": "dns", "n": 9}; }
    record t6 "tls" {x_record: {"tag": "tls", "n": 7}; }
    record t7 "quota" {x_record: {"tag": "quota", "n": 5}; }
    record t8 "retry" {x_record: {"tag": "retry", "n": 12}; }
    record t9 "shard" {x_record: {"tag": "shard", "n": 4}; }
    record t10 "queue" {x_record: {"tag": "queue", "n": 8}; }
}

view heatmap "Requests by hour and endpoint / heatmap" {
    data: [@cells];
    projection { kind:chart; profile:"chart.heatmap@1"; records:[@cells.h1, @cells.h2, @cells.h3, @cells.h4, @cells.h5, @cells.h6, @cells.h7, @cells.h8, @cells.h9]; mark:heatmap; x:"x_record.hour"; y:"x_record.n"; series:"x_record.endpoint"; unit:"req"; width:1120px; height:620px; }
    publication { size: content; fit: none; }
}

view densityheatmap "Latency vs payload / density heatmap" {
    data: [@scatter];
    projection { kind:chart; profile:"chart.densityheatmap@1"; records:[@scatter.p1, @scatter.p2, @scatter.p3, @scatter.p4, @scatter.p5, @scatter.p6, @scatter.p7, @scatter.p8, @scatter.p9, @scatter.p10]; mark:densityheatmap; x:"x_record.size"; x_type:number; y:"x_record.ms"; bin_count:5; width:1120px; height:620px; }
    publication { size: content; fit: none; }
}

view calendar "Deploys per day / calendar" {
    data: [@deploys];
    projection { kind:chart; profile:"chart.calendar@1"; records:[@deploys.w1, @deploys.w2, @deploys.w3, @deploys.w4, @deploys.w5, @deploys.w6, @deploys.w7, @deploys.w8, @deploys.w9, @deploys.w10, @deploys.w11, @deploys.w12, @deploys.w13, @deploys.w14]; mark:calendar; x:"x_record.day"; x_type:date; y:"x_record.n"; unit:"deploys"; width:1120px; height:620px; }
    publication { size: content; fit: none; }
}

view parallelcoords "Service metric vectors / parallel coordinates" {
    data: [@metrics];
    projection { kind:chart; profile:"chart.parallelcoords@1"; records:[@metrics.m1, @metrics.m2, @metrics.m3, @metrics.m4, @metrics.m5, @metrics.m6, @metrics.m7, @metrics.m8, @metrics.m9, @metrics.m10, @metrics.m11, @metrics.m12]; mark:parallelcoords; x:"x_record.metric"; y:"x_record.v"; series:"x_record.service"; width:1120px; height:620px; }
    publication { size: content; fit: none; }
}

view wordcloud "Incident tags / word cloud" {
    data: [@tags];
    projection { kind:chart; profile:"chart.wordcloud@1"; records:[@tags.t1, @tags.t2, @tags.t3, @tags.t4, @tags.t5, @tags.t6, @tags.t7, @tags.t8, @tags.t9, @tags.t10]; mark:wordcloud; x:"x_record.tag"; y:"x_record.n"; width:1120px; height:620px; }
    publication { size: content; fit: none; }
}
