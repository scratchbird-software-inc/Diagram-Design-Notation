version ddn-next-1

asset "assets/geo/world-110m.json" as resource from "../../assets/geo/world-110m.json"
    with
        id "geography::assets/geo/world-110m.json"
        media_type "application/geo+json"


publication "publication:mercator"
    with
        id "publication:mercator"
        title "World outline / mercator"
        targets
            item
                target
                    id "mercator"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


publication "publication:equirectangular"
    with
        id "publication:equirectangular"
        title "World outline / equirectangular"
        targets
            item
                target
                    id "equirectangular"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


