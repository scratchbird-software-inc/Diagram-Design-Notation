        title "World outline / equal-earth"
        targets
            item
                target
                    id "equalearth"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.examples.geo-projections::geo.note" as "record"
    with
        id "ddn.examples.geo-projections::geo.note"
        title "Projection comparison"
        metadata
            x_record
                plate "world outline, four methods"


view "mercator" as "geo.outline@1"
    with
        id "mercator"
        title "World outline / mercator"
        selection
            include empty list
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        projection
            options
                mark "outline"
                geography "assets/geo/world-110m.json"
                method "mercator"
                graticule true
                width 1120
                height 640


view "equirectangular" as "geo.outline@1"
    with
        id "equirectangular"
        title "World outline / equirectangular"
