relation "ddn.examples.idef0::d.f1" as "idef0.flow"
    with
        id "ddn.examples.idef0::d.f1"
        title "packed orders"
        endpoints
            item
                definition
                    id "ddn.examples.idef0::d.a1"
                member
                    id "ddn.examples.idef0::d.a1.packed"
            item
                definition
                    id "ddn.examples.idef0::d.a2"
                member
                    id "ddn.examples.idef0::d.a2.packed"


relation "ddn.examples.idef0::d.f2" as "idef0.flow"
    with
        id "ddn.examples.idef0::d.f2"
        title "packed orders"
        endpoints
            item
                definition
                    id "ddn.examples.idef0::d.a1"
                member
                    id "ddn.examples.idef0::d.a1.packed"
            item
                definition
                    id "ddn.examples.idef0::d.a3"
                member
                    id "ddn.examples.idef0::d.a3.packed"


relation "ddn.examples.idef0::d.f3" as "idef0.flow"
    with
        id "ddn.examples.idef0::d.f3"
        title "returns"
        metadata
            x_tunnel
                start true
        endpoints
            item
                definition
                    id "ddn.examples.idef0::d.a3"
                member
                    id "ddn.examples.idef0::d.a3.packed"
            item
                definition
                    id "ddn.examples.idef0::d.a1"
                member
                    id "ddn.examples.idef0::d.a1.packed"


relation "ddn.examples.idef0::d.call1" as "idef0.call"
    with
        id "ddn.examples.idef0::d.call1"
        title "Call"
        metadata
            x_tunnel
                end true
        endpoints
            item
                definition
                    id "ddn.examples.idef0::d.a2"
            item
                definition
                    id "ddn.examples.idef0::d.a1"


view "context" as "idef0.basic@1"
    with
        id "context"
        title "A-0 context"
        selection
            include
                item
                    id "ddn.examples.idef0::m.a0"
            exclude
                item
                    id "ddn.examples.idef0::d.f1"
                item
                    id "ddn.examples.idef0::d.f2"
                item
                    id "ddn.examples.idef0::d.f3"
                item
                    id "ddn.examples.idef0::d.call1"
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        publication
            id "publication:context"

    use "ddn.examples.idef0::m.a0" named "appearance:context:ddn.examples.idef0::m.a0"
        with
            id "appearance:context:ddn.examples.idef0::m.a0"


view "detail" as "idef0.basic@1"
    with
        id "detail"
        title "A0 decomposition"
        selection
            include
                item
                    id "ddn.examples.idef0::d.a1"
                item
                    id "ddn.examples.idef0::d.a3"
                item
                    id "ddn.examples.idef0::d.a2"
                item
                    id "ddn.examples.idef0::d.f1"
                item
                    id "ddn.examples.idef0::d.f2"
                item
                    id "ddn.examples.idef0::d.f3"
                item
                    id "ddn.examples.idef0::d.call1"
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        publication
            id "publication:detail"

    use "ddn.examples.idef0::d.a1" named "appearance:detail:ddn.examples.idef0::d.a1"
        with
            id "appearance:detail:ddn.examples.idef0::d.a1"

    use "ddn.examples.idef0::d.a3" named "appearance:detail:ddn.examples.idef0::d.a3"
        with
            id "appearance:detail:ddn.examples.idef0::d.a3"

    use "ddn.examples.idef0::d.a2" named "appearance:detail:ddn.examples.idef0::d.a2"
        with
            id "appearance:detail:ddn.examples.idef0::d.a2"

    use "ddn.examples.idef0::d.f1" named "appearance:detail:ddn.examples.idef0::d.f1"
        with
            id "appearance:detail:ddn.examples.idef0::d.f1"

    use "ddn.examples.idef0::d.f2" named "appearance:detail:ddn.examples.idef0::d.f2"
        with
            id "appearance:detail:ddn.examples.idef0::d.f2"

    use "ddn.examples.idef0::d.f3" named "appearance:detail:ddn.examples.idef0::d.f3"
        with
            id "appearance:detail:ddn.examples.idef0::d.f3"

    use "ddn.examples.idef0::d.call1" named "appearance:detail:ddn.examples.idef0::d.call1"
        with
            id "appearance:detail:ddn.examples.idef0::d.call1"
