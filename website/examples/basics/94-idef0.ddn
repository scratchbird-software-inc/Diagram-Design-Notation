version ddn-next-1

publication "publication:context"
    with
        id "publication:context"
        title "A-0 context"
        targets
            item
                target
                    id "context"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:detail"
    with
        id "publication:detail"
        title "A0 decomposition"
        targets
            item
                target
                    id "detail"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.idef0::m.a0.orders" as "core::Port"
    with
        id "ddn.examples.idef0::m.a0.orders"
        title "orders"
        properties
            side "west"
        metadata
            x_icom
                type "input"
        content
            owner
                id "ddn.examples.idef0::m.a0"
            direction "input"


