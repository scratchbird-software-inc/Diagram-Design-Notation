element "ddn.examples.idef0::m.a0" as "idef0.activity"
    with
        id "ddn.examples.idef0::m.a0"
        title "Manage shop"
        metadata
            x_idef0
                node "A0"
            x_subdiagram
                view "detail"
        members
            item
