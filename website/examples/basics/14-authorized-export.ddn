view "private" as "ddn@1"
    with
        id "private"
        title "Private source / hiding is not redaction"
        selection
            include
                item
                    id "ddn.examples.export::model.workforce"
                item
                    id "ddn.examples.export::model.team"
                item
                    id "ddn.examples.export::model.membership"
            exclude
                item
                    id "public-2714562ed18a86e4a3cb"
        layout
            algorithm "grid"
            gap 80
        display
            fields "none"
        legend
            width 280
        background
            color "#f6f8fc"
        publication
            id "publication:private"

    use "ddn.examples.export::model.workforce" named "appearance:private:ddn.examples.export::model.workforce"
        with
            id "appearance:private:ddn.examples.export::model.workforce"
            body "title"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.export::model.team" named "appearance:private:ddn.examples.export::model.team"
        with
            id "appearance:private:ddn.examples.export::model.team"
            body "title"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.export::model.membership" named "appearance:private:ddn.examples.export::model.membership"
        with
            id "appearance:private:ddn.examples.export::model.membership"


