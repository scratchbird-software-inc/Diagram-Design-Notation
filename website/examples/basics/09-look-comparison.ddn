            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.lookcomparison::model.builder" named "appearance:handDrawn:ddn.examples.lookcomparison::model.builder"
        with
            id "appearance:handDrawn:ddn.examples.lookcomparison::model.builder"

    use "ddn.examples.lookcomparison::model.history" named "appearance:handDrawn:ddn.examples.lookcomparison::model.history"
        with
            id "appearance:handDrawn:ddn.examples.lookcomparison::model.history"
