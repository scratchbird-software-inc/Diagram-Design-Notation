            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.lookcomparison::model.capture" named "appearance:handDrawn:ddn.examples.lookcomparison::model.capture"
