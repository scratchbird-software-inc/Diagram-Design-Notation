view "pid" as "network.basic@1"
    with
        id "pid"
        title "P&ID symbol library"
        selection
            include
                item
                    id "ddn.examples.pidsymbols::m.tk"
                item
                    id "ddn.examples.pidsymbols::m.p1"
                item
                    id "ddn.examples.pidsymbols::m.fv"
                item
                    id "ddn.examples.pidsymbols::m.ft"
                item
                    id "ddn.examples.pidsymbols::m.fic"
                item
                    id "ddn.examples.pidsymbols::m.hx"
                item
                    id "ddn.examples.pidsymbols::m.v1"
                item
                    id "ddn.examples.pidsymbols::m.xv"
                item
                    id "ddn.examples.pidsymbols::m.li"
                item
