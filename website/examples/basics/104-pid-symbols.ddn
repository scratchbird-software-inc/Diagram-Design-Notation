                item
                    id "ddn.examples.pidsymbols::m.s4"
                item
                    id "ddn.examples.pidsymbols::m.s5"
        layout
            algorithm "layered"
            gap 112
            row_gap 112
        background
            color "#f6f8fc"
        publication
            id "publication:pid"

    use "ddn.examples.pidsymbols::m.tk" named "appearance:pid:ddn.examples.pidsymbols::m.tk"
        with
            id "appearance:pid:ddn.examples.pidsymbols::m.tk"
            symbol
                image
                    id "artwork::pid-common@1:tank-roof"

    use "ddn.examples.pidsymbols::m.p1" named "appearance:pid:ddn.examples.pidsymbols::m.p1"
        with
            id "appearance:pid:ddn.examples.pidsymbols::m.p1"
            symbol
