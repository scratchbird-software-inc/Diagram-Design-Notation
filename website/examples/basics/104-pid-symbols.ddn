publication "publication:pid"
    with
        id "publication:pid"
        title "P&ID symbol library"
        targets
            item
                target
                    id "pid"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.pidsymbols::m.tk" as "network.server"
    with
        id "ddn.examples.pidsymbols::m.tk"
        title "Feed tank"
        metadata
            x_icon
                library "pid-common@1"
                icon "tank-roof"


