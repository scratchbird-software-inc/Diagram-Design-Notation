ddn "0.5";

module "ddn.examples.subdiagrams";
data model {
    object service "Customer service" { kind: application; }
    object table "Customer table" { kind: table; fields { field customer_id; field display_name; } }
    object schema "crm schema" { kind: schema; }
    relation member @table -> @schema { kind: namespace_member; }
}
view overview "A view can link to another view" {
    data: [@model]; format: @ddn.examples.shared.styles.technical;
    select: [@model.service];
    subdiagram storage "Storage details" { view: @detail; mode: reference; at: [480px,20px]; size: [310px,105px]; }
}
view detail "Storage detail" {
    data: [@model]; format: @ddn.examples.shared.styles.technical;
    select: [@model.table, @model.schema];
    display: @ddn.examples.shared.styles.compact;
    publication { width: 700px; height: 320px; margin: 20px; minimum_text: 7pt; overflow: warn; }
    legend { mode: tokens; placement: none; }
}
view inline "An embedded view retains its own composition" {
    data: [@model]; format: @ddn.examples.shared.styles.technical;
    select: [@model.service];
    legend { mode: text; placement: none; }
    subdiagram storage "Storage details" { view: @detail; mode: inline; at: [330px,0px]; size: [710px,426px]; }
}

module "ddn.examples.shared";
format styles {
    notation core;
    style classic;
    style hand { look: handDrawn; font: handwriting; roughness: 1.8; hachure: true; }
    style neo { look: neo; }
    style dark { theme: dark; }
    style neutral { theme: neutral; font: mono; }
    style forest { look: handDrawn; theme: forest; font: handwriting; roughness: 1.8; hachure: true; }
    layout wires { algorithm: grid; gap: 80px; }
    display detailed;
    display compact { fields: none; maturity: none; badges: none; }
    publication screen { size: content; width: 1360px; height: 860px; margin: 30px; overflow: warn; }
    publication paper { size: a4; orientation: landscape; margin: 8mm; minimum_text: 7pt; overflow: warn; }
    legend words { width: 280px; }
    legend numbers { mode: numbers; width: 280px; }
    bundle technical {
        notation: @core;
        style: @classic;
        layout: @wires;
        display: @detailed;
        publication: @screen;
        legend: @words;
    }
}
