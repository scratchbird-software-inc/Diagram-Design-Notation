element "ddn.examples.tree-charts::sales.n1" as "record"
    with
        id "ddn.examples.tree-charts::sales.n1"
        title "North.Hardware.Tools"
        metadata
            x_record
                path "North.Hardware.Tools"
                sales 120
                unit "kEUR"


