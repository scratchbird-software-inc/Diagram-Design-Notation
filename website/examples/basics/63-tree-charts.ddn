version ddn-next-1

publication "publication:tidytree"
    with
        id "publication:tidytree"
        title "Sales hierarchy / tidy tree"
        targets
            item
                target
                    id "tidytree"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:radialtree"
    with
        id "publication:radialtree"
