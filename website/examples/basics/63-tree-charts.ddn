view "tidytree" as "chart.tidytree@1"
    with
        id "tidytree"
        title "Sales hierarchy / tidy tree"
        selection
            include empty list
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.tree-charts::sales.n1"
                    item
                        id "ddn.examples.tree-charts::sales.n2"
                    item
                        id "ddn.examples.tree-charts::sales.n3"
                    item
                        id "ddn.examples.tree-charts::sales.n4"
                    item
                        id "ddn.examples.tree-charts::sales.s1"
                    item
                        id "ddn.examples.tree-charts::sales.s2"
                    item
                        id "ddn.examples.tree-charts::sales.s3"
                    item
                        id "ddn.examples.tree-charts::sales.s4"
                    item
                        id "ddn.examples.tree-charts::sales.s5"
                mark "tidytree"
                x "metadata.x_record.path"
                y "metadata.x_record.sales"
                unit "kEUR"
                width 1120
                height 620


