version ddn-next-1

publication "publication:defaults"
    with
        id "publication:defaults"
        title "Element defaults / bare versus explicit"
        targets
            item
                target
                    id "defaults"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1600
                unit "px"
            height
                value 1000
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


element "ddn.examples.element-defaults::model.bare" as "cache"
    with
        id "ddn.examples.element-defaults::model.bare"
        title "Bare cache (registry default role)"


element "ddn.examples.element-defaults::model.explicit" as "cache"
    with
        id "ddn.examples.element-defaults::model.explicit"
        title "Explicit override wins"
        description "role is stated in source, overriding the registry default role: cache."
        facets
            distribution
                item "PRIMARY"
        properties
            role "primary"
        metadata
            x_record
                layout_group "primary"


view "defaults" as "ddn@1"
    with
        id "defaults"
        title "Element defaults / bare versus explicit"
        selection
            include
                item
                    id "ddn.examples.element-defaults::model.bare"
                item
                    id "ddn.examples.element-defaults::model.explicit"
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        publication
            id "publication:defaults"

    use "ddn.examples.element-defaults::model.bare" named "appearance:defaults:ddn.examples.element-defaults::model.bare"
        with
            id "appearance:defaults:ddn.examples.element-defaults::model.bare"

    use "ddn.examples.element-defaults::model.explicit" named "appearance:defaults:ddn.examples.element-defaults::model.explicit"
        with
            id "appearance:defaults:ddn.examples.element-defaults::model.explicit"
            body "notes"
