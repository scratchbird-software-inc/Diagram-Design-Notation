view "straight" as "ddn@1"
    with
        id "straight"
        title "Hand-drawn straight routing / relation family unchanged"
        selection
            include
                item
                    id "ddn.examples.routinghand::model.west"
                item
                    id "ddn.examples.routinghand::model.east"
                item
                    id "ddn.examples.routinghand::model.horizontal"
            exclude
                item
                    id "ddn.examples.routinghand::model.vertical"
        style
            look "handdrawn"
            font "handwriting"
            roughness 1.8
        layout
            algorithm "grid"
            routing "straight"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        publication
            id "publication:straight"

    use "ddn.examples.routinghand::model.west" named "appearance:straight:ddn.examples.routinghand::model.west"
        with
            id "appearance:straight:ddn.examples.routinghand::model.west"
            position
                x 0
                y 0
            pinned true

    use "ddn.examples.routinghand::model.east" named "appearance:straight:ddn.examples.routinghand::model.east"
        with
            id "appearance:straight:ddn.examples.routinghand::model.east"
            position
                x 520
                y 240
            pinned true

    use "ddn.examples.routinghand::model.horizontal" named "appearance:straight:ddn.examples.routinghand::model.horizontal"
        with
            id "appearance:straight:ddn.examples.routinghand::model.horizontal"
