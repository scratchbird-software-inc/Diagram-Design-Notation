version ddn-next-1

publication "publication:gap"
    with
        id "publication:gap"
        title "Hand-drawn crossing / disconnected gap"
        targets
            item
                target
                    id "gap"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1300
                unit "px"
            height
                value 850
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


publication "publication:bridge"
    with
        id "publication:bridge"
        title "Hand-drawn crossing / round bridge"
        targets
            item
                target
                    id "bridge"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1300
                unit "px"
            height
                value 850
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


publication "publication:square_bridge"
    with
        id "publication:square_bridge"
        title "Hand-drawn crossing / square bridge"
        targets
            item
                target
                    id "square_bridge"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1300
                unit "px"
            height
                value 850
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


publication "publication:straight"
    with
        id "publication:straight"
        title "Hand-drawn straight routing / relation family unchanged"
        targets
            item
                target
                    id "straight"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


element "ddn.examples.routinghand::model.west" as "dataset"
    with
        id "ddn.examples.routinghand::model.west"
        title "West source"


element "ddn.examples.routinghand::model.east" as "dataset"
    with
        id "ddn.examples.routinghand::model.east"
        title "East target"


element "ddn.examples.routinghand::model.north" as "dataset"
    with
        id "ddn.examples.routinghand::model.north"
        title "North source"


element "ddn.examples.routinghand::model.south" as "dataset"
    with
        id "ddn.examples.routinghand::model.south"
        title "South target"


relation "ddn.examples.routinghand::model.horizontal" as "flow"
    with
        id "ddn.examples.routinghand::model.horizontal"
        title "transfers data to"
        endpoints
            item
                definition
                    id "ddn.examples.routinghand::model.west"
            item
                definition
                    id "ddn.examples.routinghand::model.east"


relation "ddn.examples.routinghand::model.vertical" as "flow"
    with
        id "ddn.examples.routinghand::model.vertical"
        title "transfers data to"
        endpoints
            item
                definition
                    id "ddn.examples.routinghand::model.north"
            item
                definition
                    id "ddn.examples.routinghand::model.south"


view "gap" as "ddn@1"
    with
        id "gap"
        title "Hand-drawn crossing / disconnected gap"
        selection
            include
                item
                    id "ddn.examples.routinghand::model.west"
                item
                    id "ddn.examples.routinghand::model.east"
                item
                    id "ddn.examples.routinghand::model.north"
                item
                    id "ddn.examples.routinghand::model.south"
                item
                    id "ddn.examples.routinghand::model.horizontal"
                item
                    id "ddn.examples.routinghand::model.vertical"
        style
            look "handdrawn"
            font "handwriting"
            roughness 1.8
        layout
            algorithm "grid"
            gap 80
        display
            fields "none"
            maturity "none"
            badges "none"
        legend
            mode "numbers"
            width 280
            keys
                model.horizontal "4"
                model.vertical "9"
        background
            color "#f6f8fc"
        publication
            id "publication:gap"

    use "ddn.examples.routinghand::model.west" named "appearance:gap:ddn.examples.routinghand::model.west"
        with
            id "appearance:gap:ddn.examples.routinghand::model.west"
            position
                x 0
                y 220
            pinned true
            size
                width 240
                height 100
            text
                fit "wrap"

    use "ddn.examples.routinghand::model.east" named "appearance:gap:ddn.examples.routinghand::model.east"
        with
            id "appearance:gap:ddn.examples.routinghand::model.east"
            position
                x 630
                y 220
            pinned true
            size
                width 240
                height 100
            text
                fit "wrap"

    use "ddn.examples.routinghand::model.north" named "appearance:gap:ddn.examples.routinghand::model.north"
        with
            id "appearance:gap:ddn.examples.routinghand::model.north"
            position
                x 315
                y 0
            pinned true
            size
                width 240
                height 100
            text
                fit "wrap"

    use "ddn.examples.routinghand::model.south" named "appearance:gap:ddn.examples.routinghand::model.south"
        with
            id "appearance:gap:ddn.examples.routinghand::model.south"
            position
                x 315
                y 450
            pinned true
            size
                width 240
                height 100
            text
                fit "wrap"

    use "ddn.examples.routinghand::model.horizontal" named "appearance:gap:ddn.examples.routinghand::model.horizontal"
        with
            id "appearance:gap:ddn.examples.routinghand::model.horizontal"
            route
                source_side "east"
                target_side "west"
                via
                    item
                        x 435
                        y 270

    use "ddn.examples.routinghand::model.vertical" named "appearance:gap:ddn.examples.routinghand::model.vertical"
        with
            id "appearance:gap:ddn.examples.routinghand::model.vertical"
            route
                source_side "south"
                target_side "north"
                via
                    item
                        x 435
                        y 270


