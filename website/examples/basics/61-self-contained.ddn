version ddn-next-1

publication "publication:overview"
    with
        id "publication:overview"
        title "Self-contained / overview"
        targets
            item
                target
                    id "overview"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


publication "publication:compact"
    with
        id "publication:compact"
        title "Self-contained / compact"
        targets
            item
                target
                    id "compact"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


element "shop.data::records.customer.customer_id" as "field"
    with
        id "shop.data::records.customer.customer_id"
        title "customer_id"
        properties
            key "primary"
        content
            parent
                id "shop.data::records.customer"
            ordinal 0
            key "primary"


element "shop.data::records.customer.display_name" as "field"
    with
        id "shop.data::records.customer.display_name"
        title "display_name"
        content
            parent
                id "shop.data::records.customer"
            ordinal 1


element "shop.data::records.customer" as "table"
    with
        id "shop.data::records.customer"
        title "Customer"
        facets
            authority
                item "AUTH"
        properties
            role "authoritative"
        metadata
            x_record
                layout_group "authoritative"
        members
            item
                id "shop.data::records.customer.customer_id"
            item
                id "shop.data::records.customer.display_name"
        data
            columns
                item
                    id "field"
                    label "field"
                item
                    id "type"
                    label "type"
                item
                    id "domain"
                    label "domain"
                item
                    id "constraint"
                    label "constraint"
                item
                    id "key"
                    label "key"
                item
                    id "comment"
                    label "comment"
            rows
                item
                    item "customer_id"
                    item null
                    item null
                    item null
                    item "primary"
                    item null
                item
                    item "display_name"
                    item null
                    item null
                    item null
                    item null
                    item null


