element "shop.data::records.customers" as "sample"
    with
        id "shop.data::records.customers"
        title "Synthetic customers"
        properties
            mode "synthetic"
            columns
                item
                    id "shop.data::records.customer.customer_id"
                item
                    id "shop.data::records.customer.display_name"
            rows
                item
                    item "C001"
                    item "Customer A"
                item
                    item "C002"
                    item "Customer B"
        data
            columns
                item
                    id "column-0"
                    label "customer_id"
                item
                    id "column-1"
                    label "display_name"
            rows
                item
                    item "C001"
                    item "Customer A"
                item
                    item "C002"
                    item "Customer B"


relation "shop.data::records.order_customer" as "ref"
    with
        id "shop.data::records.order_customer"
        title "Customer places orders"
        properties
            source_mark "zeromany"
            target_mark "one"
        endpoints
            item
                definition
                    id "shop.data::records.order"
                member
                    id "shop.data::records.order.customer_id"
            item
                definition
                    id "shop.data::records.customer"
                member
                    id "shop.data::records.customer.customer_id"


view "overview" as "ddn@1"
    with
        id "overview"
        title "Self-contained / overview"
        selection
            include
                item
                    id "shop.data::records.customer"
                item
                    id "shop.data::records.order"
                item
                    id "shop.data::records.customers"
                item
                    id "shop.data::records.order_customer"
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        publication
            id "publication:overview"

    use "shop.data::records.customer" named "appearance:overview:shop.data::records.customer"
        with
            id "appearance:overview:shop.data::records.customer"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "shop.data::records.order" named "appearance:overview:shop.data::records.order"
        with
            id "appearance:overview:shop.data::records.order"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "shop.data::records.customers" named "appearance:overview:shop.data::records.customers"
        with
            id "appearance:overview:shop.data::records.customers"
            body "columns"

    use "shop.data::records.order_customer" named "appearance:overview:shop.data::records.order_customer"
        with
            id "appearance:overview:shop.data::records.order_customer"


view "compact" as "ddn@1"
    with
        id "compact"
        title "Self-contained / compact"
        selection
            include
                item
                    id "shop.data::records.customer"
                item
                    id "shop.data::records.order"
                item
                    id "shop.data::records.customers"
                item
                    id "shop.data::records.order_customer"
        layout
            algorithm "grid"
            gap 80
        display
            fields "none"
        legend
            width 280
        background
            color "#f6f8fc"
        publication
            id "publication:compact"

    use "shop.data::records.customer" named "appearance:compact:shop.data::records.customer"
        with
            id "appearance:compact:shop.data::records.customer"
            body "title"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "shop.data::records.order" named "appearance:compact:shop.data::records.order"
        with
            id "appearance:compact:shop.data::records.order"
            body "title"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "shop.data::records.customers" named "appearance:compact:shop.data::records.customers"
        with
            id "appearance:compact:shop.data::records.customers"
            body "columns"

    use "shop.data::records.order_customer" named "appearance:compact:shop.data::records.order_customer"
        with
            id "appearance:compact:shop.data::records.order_customer"
