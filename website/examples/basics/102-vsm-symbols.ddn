ddn "0.5";
module "ddn.examples.vsmsymbols";

// B1-087: the vsm-symbols@1 icon library — common-practice artwork upgrade
// over the built-in simple VSM glyphs. Default kind bindings cover the
// process/customer/control/inventory/supermarket/kaizen/operator kinds; the
// remaining symbols (truck, FIFO lane, electronic information, timeline
// ladder, safety stock) bind per node via x_icon. Common-practice rendering
// — compliance against the standard pending document review. All data is
// synthetic.
data m {
    object sup "Supplier" { kind: "vsm.customer"; x_icon: { library: "vsm-symbols@1", icon: "supplier" }; }
    object ctrl "Production control" { kind: "vsm.control"; }
    object stamp "Stamping" { kind: "vsm.process"; x_vsm: { va: 1.5, nva: 3, unit: "d" };
        fields { co "C/O 30 min"; }
    }
    object inv1 "" { kind: "vsm.inventory"; }
    object asm "Assembly" { kind: "vsm.process"; x_vsm: { va: 3, nva: 2, unit: "d" }; }
    object market "Supermarket" { kind: "vsm.supermarket"; }
    object cust "Customer" { kind: "vsm.customer"; }
    object ship "Weekly shipment" { kind: "vsm.process"; x_icon: { library: "vsm-symbols@1", icon: "truck" }; }
    object lane "FIFO lane" { kind: "vsm.process"; x_icon: { library: "vsm-symbols@1", icon: "fifo-lane" }; }
    object sched "ERP schedule" { kind: "vsm.control"; x_icon: { library: "vsm-symbols@1", icon: "einfo" }; }
    object buf "Buffer stock" { kind: "vsm.inventory"; x_icon: { library: "vsm-symbols@1", icon: "safety-stock" }; }
    object kz "" { kind: "vsm.kaizen"; }
    object op "Operator" { kind: "vsm.operator"; }
    relation m1 "" @sup -> @stamp { kind: "vsm.material"; }
    relation m2 "" @stamp -> @inv1 { kind: "vsm.push"; }
    relation m3 "" @inv1 -> @asm { kind: "vsm.material"; }
    relation m4 "" @asm -> @market { kind: "vsm.material"; }
    relation m5 "" @market -> @cust { kind: "vsm.pull"; }
    relation i1 "" @ctrl -> @stamp { kind: "vsm.einfo"; }
    relation i2 "" @sched -> @ctrl { kind: "vsm.einfo"; }
    relation i3 "" @ship -> @cust { kind: "vsm.material"; }
    relation i4 "" @lane -> @asm { kind: "vsm.material"; }
    relation i5 "" @buf -> @lane { kind: "vsm.material"; }
    relation o1 "" @op -> @asm { kind: "vsm.minfo"; }
}
view map "VSM symbol library": [@m] as "vsm.basic@1" {
    layout { algorithm: layered; }
    publication { size: content; fit: none; }
}
