        id "ddn.examples.vsmsymbols::m.stamp.co"
        title "C/O 30 min"
        content
            parent
                id "ddn.examples.vsmsymbols::m.stamp"
            ordinal 0


element "ddn.examples.vsmsymbols::m.stamp" as "vsm.process"
    with
        id "ddn.examples.vsmsymbols::m.stamp"
        title "Stamping"
        metadata
            x_vsm
                va 1.5
                nva 3
                unit "d"
        members
            item
                id "ddn.examples.vsmsymbols::m.stamp.co"
        data
            columns
                item
                    id "field"
                    label "field"
                item
                    id "type"
                    label "type"
                item
                    id "domain"
                    label "domain"
                item
                    id "constraint"
                    label "constraint"
                item
                    id "key"
                    label "key"
                item
                    id "comment"
                    label "comment"
            rows
                item
                    item "C/O 30 min"
                    item null
                    item null
                    item null
                    item null
                    item null


