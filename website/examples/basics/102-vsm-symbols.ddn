publication "publication:map"
    with
        id "publication:map"
        title "VSM symbol library"
        targets
            item
                target
                    id "map"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.vsmsymbols::m.sup" as "vsm.customer"
    with
        id "ddn.examples.vsmsymbols::m.sup"
        title "Supplier"
        metadata
            x_icon
                library "vsm-symbols@1"
                icon "supplier"


element "ddn.examples.vsmsymbols::m.ctrl" as "vsm.control"
