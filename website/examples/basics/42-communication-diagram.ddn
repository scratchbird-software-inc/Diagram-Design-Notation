version ddn-next-1

publication "publication:communication"
    with
        id "publication:communication"
        title "Synthetic order flow / communication"
        targets
            item
                target
                    id "communication"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.examples.communication::flow.customer_app" as "application"
    with
        id "ddn.examples.communication::flow.customer_app"
        title "Customer app"


element "ddn.examples.communication::flow.checkout" as "service"
    with
        id "ddn.examples.communication::flow.checkout"
        title "Checkout"


element "ddn.examples.communication::flow.inventory" as "service"
    with
        id "ddn.examples.communication::flow.inventory"
        title "Inventory"


relation "ddn.examples.communication::flow.submit_order" as "uml.message"
    with
        id "ddn.examples.communication::flow.submit_order"
        title "Submit order"
        metadata
            x_message
                seq "1"
        endpoints
            item
                definition
                    id "ddn.examples.communication::flow.customer_app"
            item
                definition
                    id "ddn.examples.communication::flow.checkout"


relation "ddn.examples.communication::flow.reserve_stock" as "uml.message"
    with
        id "ddn.examples.communication::flow.reserve_stock"
        title "Reserve stock"
        metadata
            x_message
                seq "2"
        endpoints
            item
                definition
                    id "ddn.examples.communication::flow.checkout"
            item
                definition
                    id "ddn.examples.communication::flow.inventory"


relation "ddn.examples.communication::flow.reserve_stock_reply" as "uml.message"
    with
        id "ddn.examples.communication::flow.reserve_stock_reply"
        title "Stock reserved"
        metadata
            x_return true
            x_message
                seq "2.1"
        endpoints
            item
                definition
                    id "ddn.examples.communication::flow.inventory"
            item
                definition
                    id "ddn.examples.communication::flow.checkout"


relation "ddn.examples.communication::flow.audit_log" as "uml.message"
    with
        id "ddn.examples.communication::flow.audit_log"
        title "Audit log"
        metadata
            x_message
                seq "3"
        endpoints
            item
                definition
                    id "ddn.examples.communication::flow.checkout"
            item
                definition
                    id "ddn.examples.communication::flow.checkout"


relation "ddn.examples.communication::flow.confirm" as "uml.message"
    with
        id "ddn.examples.communication::flow.confirm"
        title "Confirm order"
        metadata
            x_message
                seq "4"
        endpoints
            item
                definition
                    id "ddn.examples.communication::flow.checkout"
            item
                definition
                    id "ddn.examples.communication::flow.customer_app"


view "communication" as "uml.communication@1"
    with
        id "communication"
        title "Synthetic order flow / communication"
        selection
            include
                item
                    id "ddn.examples.communication::flow.customer_app"
                item
                    id "ddn.examples.communication::flow.checkout"
                item
                    id "ddn.examples.communication::flow.inventory"
                item
                    id "ddn.examples.communication::flow.submit_order"
                item
                    id "ddn.examples.communication::flow.reserve_stock"
                item
                    id "ddn.examples.communication::flow.reserve_stock_reply"
                item
                    id "ddn.examples.communication::flow.audit_log"
                item
                    id "ddn.examples.communication::flow.confirm"
        layout
            algorithm "layered"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        publication
            id "publication:communication"

    use "ddn.examples.communication::flow.customer_app" named "appearance:communication:ddn.examples.communication::flow.customer_app"
        with
            id "appearance:communication:ddn.examples.communication::flow.customer_app"

    use "ddn.examples.communication::flow.checkout" named "appearance:communication:ddn.examples.communication::flow.checkout"
        with
            id "appearance:communication:ddn.examples.communication::flow.checkout"

    use "ddn.examples.communication::flow.inventory" named "appearance:communication:ddn.examples.communication::flow.inventory"
        with
            id "appearance:communication:ddn.examples.communication::flow.inventory"

    use "ddn.examples.communication::flow.submit_order" named "appearance:communication:ddn.examples.communication::flow.submit_order"
        with
            id "appearance:communication:ddn.examples.communication::flow.submit_order"

    use "ddn.examples.communication::flow.reserve_stock" named "appearance:communication:ddn.examples.communication::flow.reserve_stock"
        with
            id "appearance:communication:ddn.examples.communication::flow.reserve_stock"

    use "ddn.examples.communication::flow.reserve_stock_reply" named "appearance:communication:ddn.examples.communication::flow.reserve_stock_reply"
        with
            id "appearance:communication:ddn.examples.communication::flow.reserve_stock_reply"

    use "ddn.examples.communication::flow.audit_log" named "appearance:communication:ddn.examples.communication::flow.audit_log"
        with
            id "appearance:communication:ddn.examples.communication::flow.audit_log"

    use "ddn.examples.communication::flow.confirm" named "appearance:communication:ddn.examples.communication::flow.confirm"
        with
            id "appearance:communication:ddn.examples.communication::flow.confirm"
