version ddn-next-1

publication "publication:fulfilment"
    with
        id "publication:fulfilment"
        title "Order fulfilment activity"
        targets
            item
                target
                    id "fulfilment"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.examples.activitydiagram::order.start" as "flow.start"
    with
        id "ddn.examples.activitydiagram::order.start"
        title "Start"
        metadata
            x_partition
                lane "ddn.examples.activitydiagram::fulfilment.webshop"


element "ddn.examples.activitydiagram::order.fork" as "flow.forkjoin"
    with
        id "ddn.examples.activitydiagram::order.fork"
        title "Fork"
        metadata
            x_partition
                lane "ddn.examples.activitydiagram::fulfilment.warehouse"


element "ddn.examples.activitydiagram::order.pick_items" as "flow.process"
    with
        id "ddn.examples.activitydiagram::order.pick_items"
        title "Pick items"
        metadata
            x_partition
                lane "ddn.examples.activitydiagram::fulfilment.warehouse"


element "ddn.examples.activitydiagram::order.take_payment" as "flow.process"
    with
        id "ddn.examples.activitydiagram::order.take_payment"
        title "Take payment"
        metadata
            x_partition
                lane "ddn.examples.activitydiagram::fulfilment.webshop"


element "ddn.examples.activitydiagram::order.order_obj" as "flow.objectnode"
    with
        id "ddn.examples.activitydiagram::order.order_obj"
        title "Order"
        metadata
            x_partition
                lane "ddn.examples.activitydiagram::fulfilment.warehouse"


element "ddn.examples.activitydiagram::order.join" as "flow.forkjoin"
    with
        id "ddn.examples.activitydiagram::order.join"
        title "Join"
        metadata
            x_partition
                lane "ddn.examples.activitydiagram::fulfilment.warehouse"


element "ddn.examples.activitydiagram::order.end" as "flow.end"
    with
        id "ddn.examples.activitydiagram::order.end"
        title "End"
        metadata
            x_partition
                lane "ddn.examples.activitydiagram::fulfilment.webshop"


relation "ddn.examples.activitydiagram::order.begin" as "uml.flow"
    with
        id "ddn.examples.activitydiagram::order.begin"
        title "begin"
        endpoints
            item
                definition
                    id "ddn.examples.activitydiagram::order.start"
            item
                definition
                    id "ddn.examples.activitydiagram::order.fork"


relation "ddn.examples.activitydiagram::order.to_pick" as "uml.flow"
    with
        id "ddn.examples.activitydiagram::order.to_pick"
        title "to pick"
        endpoints
            item
                definition
                    id "ddn.examples.activitydiagram::order.fork"
            item
                definition
                    id "ddn.examples.activitydiagram::order.pick_items"


relation "ddn.examples.activitydiagram::order.to_pay" as "uml.flow"
    with
        id "ddn.examples.activitydiagram::order.to_pay"
        title "to pay"
        endpoints
            item
                definition
                    id "ddn.examples.activitydiagram::order.fork"
            item
                definition
                    id "ddn.examples.activitydiagram::order.take_payment"


relation "ddn.examples.activitydiagram::order.to_order" as "uml.flow"
    with
        id "ddn.examples.activitydiagram::order.to_order"
        title "to order"
        endpoints
            item
                definition
                    id "ddn.examples.activitydiagram::order.fork"
            item
                definition
                    id "ddn.examples.activitydiagram::order.order_obj"


relation "ddn.examples.activitydiagram::order.picked" as "uml.flow"
    with
        id "ddn.examples.activitydiagram::order.picked"
        title "picked"
        endpoints
            item
                definition
                    id "ddn.examples.activitydiagram::order.pick_items"
            item
                definition
                    id "ddn.examples.activitydiagram::order.join"


relation "ddn.examples.activitydiagram::order.paid" as "uml.flow"
    with
        id "ddn.examples.activitydiagram::order.paid"
        title "paid"
        endpoints
            item
                definition
                    id "ddn.examples.activitydiagram::order.take_payment"
            item
                definition
                    id "ddn.examples.activitydiagram::order.join"


relation "ddn.examples.activitydiagram::order.order_ready" as "uml.flow"
    with
        id "ddn.examples.activitydiagram::order.order_ready"
        title "order ready"
        endpoints
            item
                definition
                    id "ddn.examples.activitydiagram::order.order_obj"
            item
                definition
                    id "ddn.examples.activitydiagram::order.join"


relation "ddn.examples.activitydiagram::order.finish" as "uml.flow"
    with
        id "ddn.examples.activitydiagram::order.finish"
        title "finish"
        endpoints
            item
                definition
                    id "ddn.examples.activitydiagram::order.join"
            item
                definition
                    id "ddn.examples.activitydiagram::order.end"


view "fulfilment" as "uml.activity@1"
    with
        id "fulfilment"
        title "Order fulfilment activity"
        selection
            include
                item
                    id "ddn.examples.activitydiagram::order.start"
                item
                    id "ddn.examples.activitydiagram::order.fork"
                item
                    id "ddn.examples.activitydiagram::order.pick_items"
                item
                    id "ddn.examples.activitydiagram::order.take_payment"
                item
                    id "ddn.examples.activitydiagram::order.order_obj"
                item
                    id "ddn.examples.activitydiagram::order.join"
                item
                    id "ddn.examples.activitydiagram::order.end"
                item
                    id "ddn.examples.activitydiagram::order.begin"
                item
                    id "ddn.examples.activitydiagram::order.to_pick"
                item
                    id "ddn.examples.activitydiagram::order.to_pay"
                item
                    id "ddn.examples.activitydiagram::order.to_order"
                item
                    id "ddn.examples.activitydiagram::order.picked"
                item
                    id "ddn.examples.activitydiagram::order.paid"
                item
                    id "ddn.examples.activitydiagram::order.order_ready"
                item
                    id "ddn.examples.activitydiagram::order.finish"
        layout
            algorithm "layered"
            gap 112
            row_gap 112
        legend
            width 280
        background
            color "#f6f8fc"
        regions
            item
                id "ddn.examples.activitydiagram::fulfilment.webshop"
                name "Webshop"
                members
                    item
                        id "ddn.examples.activitydiagram::order.start"
                    item
                        id "ddn.examples.activitydiagram::order.take_payment"
                    item
                        id "ddn.examples.activitydiagram::order.end"
            item
                id "ddn.examples.activitydiagram::fulfilment.warehouse"
                name "Warehouse"
                members
                    item
                        id "ddn.examples.activitydiagram::order.fork"
                    item
                        id "ddn.examples.activitydiagram::order.pick_items"
                    item
                        id "ddn.examples.activitydiagram::order.order_obj"
                    item
                        id "ddn.examples.activitydiagram::order.join"
        publication
            id "publication:fulfilment"

    use "ddn.examples.activitydiagram::order.start" named "appearance:fulfilment:ddn.examples.activitydiagram::order.start"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.start"

    use "ddn.examples.activitydiagram::order.fork" named "appearance:fulfilment:ddn.examples.activitydiagram::order.fork"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.fork"

    use "ddn.examples.activitydiagram::order.pick_items" named "appearance:fulfilment:ddn.examples.activitydiagram::order.pick_items"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.pick_items"

    use "ddn.examples.activitydiagram::order.take_payment" named "appearance:fulfilment:ddn.examples.activitydiagram::order.take_payment"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.take_payment"

    use "ddn.examples.activitydiagram::order.order_obj" named "appearance:fulfilment:ddn.examples.activitydiagram::order.order_obj"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.order_obj"

    use "ddn.examples.activitydiagram::order.join" named "appearance:fulfilment:ddn.examples.activitydiagram::order.join"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.join"

    use "ddn.examples.activitydiagram::order.end" named "appearance:fulfilment:ddn.examples.activitydiagram::order.end"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.end"

    use "ddn.examples.activitydiagram::order.begin" named "appearance:fulfilment:ddn.examples.activitydiagram::order.begin"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.begin"

    use "ddn.examples.activitydiagram::order.to_pick" named "appearance:fulfilment:ddn.examples.activitydiagram::order.to_pick"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.to_pick"

    use "ddn.examples.activitydiagram::order.to_pay" named "appearance:fulfilment:ddn.examples.activitydiagram::order.to_pay"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.to_pay"

    use "ddn.examples.activitydiagram::order.to_order" named "appearance:fulfilment:ddn.examples.activitydiagram::order.to_order"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.to_order"

    use "ddn.examples.activitydiagram::order.picked" named "appearance:fulfilment:ddn.examples.activitydiagram::order.picked"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.picked"

    use "ddn.examples.activitydiagram::order.paid" named "appearance:fulfilment:ddn.examples.activitydiagram::order.paid"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.paid"

    use "ddn.examples.activitydiagram::order.order_ready" named "appearance:fulfilment:ddn.examples.activitydiagram::order.order_ready"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.order_ready"

    use "ddn.examples.activitydiagram::order.finish" named "appearance:fulfilment:ddn.examples.activitydiagram::order.finish"
        with
            id "appearance:fulfilment:ddn.examples.activitydiagram::order.finish"
