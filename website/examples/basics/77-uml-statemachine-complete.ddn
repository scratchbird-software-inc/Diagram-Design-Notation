    use "ddn.examples.umlsm::machine.active" named "appearance:composite:ddn.examples.umlsm::machine.active"
        with
            id "appearance:composite:ddn.examples.umlsm::machine.active"

    use "ddn.examples.umlsm::machine.hist" named "appearance:composite:ddn.examples.umlsm::machine.hist"
        with
            id "appearance:composite:ddn.examples.umlsm::machine.hist"

    use "ddn.examples.umlsm::machine.deep_hist" named "appearance:composite:ddn.examples.umlsm::machine.deep_hist"
        with
            id "appearance:composite:ddn.examples.umlsm::machine.deep_hist"

    use "ddn.examples.umlsm::machine.ep_in" named "appearance:composite:ddn.examples.umlsm::machine.ep_in"
        with
            id "appearance:composite:ddn.examples.umlsm::machine.ep_in"

    use "ddn.examples.umlsm::machine.ep_out" named "appearance:composite:ddn.examples.umlsm::machine.ep_out"
