                item
                    id "ddn.examples.umlsm::player.e9"
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        regions
            item
                id "ddn.examples.umlsm::composite.boundary"
                name "Active"
                scope
                    id "ddn.examples.umlsm::machine.active"
                members
                    item
                        id "ddn.examples.umlsm::machine.hist"
                    item
                        id "ddn.examples.umlsm::machine.deep_hist"
                    item
                        id "ddn.examples.umlsm::machine.ep_in"
                    item
                        id "ddn.examples.umlsm::machine.ep_out"
                    item
                        id "ddn.examples.umlsm::machine.ui_idle"
                    item
                        id "ddn.examples.umlsm::machine.ui_busy"
                    item
                        id "ddn.examples.umlsm::machine.net_idle"
                    item
                        id "ddn.examples.umlsm::machine.net_sync"
        publication
            id "publication:composite"

    use "ddn.examples.umlsm::machine.mstart" named "appearance:composite:ddn.examples.umlsm::machine.mstart"
        with
            id "appearance:composite:ddn.examples.umlsm::machine.mstart"

    use "ddn.examples.umlsm::machine.offline" named "appearance:composite:ddn.examples.umlsm::machine.offline"
