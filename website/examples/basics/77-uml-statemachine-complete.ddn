    use "ddn.examples.umlsm::player.done" named "appearance:pseudostates:ddn.examples.umlsm::player.done"
        with
            id "appearance:pseudostates:ddn.examples.umlsm::player.done"

    use "ddn.examples.umlsm::player.e1" named "appearance:pseudostates:ddn.examples.umlsm::player.e1"
        with
            id "appearance:pseudostates:ddn.examples.umlsm::player.e1"

    use "ddn.examples.umlsm::player.e2" named "appearance:pseudostates:ddn.examples.umlsm::player.e2"
        with
