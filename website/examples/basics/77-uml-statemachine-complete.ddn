version ddn-next-1

publication "publication:pseudostates"
    with
        id "publication:pseudostates"
        title "UML state machine / activities and pseudostates"
        targets
            item
                target
                    id "pseudostates"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:composite"
    with
        id "publication:composite"
        title "UML state machine / composite, history, submachine"
        targets
            item
                target
                    id "composite"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.umlsm::player.start" as "state.initial"
    with
        id "ddn.examples.umlsm::player.start"
        title "start"


element "ddn.examples.umlsm::player.stopped" as "state.state"
    with
        id "ddn.examples.umlsm::player.stopped"
        title "Stopped"


element "ddn.examples.umlsm::player.playing" as "state.state"
    with
        id "ddn.examples.umlsm::player.playing"
        title "Playing"
        metadata
            x_state
                entry "openDecoder()"
                exit "closeDecoder()"
                do "renderFrame()"
                internal
                    item "log [verbose] / writeMetric()"


element "ddn.examples.umlsm::player.choose_next" as "state.choice"
    with
        id "ddn.examples.umlsm::player.choose_next"
        title "choose_next"


element "ddn.examples.umlsm::player.wait_join" as "state.junction"
    with
        id "ddn.examples.umlsm::player.wait_join"
        title "wait_join"


element "ddn.examples.umlsm::player.sync" as "state.forkjoin"
    with
        id "ddn.examples.umlsm::player.sync"
        title "sync"


element "ddn.examples.umlsm::player.crashed" as "state.terminate"
    with
        id "ddn.examples.umlsm::player.crashed"
        title "crashed"


element "ddn.examples.umlsm::player.done" as "state.final"
    with
        id "ddn.examples.umlsm::player.done"
        title "done"


relation "ddn.examples.umlsm::player.e1" as "state.transition"
    with
        id "ddn.examples.umlsm::player.e1"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::player.start"
            item
                definition
                    id "ddn.examples.umlsm::player.stopped"


relation "ddn.examples.umlsm::player.e2" as "state.transition"
    with
        id "ddn.examples.umlsm::player.e2"
        title "play"
        metadata
            x_transition
                event "play"
                guard "mediaReady"
                effect "loadTrack()"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::player.stopped"
            item
                definition
                    id "ddn.examples.umlsm::player.playing"


relation "ddn.examples.umlsm::player.e3" as "state.transition"
    with
        id "ddn.examples.umlsm::player.e3"
        title "buffer"
        metadata
            x_transition
                event "bufferEmpty"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::player.playing"
            item
                definition
                    id "ddn.examples.umlsm::player.wait_join"


relation "ddn.examples.umlsm::player.e4" as "state.transition"
    with
        id "ddn.examples.umlsm::player.e4"
        title "Event transition"
        metadata
            x_transition
                event "bufferFull"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::player.wait_join"
            item
                definition
                    id "ddn.examples.umlsm::player.choose_next"


relation "ddn.examples.umlsm::player.e5" as "state.transition"
    with
        id "ddn.examples.umlsm::player.e5"
        title "next"
        metadata
            x_transition
                event "next"
                guard "hasNext"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::player.choose_next"
            item
                definition
                    id "ddn.examples.umlsm::player.playing"


relation "ddn.examples.umlsm::player.e6" as "state.transition"
    with
        id "ddn.examples.umlsm::player.e6"
        title "eject"
        metadata
            x_transition
                event "after(30s)"
                effect "eject()"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::player.choose_next"
            item
                definition
                    id "ddn.examples.umlsm::player.sync"


relation "ddn.examples.umlsm::player.e7" as "state.transition"
    with
        id "ddn.examples.umlsm::player.e7"
        title "Event transition"
        metadata
            x_transition
                event "when(drained)"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::player.sync"
            item
                definition
                    id "ddn.examples.umlsm::player.stopped"


relation "ddn.examples.umlsm::player.e8" as "state.transition"
    with
        id "ddn.examples.umlsm::player.e8"
        title "crash"
        metadata
            x_transition
                event "at(2027-01-01T00:00Z)"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::player.playing"
            item
                definition
                    id "ddn.examples.umlsm::player.crashed"


relation "ddn.examples.umlsm::player.e9" as "state.transition"
    with
        id "ddn.examples.umlsm::player.e9"
        title "stop"
        metadata
            x_transition
                event "stop"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::player.playing"
            item
                definition
                    id "ddn.examples.umlsm::player.done"


element "ddn.examples.umlsm::machine.mstart" as "state.initial"
    with
        id "ddn.examples.umlsm::machine.mstart"
        title "mstart"


element "ddn.examples.umlsm::machine.offline" as "state.state"
    with
        id "ddn.examples.umlsm::machine.offline"
        title "Offline"


element "ddn.examples.umlsm::machine.session" as "state.state"
    with
        id "ddn.examples.umlsm::machine.session"
        title "Session"
        metadata
            x_state
                submachine
                    id "ddn.examples.umlsm::machine.auth"


element "ddn.examples.umlsm::machine.auth" as "state.state"
    with
        id "ddn.examples.umlsm::machine.auth"
        title "Auth top"


element "ddn.examples.umlsm::machine.mstop" as "state.final"
    with
        id "ddn.examples.umlsm::machine.mstop"
        title "mstop"


element "ddn.examples.umlsm::machine.active" as "state.state"
    with
        id "ddn.examples.umlsm::machine.active"
        title "Active"


element "ddn.examples.umlsm::machine.hist" as "state.history_shallow"
    with
        id "ddn.examples.umlsm::machine.hist"
        title "hist"


element "ddn.examples.umlsm::machine.deep_hist" as "state.history_deep"
    with
        id "ddn.examples.umlsm::machine.deep_hist"
        title "deep_hist"


element "ddn.examples.umlsm::machine.ep_in" as "state.entrypoint"
    with
        id "ddn.examples.umlsm::machine.ep_in"
        title "ep_in"


element "ddn.examples.umlsm::machine.ep_out" as "state.exitpoint"
    with
        id "ddn.examples.umlsm::machine.ep_out"
        title "ep_out"


element "ddn.examples.umlsm::machine.ui_idle" as "state.state"
    with
        id "ddn.examples.umlsm::machine.ui_idle"
        title "UI idle"


element "ddn.examples.umlsm::machine.ui_busy" as "state.state"
    with
        id "ddn.examples.umlsm::machine.ui_busy"
        title "UI busy"


element "ddn.examples.umlsm::machine.net_idle" as "state.state"
    with
        id "ddn.examples.umlsm::machine.net_idle"
        title "Net idle"


element "ddn.examples.umlsm::machine.net_sync" as "state.state"
    with
        id "ddn.examples.umlsm::machine.net_sync"
        title "Net sync"


relation "ddn.examples.umlsm::machine.m1" as "state.transition"
    with
        id "ddn.examples.umlsm::machine.m1"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::machine.mstart"
            item
                definition
                    id "ddn.examples.umlsm::machine.offline"


relation "ddn.examples.umlsm::machine.m2" as "state.transition"
    with
        id "ddn.examples.umlsm::machine.m2"
        title "connect"
        metadata
            x_transition
                event "connect"
                effect "dial()"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::machine.offline"
            item
                definition
                    id "ddn.examples.umlsm::machine.ep_in"


relation "ddn.examples.umlsm::machine.m3" as "state.transition"
    with
        id "ddn.examples.umlsm::machine.m3"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::machine.ep_in"
            item
                definition
                    id "ddn.examples.umlsm::machine.ui_idle"


relation "ddn.examples.umlsm::machine.m4" as "state.transition"
    with
        id "ddn.examples.umlsm::machine.m4"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::machine.ep_in"
            item
                definition
                    id "ddn.examples.umlsm::machine.net_idle"


relation "ddn.examples.umlsm::machine.m5" as "state.transition"
    with
        id "ddn.examples.umlsm::machine.m5"
        title "work"
        metadata
            x_transition
                event "work"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::machine.ui_idle"
            item
                definition
                    id "ddn.examples.umlsm::machine.ui_busy"


relation "ddn.examples.umlsm::machine.m6" as "state.transition"
    with
        id "ddn.examples.umlsm::machine.m6"
        title "Event transition"
        metadata
            x_transition
                event "suspend"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::machine.ui_busy"
            item
                definition
                    id "ddn.examples.umlsm::machine.hist"


relation "ddn.examples.umlsm::machine.m7" as "state.transition"
    with
        id "ddn.examples.umlsm::machine.m7"
        title "Event transition"
        metadata
            x_transition
                event "resume"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::machine.hist"
            item
                definition
                    id "ddn.examples.umlsm::machine.ui_idle"


relation "ddn.examples.umlsm::machine.m8" as "state.transition"
    with
        id "ddn.examples.umlsm::machine.m8"
        title "Event transition"
        metadata
            x_transition
                event "after(5s)"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::machine.net_idle"
            item
                definition
                    id "ddn.examples.umlsm::machine.net_sync"


relation "ddn.examples.umlsm::machine.m9" as "state.transition"
    with
        id "ddn.examples.umlsm::machine.m9"
        title "Event transition"
        metadata
            x_transition
                event "suspend"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::machine.net_sync"
            item
                definition
                    id "ddn.examples.umlsm::machine.deep_hist"


relation "ddn.examples.umlsm::machine.m10" as "state.transition"
    with
        id "ddn.examples.umlsm::machine.m10"
        title "Event transition"
        metadata
            x_transition
                event "when(queue empty)"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::machine.ui_busy"
            item
                definition
                    id "ddn.examples.umlsm::machine.ep_out"


relation "ddn.examples.umlsm::machine.m11" as "state.transition"
    with
        id "ddn.examples.umlsm::machine.m11"
        title "Event transition"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::machine.ep_out"
            item
                definition
                    id "ddn.examples.umlsm::machine.session"


relation "ddn.examples.umlsm::machine.m12" as "state.transition"
    with
        id "ddn.examples.umlsm::machine.m12"
        title "logout"
        metadata
            x_transition
                event "logout"
        endpoints
            item
                definition
                    id "ddn.examples.umlsm::machine.session"
            item
                definition
                    id "ddn.examples.umlsm::machine.mstop"


view "pseudostates" as "uml.statemachine@1"
    with
        id "pseudostates"
        title "UML state machine / activities and pseudostates"
        selection
            include
                item
                    id "ddn.examples.umlsm::player.start"
                item
                    id "ddn.examples.umlsm::player.stopped"
                item
                    id "ddn.examples.umlsm::player.playing"
                item
                    id "ddn.examples.umlsm::player.choose_next"
                item
                    id "ddn.examples.umlsm::player.wait_join"
                item
                    id "ddn.examples.umlsm::player.sync"
                item
                    id "ddn.examples.umlsm::player.crashed"
                item
                    id "ddn.examples.umlsm::player.done"
                item
                    id "ddn.examples.umlsm::player.e1"
                item
                    id "ddn.examples.umlsm::player.e2"
                item
                    id "ddn.examples.umlsm::player.e3"
                item
                    id "ddn.examples.umlsm::player.e4"
                item
                    id "ddn.examples.umlsm::player.e5"
                item
                    id "ddn.examples.umlsm::player.e6"
                item
                    id "ddn.examples.umlsm::player.e7"
                item
                    id "ddn.examples.umlsm::player.e8"
                item
                    id "ddn.examples.umlsm::player.e9"
            exclude
                item
                    id "ddn.examples.umlsm::machine.m1"
                item
                    id "ddn.examples.umlsm::machine.m2"
                item
                    id "ddn.examples.umlsm::machine.m3"
                item
                    id "ddn.examples.umlsm::machine.m4"
                item
                    id "ddn.examples.umlsm::machine.m5"
                item
                    id "ddn.examples.umlsm::machine.m6"
                item
                    id "ddn.examples.umlsm::machine.m7"
                item
                    id "ddn.examples.umlsm::machine.m8"
                item
                    id "ddn.examples.umlsm::machine.m9"
                item
                    id "ddn.examples.umlsm::machine.m10"
                item
                    id "ddn.examples.umlsm::machine.m11"
                item
                    id "ddn.examples.umlsm::machine.m12"
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        publication
            id "publication:pseudostates"

    use "ddn.examples.umlsm::player.start" named "appearance:pseudostates:ddn.examples.umlsm::player.start"
        with
            id "appearance:pseudostates:ddn.examples.umlsm::player.start"

    use "ddn.examples.umlsm::player.stopped" named "appearance:pseudostates:ddn.examples.umlsm::player.stopped"
        with
            id "appearance:pseudostates:ddn.examples.umlsm::player.stopped"

    use "ddn.examples.umlsm::player.playing" named "appearance:pseudostates:ddn.examples.umlsm::player.playing"
