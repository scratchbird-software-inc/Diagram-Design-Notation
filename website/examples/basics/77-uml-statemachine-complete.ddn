                    id "ddn.examples.umlsm::machine.m1"
                item
                    id "ddn.examples.umlsm::machine.m2"
                item
                    id "ddn.examples.umlsm::machine.m3"
                item
                    id "ddn.examples.umlsm::machine.m4"
                item
                    id "ddn.examples.umlsm::machine.m5"
                item
