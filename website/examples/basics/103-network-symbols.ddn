ddn "0.5";
module "ddn.examples.networksymbols";

// B1-087: the network-generic@1 icon library — generic infrastructure
// glyphs (no vendor packs; licensing diligence pending). The library binds
// by default to the network.* kinds (bus→cloud, switch→switch,
// server→server, rack→database); everything else binds per node via
// x_icon. Common-practice rendering — compliance against the standard
// pending document review. All data is synthetic.
data m {
    object wan "Internet" { kind: "network.bus"; }
    object fw "Edge firewall" { kind: "network.server"; x_icon: { library: "network-generic@1", icon: "firewall" }; }
    object lb "Load balancer" { kind: "network.server"; x_icon: { library: "network-generic@1", icon: "load-balancer" }; }
    object rtr "Core router" { kind: "network.server"; x_icon: { library: "network-generic@1", icon: "router" }; }
    object sw "Access switch" { kind: "network.switch"; }
    object app "App server" { kind: "network.server"; }
    object db "Database" { kind: "network.rack"; }
    object ap "Wi-Fi AP" { kind: "network.server"; x_icon: { library: "network-generic@1", icon: "wifi-ap" }; }
    object ws "Workstation" { kind: "network.server"; x_icon: { library: "network-generic@1", icon: "workstation" }; }
    object prn "Printer" { kind: "network.server"; x_icon: { library: "network-generic@1", icon: "printer" }; }
    object lan "Site LAN" { kind: "network.bus"; }
    relation a1 "" @fw -> @wan { kind: "network.attaches"; }
    relation a2 "" @rtr -> @wan { kind: "network.attaches"; }
    relation a3 "" @rtr -> @lan { kind: "network.attaches"; }
    relation a4 "" @lb -> @lan { kind: "network.attaches"; }
    relation a5 "" @sw -> @lan { kind: "network.attaches"; }
    relation a6 "" @app -> @lan { kind: "network.attaches"; }
    relation a7 "" @db -> @lan { kind: "network.attaches"; }
    relation a8 "" @ap -> @lan { kind: "network.attaches"; }
    relation a9 "" @ws -> @lan { kind: "network.attaches"; }
    relation a10 "" @prn -> @lan { kind: "network.attaches"; }
}
view net "Network symbol library" {
    data: [@m];
    projection { profile: "network.basic@1"; }
    publication { size: content; fit: none; }
}
