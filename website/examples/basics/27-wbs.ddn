version ddn-next-1

publication "publication:wbs"
    with
        id "publication:wbs"
        title "Synthetic project / work breakdown structure"
        targets
            item
                target
                    id "wbs"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.examples.wbs::plan.project" as "analysis.task"
    with
        id "ddn.examples.wbs::plan.project"
        title "Website relaunch (synthetic)"


