version ddn-next-1

publication "publication:arch"
    with
        id "publication:arch"
        title "Retail service architecture"
        targets
            item
                target
                    id "arch"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:choreography"
    with
        id "publication:choreography"
        title "Billing choreography"
        targets
            item
                target
                    id "choreography"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.soaml::m.shop.billing" as "core::Port"
    with
        id "ddn.examples.soaml::m.shop.billing"
        title "billing"
        properties
            datatype "Billing"
        metadata
            x_service
                kind "request"
        content
            owner
                id "ddn.examples.soaml::m.shop"
            direction "output"


