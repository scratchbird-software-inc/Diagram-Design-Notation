ddn "0.5";
module "ddn.examples.soaml";

// B1-072: SoaML 1.0.1 — a retail service architecture with a service
// contract. Participants offer «Service» and consume through «Request» port
// decorations; the assembly connector pairs a «Request» with a «Service»
// port of the same interface type. The service contract is a collaboration
// glyph with provider/consumer role rows and a choreography binding to the
// sequence view below. All data is synthetic.

data m {
    object shop "Shop front" { kind: "soaml.participant";
        ports { billing { direction: out; x_service: { kind: "request" }; datatype: "Billing"; } }
    }
    object warehouse "Warehouse" { kind: "soaml.participant";
        ports { stock { direction: out; x_service: { kind: "request" }; datatype: "Billing"; } }
    }
    object billing "Billing service" { kind: "soaml.serviceinterface";
        fields { charge "charge(order)"; invoice "issue(invoice)"; }
        ports { api { direction: in; x_service: { kind: "service" }; datatype: "Billing"; } }
    }
    object org "Retail group" { kind: "soaml.agent"; }
    object cap "Online retail" { kind: "soaml.capability"; }
    object msg "Invoice" { kind: "soaml.message"; }
    object ms "Payment received" { kind: "soaml.milestone"; }
    object contract "Billing terms" { kind: "soaml.servicecontract";
        fields {
            provider { x_part: { classifier: "Billing" }; }
            consumer { x_part: { classifier: "Shop" }; }
        }
        x_contract: { choreography: @choreography };
    }

    relation a1 "" @shop.billing -> @billing.api { kind: "uml.assembly"; }
    relation a2 "" @warehouse.stock -> @billing.api { kind: "uml.assembly"; }
    relation realize "" @billing -> @cap { kind: "uml.realization"; }
    relation offers "" @contract -> @billing { kind: "uml.provided"; }
    relation doc "" @billing -> @msg { kind: "uml.dependency"; }
    relation done "" @contract -> @ms { kind: "uml.dependency"; }
    relation owns "" @org -> @shop { kind: "uml.connector"; }
}

data choreo {
    object shopper "Shop" { kind: "uml.class"; }
    object biller "Billing" { kind: "uml.class"; }
    relation m1 "charge(order)" @shopper -> @biller { kind: "uml.message"; }
    relation m2 "invoice" @biller -> @shopper { kind: "uml.message"; x_message: { sort: "reply" }; }
}

view arch "Retail service architecture": [@m] as "soaml.services@1" {
    layout { algorithm: layered; }
    publication { size: content; fit: none; }
}

view choreography "Billing choreography": [@choreo] as "uml.sequence@2" {
    publication { size: content; fit: none; }
}
