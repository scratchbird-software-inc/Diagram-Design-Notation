view "arch" as "soaml.services@1"
    with
        id "arch"
        title "Retail service architecture"
        selection
            include
                item
                    id "ddn.examples.soaml::m.shop"
                item
                    id "ddn.examples.soaml::m.warehouse"
                item
                    id "ddn.examples.soaml::m.billing"
                item
                    id "ddn.examples.soaml::m.org"
                item
                    id "ddn.examples.soaml::m.cap"
                item
                    id "ddn.examples.soaml::m.msg"
                item
                    id "ddn.examples.soaml::m.ms"
                item
                    id "ddn.examples.soaml::m.contract"
                item
                    id "ddn.examples.soaml::m.a1"
                item
                    id "ddn.examples.soaml::m.a2"
                item
                    id "ddn.examples.soaml::m.realize"
                item
                    id "ddn.examples.soaml::m.offers"
                item
                    id "ddn.examples.soaml::m.doc"
                item
                    id "ddn.examples.soaml::m.done"
                item
                    id "ddn.examples.soaml::m.owns"
            exclude
                item
                    id "ddn.examples.soaml::choreo.m1"
                item
                    id "ddn.examples.soaml::choreo.m2"
        layout
            algorithm "layered"
            gap 112
            row_gap 112
        background
            color "#f6f8fc"
        publication
            id "publication:arch"

    use "ddn.examples.soaml::m.shop" named "appearance:arch:ddn.examples.soaml::m.shop"
        with
            id "appearance:arch:ddn.examples.soaml::m.shop"

    use "ddn.examples.soaml::m.warehouse" named "appearance:arch:ddn.examples.soaml::m.warehouse"
        with
            id "appearance:arch:ddn.examples.soaml::m.warehouse"

    use "ddn.examples.soaml::m.billing" named "appearance:arch:ddn.examples.soaml::m.billing"
        with
            id "appearance:arch:ddn.examples.soaml::m.billing"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.soaml::m.org" named "appearance:arch:ddn.examples.soaml::m.org"
        with
            id "appearance:arch:ddn.examples.soaml::m.org"

    use "ddn.examples.soaml::m.cap" named "appearance:arch:ddn.examples.soaml::m.cap"
        with
            id "appearance:arch:ddn.examples.soaml::m.cap"

    use "ddn.examples.soaml::m.msg" named "appearance:arch:ddn.examples.soaml::m.msg"
        with
            id "appearance:arch:ddn.examples.soaml::m.msg"

    use "ddn.examples.soaml::m.ms" named "appearance:arch:ddn.examples.soaml::m.ms"
        with
            id "appearance:arch:ddn.examples.soaml::m.ms"

    use "ddn.examples.soaml::m.contract" named "appearance:arch:ddn.examples.soaml::m.contract"
        with
            id "appearance:arch:ddn.examples.soaml::m.contract"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.soaml::m.a1" named "appearance:arch:ddn.examples.soaml::m.a1"
        with
            id "appearance:arch:ddn.examples.soaml::m.a1"

    use "ddn.examples.soaml::m.a2" named "appearance:arch:ddn.examples.soaml::m.a2"
        with
            id "appearance:arch:ddn.examples.soaml::m.a2"

    use "ddn.examples.soaml::m.realize" named "appearance:arch:ddn.examples.soaml::m.realize"
        with
            id "appearance:arch:ddn.examples.soaml::m.realize"

    use "ddn.examples.soaml::m.offers" named "appearance:arch:ddn.examples.soaml::m.offers"
        with
            id "appearance:arch:ddn.examples.soaml::m.offers"

    use "ddn.examples.soaml::m.doc" named "appearance:arch:ddn.examples.soaml::m.doc"
        with
            id "appearance:arch:ddn.examples.soaml::m.doc"

    use "ddn.examples.soaml::m.done" named "appearance:arch:ddn.examples.soaml::m.done"
        with
            id "appearance:arch:ddn.examples.soaml::m.done"

    use "ddn.examples.soaml::m.owns" named "appearance:arch:ddn.examples.soaml::m.owns"
        with
            id "appearance:arch:ddn.examples.soaml::m.owns"


view "choreography" as "uml.sequence@2"
    with
        id "choreography"
        title "Billing choreography"
        selection
            include
                item
                    id "ddn.examples.soaml::choreo.shopper"
                item
                    id "ddn.examples.soaml::choreo.biller"
                item
                    id "ddn.examples.soaml::choreo.m1"
                item
                    id "ddn.examples.soaml::choreo.m2"
            exclude
                item
                    id "ddn.examples.soaml::m.a1"
                item
                    id "ddn.examples.soaml::m.a2"
                item
                    id "ddn.examples.soaml::m.realize"
                item
                    id "ddn.examples.soaml::m.offers"
                item
                    id "ddn.examples.soaml::m.doc"
                item
                    id "ddn.examples.soaml::m.done"
                item
                    id "ddn.examples.soaml::m.owns"
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        publication
            id "publication:choreography"

    use "ddn.examples.soaml::choreo.shopper" named "appearance:choreography:ddn.examples.soaml::choreo.shopper"
        with
            id "appearance:choreography:ddn.examples.soaml::choreo.shopper"

    use "ddn.examples.soaml::choreo.biller" named "appearance:choreography:ddn.examples.soaml::choreo.biller"
        with
            id "appearance:choreography:ddn.examples.soaml::choreo.biller"

    use "ddn.examples.soaml::choreo.m1" named "appearance:choreography:ddn.examples.soaml::choreo.m1"
        with
            id "appearance:choreography:ddn.examples.soaml::choreo.m1"

    use "ddn.examples.soaml::choreo.m2" named "appearance:choreography:ddn.examples.soaml::choreo.m2"
        with
            id "appearance:choreography:ddn.examples.soaml::choreo.m2"
