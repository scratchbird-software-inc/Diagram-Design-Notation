version ddn-next-1

publication "publication:v"
    with
        id "publication:v"
        title "Case"
        targets
            item
                target
                    id "v"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.cmmn::c.plan" as "cmmn.caseplan"
    with
        id "ddn.examples.cmmn::c.plan"
        title "Claim case"


element "ddn.examples.cmmn::c.intake" as "cmmn.stage"
    with
        id "ddn.examples.cmmn::c.intake"
        title "Intake"


element "ddn.examples.cmmn::c.review" as "cmmn.humantask"
    with
        id "ddn.examples.cmmn::c.review"
        title "Review claim"
        metadata
            x_cmmn
                manual_activation true
        notes
            item
                title "Additional source metadata"
                text
                    {
                      "x_cmmn": {
                        "required": true,
                        "manual_activation": true
                      }
                    }
                format "plain"


element "ddn.examples.cmmn::c.appr" as "cmmn.humantask"
    with
        id "ddn.examples.cmmn::c.appr"
        title "Approve"
        metadata
            x_cmmn
                discretionary true
            x_planning
                items
                    item "Senior review"
                    item "Legal opinion"


element "ddn.examples.cmmn::c.decide" as "cmmn.decisiontask"
    with
        id "ddn.examples.cmmn::c.decide"
        title "Fraud check"


element "ddn.examples.cmmn::c.notify" as "cmmn.processtask"
    with
        id "ddn.examples.cmmn::c.notify"
        title "Notify customer"
        metadata
            x_cmmn
                repetition true


element "ddn.examples.cmmn::c.pay" as "cmmn.task"
    with
        id "ddn.examples.cmmn::c.pay"
        title "Pay out"
        metadata
            x_cmmn
                completion true


element "ddn.examples.cmmn::c.close" as "cmmn.milestone"
    with
        id "ddn.examples.cmmn::c.close"
        title "Closed"


element "ddn.examples.cmmn::c.docs" as "cmmn.casefile"
    with
        id "ddn.examples.cmmn::c.docs"
        title "Documents"


element "ddn.examples.cmmn::c.deadline" as "cmmn.timerevent"
    with
        id "ddn.examples.cmmn::c.deadline"
        title "deadline"


element "ddn.examples.cmmn::c.customer" as "cmmn.userevent"
    with
        id "ddn.examples.cmmn::c.customer"
        title "customer"


element "ddn.examples.cmmn::c.s1" as "cmmn.sentry"
    with
        id "ddn.examples.cmmn::c.s1"
        title "s1"
        metadata
            x_sentry
                on "entry"
                attach
                    id "ddn.examples.cmmn::c.review"
                on_part
                    id "ddn.examples.cmmn::c.deadline"
                if_part "deadline passed"


relation "ddn.examples.cmmn::c.d1" as "cmmn.dependency"
    with
        id "ddn.examples.cmmn::c.d1"
        title "Dependency"
        endpoints
            item
                definition
                    id "ddn.examples.cmmn::c.review"
            item
                definition
                    id "ddn.examples.cmmn::c.appr"


relation "ddn.examples.cmmn::c.d2" as "cmmn.dependency"
    with
        id "ddn.examples.cmmn::c.d2"
        title "Dependency"
        endpoints
            item
                definition
                    id "ddn.examples.cmmn::c.decide"
            item
                definition
                    id "ddn.examples.cmmn::c.review"


relation "ddn.examples.cmmn::c.d3" as "cmmn.dependency"
    with
        id "ddn.examples.cmmn::c.d3"
        title "Dependency"
        endpoints
            item
                definition
                    id "ddn.examples.cmmn::c.review"
            item
                definition
                    id "ddn.examples.cmmn::c.notify"


relation "ddn.examples.cmmn::c.d4" as "cmmn.dependency"
    with
        id "ddn.examples.cmmn::c.d4"
        title "Dependency"
        endpoints
            item
                definition
                    id "ddn.examples.cmmn::c.notify"
            item
                definition
                    id "ddn.examples.cmmn::c.pay"


relation "ddn.examples.cmmn::c.d5" as "cmmn.dependency"
    with
        id "ddn.examples.cmmn::c.d5"
        title "Dependency"
        endpoints
            item
                definition
                    id "ddn.examples.cmmn::c.pay"
            item
                definition
                    id "ddn.examples.cmmn::c.close"


relation "ddn.examples.cmmn::c.sr1" as "cmmn.sentryref"
    with
        id "ddn.examples.cmmn::c.sr1"
        title "Sentry on-part"
        endpoints
            item
                definition
                    id "ddn.examples.cmmn::c.deadline"
            item
                definition
                    id "ddn.examples.cmmn::c.s1"


relation "ddn.examples.cmmn::c.sr2" as "cmmn.sentryref"
    with
        id "ddn.examples.cmmn::c.sr2"
        title "Sentry on-part"
        endpoints
            item
                definition
                    id "ddn.examples.cmmn::c.customer"
            item
                definition
                    id "ddn.examples.cmmn::c.s1"


view "v" as "cmmn.complete@1"
    with
        id "v"
        title "Case"
        selection
            include
                item
                    id "ddn.examples.cmmn::c.plan"
                item
                    id "ddn.examples.cmmn::c.intake"
                item
                    id "ddn.examples.cmmn::c.review"
                item
                    id "ddn.examples.cmmn::c.appr"
                item
                    id "ddn.examples.cmmn::c.decide"
                item
                    id "ddn.examples.cmmn::c.notify"
                item
                    id "ddn.examples.cmmn::c.pay"
                item
                    id "ddn.examples.cmmn::c.close"
                item
                    id "ddn.examples.cmmn::c.docs"
                item
                    id "ddn.examples.cmmn::c.deadline"
                item
                    id "ddn.examples.cmmn::c.customer"
                item
                    id "ddn.examples.cmmn::c.s1"
                item
                    id "ddn.examples.cmmn::c.d1"
                item
                    id "ddn.examples.cmmn::c.d2"
                item
                    id "ddn.examples.cmmn::c.d3"
                item
                    id "ddn.examples.cmmn::c.d4"
                item
                    id "ddn.examples.cmmn::c.d5"
                item
                    id "ddn.examples.cmmn::c.sr1"
                item
                    id "ddn.examples.cmmn::c.sr2"
        layout
            center "pins"
            gap 112
            row_gap 112
            algorithm "auto"
        background
            color "#f6f8fc"
        regions
            item
                id "ddn.examples.cmmn::v.intake_f"
                name "Intake"
                scope
                    id "ddn.examples.cmmn::c.intake"
                members
                    item
                        id "ddn.examples.cmmn::c.review"
                    item
                        id "ddn.examples.cmmn::c.appr"
                    item
                        id "ddn.examples.cmmn::c.decide"
                    item
                        id "ddn.examples.cmmn::c.s1"
        publication
            id "publication:v"

    use "ddn.examples.cmmn::c.plan" named "appearance:v:ddn.examples.cmmn::c.plan"
        with
            id "appearance:v:ddn.examples.cmmn::c.plan"

    use "ddn.examples.cmmn::c.intake" named "appearance:v:ddn.examples.cmmn::c.intake"
        with
            id "appearance:v:ddn.examples.cmmn::c.intake"

    use "ddn.examples.cmmn::c.review" named "appearance:v:ddn.examples.cmmn::c.review"
        with
            id "appearance:v:ddn.examples.cmmn::c.review"

    use "ddn.examples.cmmn::c.appr" named "appearance:v:ddn.examples.cmmn::c.appr"
        with
            id "appearance:v:ddn.examples.cmmn::c.appr"

    use "ddn.examples.cmmn::c.decide" named "appearance:v:ddn.examples.cmmn::c.decide"
        with
            id "appearance:v:ddn.examples.cmmn::c.decide"

    use "ddn.examples.cmmn::c.notify" named "appearance:v:ddn.examples.cmmn::c.notify"
        with
            id "appearance:v:ddn.examples.cmmn::c.notify"

    use "ddn.examples.cmmn::c.pay" named "appearance:v:ddn.examples.cmmn::c.pay"
        with
            id "appearance:v:ddn.examples.cmmn::c.pay"

    use "ddn.examples.cmmn::c.close" named "appearance:v:ddn.examples.cmmn::c.close"
        with
            id "appearance:v:ddn.examples.cmmn::c.close"

    use "ddn.examples.cmmn::c.docs" named "appearance:v:ddn.examples.cmmn::c.docs"
        with
            id "appearance:v:ddn.examples.cmmn::c.docs"

    use "ddn.examples.cmmn::c.deadline" named "appearance:v:ddn.examples.cmmn::c.deadline"
        with
            id "appearance:v:ddn.examples.cmmn::c.deadline"

    use "ddn.examples.cmmn::c.customer" named "appearance:v:ddn.examples.cmmn::c.customer"
        with
            id "appearance:v:ddn.examples.cmmn::c.customer"

    use "ddn.examples.cmmn::c.s1" named "appearance:v:ddn.examples.cmmn::c.s1"
        with
            id "appearance:v:ddn.examples.cmmn::c.s1"

    use "ddn.examples.cmmn::c.d1" named "appearance:v:ddn.examples.cmmn::c.d1"
        with
            id "appearance:v:ddn.examples.cmmn::c.d1"

    use "ddn.examples.cmmn::c.d2" named "appearance:v:ddn.examples.cmmn::c.d2"
        with
            id "appearance:v:ddn.examples.cmmn::c.d2"

    use "ddn.examples.cmmn::c.d3" named "appearance:v:ddn.examples.cmmn::c.d3"
        with
            id "appearance:v:ddn.examples.cmmn::c.d3"

    use "ddn.examples.cmmn::c.d4" named "appearance:v:ddn.examples.cmmn::c.d4"
        with
            id "appearance:v:ddn.examples.cmmn::c.d4"

    use "ddn.examples.cmmn::c.d5" named "appearance:v:ddn.examples.cmmn::c.d5"
        with
            id "appearance:v:ddn.examples.cmmn::c.d5"

    use "ddn.examples.cmmn::c.sr1" named "appearance:v:ddn.examples.cmmn::c.sr1"
        with
            id "appearance:v:ddn.examples.cmmn::c.sr1"

    use "ddn.examples.cmmn::c.sr2" named "appearance:v:ddn.examples.cmmn::c.sr2"
        with
            id "appearance:v:ddn.examples.cmmn::c.sr2"
