view "grid" as "ddn@1"
    with
        id "grid"
        title "Native grid / no coordinates"
        selection
            include
                item
                    id "ddn.examples.native-layouts::model.enterprise"
                item
                    id "ddn.examples.native-layouts::model.finance"
                item
                    id "ddn.examples.native-layouts::model.plant"
                item
                    id "ddn.examples.native-layouts::model.journal"
                item
                    id "ddn.examples.native-layouts::model.stock"
                item
                    id "ddn.examples.native-layouts::model.analytics"
                item
                    id "ddn.examples.native-layouts::model.f1"
                item
                    id "ddn.examples.native-layouts::model.f2"
                item
                    id "ddn.examples.native-layouts::model.f3"
                item
                    id "ddn.examples.native-layouts::model.f4"
                item
                    id "ddn.examples.native-layouts::model.f5"
        layout
            algorithm "grid"
            gap 112
            row_gap 112
        legend
            mode "numbers"
            width 330
            keys
                f1 "1"
                f2 "2"
                f3 "3"
                f4 "4"
                f5 "5"
        background
            color "#f6f8fc"
        publication
            id "publication:grid"

    use "ddn.examples.native-layouts::model.enterprise" named "appearance:grid:ddn.examples.native-layouts::model.enterprise"
        with
            id "appearance:grid:ddn.examples.native-layouts::model.enterprise"

    use "ddn.examples.native-layouts::model.finance" named "appearance:grid:ddn.examples.native-layouts::model.finance"
