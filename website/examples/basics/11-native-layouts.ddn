version ddn-next-1

publication "publication:grid"
    with
        id "publication:grid"
        title "Native grid / no coordinates"
        targets
            item
                target
                    id "grid"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


