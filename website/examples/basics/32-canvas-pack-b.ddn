element "ddn.examples.canvas-pack-b::scan.pest_political" as "note"
    with
        id "ddn.examples.canvas-pack-b::scan.pest_political"
        title "Political"
        description "Synthetic: Aurelia's stable coalition government is drafting a sugar-tax bill affecting soft drinks."
        content
            text "Synthetic: Aurelia's stable coalition government is drafting a sugar-tax bill affecting soft drinks."
        draft
            text "Synthetic: Aurelia's stable coalition government is drafting a sugar-tax bill affecting soft drinks."


