version ddn-next-1

publication "publication:pest"
    with
        id "publication:pest"
        title "Fizzberry in Aurelia / PEST scan"
        targets
            item
                target
                    id "pest"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


