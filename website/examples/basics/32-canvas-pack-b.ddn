view "pest" as "canvas.pest@1"
    with
        id "pest"
        title "Fizzberry in Aurelia / PEST scan"
        selection
            include empty list
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        projection
            options
                columns 4
                panels
                    item
                        target
                            id "pest::panel::political"
                        kind "text"
                        title "POLITICAL"
                    item
                        target
                            id "pest::panel::economic"
                        kind "text"
                        title "ECONOMIC"
                    item
                        target
                            id "pest::panel::social"
                        kind "text"
                        title "SOCIAL"
                    item
                        target
                            id "pest::panel::technological"
                        kind "text"
                        title "TECHNOLOGICAL"


