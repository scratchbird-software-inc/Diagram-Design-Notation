version ddn-next-1

publication "publication:bmc"
    with
        id "publication:bmc"
        title "Coffee cart / business model canvas"
        targets
            item
                target
                    id "bmc"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


publication "publication:lean"
    with
        id "publication:lean"
        title "Coffee cart / lean canvas"
        targets
            item
                target
                    id "lean"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
