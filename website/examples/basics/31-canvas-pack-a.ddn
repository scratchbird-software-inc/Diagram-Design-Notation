view "bmc" as "canvas.bmc@1"
    with
        id "bmc"
        title "Coffee cart / business model canvas"
        selection
            include empty list
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        projection
            options
                columns 10
                panels
                    item
                        target
                            id "bmc::panel::kp"
                        kind "text"
                        title "KEY PARTNERS"
                    item
                        target
                            id "bmc::panel::ka"
                        kind "text"
                        title "KEY ACTIVITIES"
                    item
                        target
                            id "bmc::panel::kr"
                        kind "text"
                        title "KEY RESOURCES"
                    item
                        target
                            id "bmc::panel::vp"
                        kind "text"
                        title "VALUE PROPOSITIONS"
                    item
                        target
                            id "bmc::panel::cr"
                        kind "text"
                        title "CUSTOMER RELATIONSHIPS"
                    item
                        target
                            id "bmc::panel::ch"
                        kind "text"
                        title "CHANNELS"
                    item
                        target
                            id "bmc::panel::cs"
                        kind "text"
                        title "CUSTOMER SEGMENTS"
                    item
                        target
                            id "bmc::panel::cost"
                        kind "text"
                        title "COST STRUCTURE"
                    item
                        target
                            id "bmc::panel::rev"
                        kind "text"
                        title "REVENUE STREAMS"


