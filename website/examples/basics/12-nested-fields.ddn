view "detailed" as "ddn@1"
    with
        id "detailed"
        title "Nested fields / domains and representations"
        selection
            include
                item
                    id "ddn.examples.nested::model.order"
                item
                    id "ddn.examples.nested::model.customer"
                item
                    id "ddn.examples.nested::model.postal"
                item
                    id "ddn.examples.nested::model.owner"
                item
                    id "ddn.examples.nested::model.address_note"
            exclude
                item
                    id "ddn.examples.nested::model.id_match"
        layout
            algorithm "layered"
            gap 80
        display
            domains "show"
            datatypes "show"
            depth 8
        legend
            mode "numbers"
            width 280
            keys
                owner "7"
                address_note "12"
        background
            color "#f6f8fc"
        publication
            id "publication:detailed"

    use "ddn.examples.nested::model.order" named "appearance:detailed:ddn.examples.nested::model.order"
        with
            id "appearance:detailed:ddn.examples.nested::model.order"
            body "columns"
            column_visibility
                field "shown"
                type "shown"
                domain "shown"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.nested::model.customer" named "appearance:detailed:ddn.examples.nested::model.customer"
        with
            id "appearance:detailed:ddn.examples.nested::model.customer"
            body "columns"
            column_visibility
                field "shown"
                type "shown"
                domain "shown"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.nested::model.postal" named "appearance:detailed:ddn.examples.nested::model.postal"
        with
            id "appearance:detailed:ddn.examples.nested::model.postal"
            body "notes"

    use "ddn.examples.nested::model.owner" named "appearance:detailed:ddn.examples.nested::model.owner"
        with
            id "appearance:detailed:ddn.examples.nested::model.owner"

    use "ddn.examples.nested::model.address_note" named "appearance:detailed:ddn.examples.nested::model.address_note"
        with
            id "appearance:detailed:ddn.examples.nested::model.address_note"


