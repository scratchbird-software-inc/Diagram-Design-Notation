relation "ddn.examples.nested::model.owner" as "ref"
    with
        id "ddn.examples.nested::model.owner"
        title "references"
        properties
            source_mark "one"
            target_mark "one"
        endpoints
            item
                definition
                    id "ddn.examples.nested::model.order"
                member
                    id "ddn.examples.nested::model.order.customer_id"
            item
                definition
                    id "ddn.examples.nested::model.customer"
                member
                    id "ddn.examples.nested::model.customer.customer_id"


relation "ddn.examples.nested::model.address_note" as "candidate"
    with
        id "ddn.examples.nested::model.address_note"
        title "candidate domain match"
        endpoints
            item
                definition
                    id "ddn.examples.nested::model.customer"
                member
                    id "ddn.examples.nested::model.customer.address.postal_code"
            item
                definition
                    id "ddn.examples.nested::model.postal"


relation "ddn.examples.nested::model.id_match" as "candidate"
    with
        id "ddn.examples.nested::model.id_match"
        title "candidate domain match"
        endpoints
            item
                definition
                    id "ddn.examples.nested::model.order"
                member
                    id "ddn.examples.nested::model.order.customer_id"
            item
                definition
                    id "ddn.examples.nested::model.identifier"


