element "ddn.examples.nested::model.identifier" as "domain"
    with
        id "ddn.examples.nested::model.identifier"
        title "Customer identifier"
        content
            meaning "Opaque identifier within the customer registry"
        notes
            item
                title "Additional source details"
                text
                    {
                      "meaning": "Opaque identifier within the customer registry"
                    }
                format "plain"


element "ddn.examples.nested::model.postal" as "domain"
