view "metrics_chart" as "chart.basic@1"
    with
        id "metrics_chart"
        title "Order timings / keyed tabular records"
        selection
            include empty list
            exclude
                item
                    id "ddn.examples.nested::model.owner"
                item
                    id "ddn.examples.nested::model.address_note"
                item
                    id "ddn.examples.nested::model.id_match"
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.nested::metrics.m1"
                    item
                        id "ddn.examples.nested::metrics.m2"
                    item
                        id "ddn.examples.nested::metrics.m3"
                    item
                        id "ddn.examples.nested::metrics.m4"
                mark "bar"
                x "metadata.x_record.label"
                y "metadata.x_record.value"
                unit "ms"
                width 900
                height 560
