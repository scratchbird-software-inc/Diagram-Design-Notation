            datatype "string"
            key "primary"
            nullable false
        content
            parent
                id "ddn.examples.nested::model.customer"
            ordinal 0
            datatype "string"
            domain
                id "ddn.examples.nested::model.identifier"
            key "primary"
            nullable false
        notes
