version ddn-next-1

publication "publication:errorbars"
    with
        id "publication:errorbars"
        title "Stage timings with measurement error / bar + error bars"
        targets
            item
                target
                    id "errorbars"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:regression"
    with
        id "publication:regression"
        title "Payload vs latency / point + least-squares trend"
        targets
            item
                target
                    id "regression"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:loess"
    with
        id "publication:loess"
        title "Payload vs latency / point + loess trend"
        targets
            item
                target
                    id "loess"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.chart-overlays::bench.b1" as "record"
    with
        id "ddn.examples.chart-overlays::bench.b1"
        title "parser"
        metadata
            x_record
                stage "parser"
                ms 18
                err 2.5
                unit "ms"


