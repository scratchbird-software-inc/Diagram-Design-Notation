ddn "0.5";
module "ddn.examples.chart-overlays";

// Synthetic bench results: mean render times with measurement error bars, and
// a payload/latency scatter with regression and loess trend overlays.
// All data is synthetic.
records bench {
    columns: stage, ms, err, unit;
    label_column: stage;
    row b1: "parser", 18, 2.5, "ms";
    row b2: "layout", 42, 5, "ms";
    row b3: "routing", 31, 4, "ms";
    row b4: "render", 55, 6.5, "ms";
    row b5: "export", 12, 1.5, "ms";
}

data samples {
    record s1 "p1" {x_record: {"kb": 8, "ms": 24}; }
    record s2 "p2" {x_record: {"kb": 15, "ms": 31}; }
    record s3 "p3" {x_record: {"kb": 22, "ms": 39}; }
    record s4 "p4" {x_record: {"kb": 30, "ms": 44}; }
    record s5 "p5" {x_record: {"kb": 38, "ms": 58}; }
    record s6 "p6" {x_record: {"kb": 47, "ms": 61}; }
    record s7 "p7" {x_record: {"kb": 55, "ms": 79}; }
    record s8 "p8" {x_record: {"kb": 64, "ms": 82}; }
    record s9 "p9" {x_record: {"kb": 72, "ms": 97}; }
    record s10 "p10" {x_record: {"kb": 81, "ms": 103}; }
    record s11 "p11" {x_record: {"kb": 90, "ms": 118}; }
    record s12 "p12" {x_record: {"kb": 99, "ms": 121}; }
}

view errorbars "Stage timings with measurement error / bar + error bars" {
    data: [@bench];
    projection { kind:chart; profile:"chart.basic@1"; records:[@bench.b1, @bench.b2, @bench.b3, @bench.b4, @bench.b5]; mark:bar; x:"x_record.stage"; y:"x_record.ms"; error:"x_record.err"; unit:"ms"; width:1120px; height:620px; }
    publication { size: content; fit: none; }
}

view regression "Payload vs latency / point + least-squares trend" {
    data: [@samples];
    projection { kind:chart; profile:"chart.basic@1"; records:[@samples.s1, @samples.s2, @samples.s3, @samples.s4, @samples.s5, @samples.s6, @samples.s7, @samples.s8, @samples.s9, @samples.s10, @samples.s11, @samples.s12]; mark:point; x:"x_record.kb"; x_type:number; y:"x_record.ms"; trend:linear; width:1120px; height:620px; }
    publication { size: content; fit: none; }
}

view loess "Payload vs latency / point + loess trend" {
    data: [@samples];
    projection { kind:chart; profile:"chart.basic@1"; records:[@samples.s1, @samples.s2, @samples.s3, @samples.s4, @samples.s5, @samples.s6, @samples.s7, @samples.s8, @samples.s9, @samples.s10, @samples.s11, @samples.s12]; mark:point; x:"x_record.kb"; x_type:number; y:"x_record.ms"; trend:loess; width:1120px; height:620px; }
    publication { size: content; fit: none; }
}
