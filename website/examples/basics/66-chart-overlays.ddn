view "errorbars" as "chart.basic@1"
    with
        id "errorbars"
        title "Stage timings with measurement error / bar + error bars"
        selection
            include empty list
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.chart-overlays::bench.b1"
                    item
                        id "ddn.examples.chart-overlays::bench.b2"
                    item
                        id "ddn.examples.chart-overlays::bench.b3"
                    item
                        id "ddn.examples.chart-overlays::bench.b4"
                    item
                        id "ddn.examples.chart-overlays::bench.b5"
                mark "bar"
                x "metadata.x_record.stage"
                y "metadata.x_record.ms"
                error
                    value "metadata.x_record.err"
                unit "ms"
                width 1120
                height 620


view "regression" as "chart.basic@1"
    with
        id "regression"
        title "Payload vs latency / point + least-squares trend"
        selection
            include empty list
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.chart-overlays::samples.s1"
                    item
                        id "ddn.examples.chart-overlays::samples.s2"
                    item
                        id "ddn.examples.chart-overlays::samples.s3"
                    item
                        id "ddn.examples.chart-overlays::samples.s4"
                    item
                        id "ddn.examples.chart-overlays::samples.s5"
                    item
                        id "ddn.examples.chart-overlays::samples.s6"
                    item
                        id "ddn.examples.chart-overlays::samples.s7"
                    item
                        id "ddn.examples.chart-overlays::samples.s8"
                    item
                        id "ddn.examples.chart-overlays::samples.s9"
                    item
                        id "ddn.examples.chart-overlays::samples.s10"
                    item
                        id "ddn.examples.chart-overlays::samples.s11"
                    item
                        id "ddn.examples.chart-overlays::samples.s12"
                mark "point"
                x "metadata.x_record.kb"
                x_type "number"
                y "metadata.x_record.ms"
                trend "linear"
                width 1120
                height 620


view "loess" as "chart.basic@1"
    with
        id "loess"
        title "Payload vs latency / point + loess trend"
        selection
            include empty list
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.chart-overlays::samples.s1"
                    item
                        id "ddn.examples.chart-overlays::samples.s2"
                    item
                        id "ddn.examples.chart-overlays::samples.s3"
                    item
                        id "ddn.examples.chart-overlays::samples.s4"
                    item
                        id "ddn.examples.chart-overlays::samples.s5"
                    item
                        id "ddn.examples.chart-overlays::samples.s6"
                    item
                        id "ddn.examples.chart-overlays::samples.s7"
                    item
                        id "ddn.examples.chart-overlays::samples.s8"
                    item
                        id "ddn.examples.chart-overlays::samples.s9"
                    item
                        id "ddn.examples.chart-overlays::samples.s10"
                    item
                        id "ddn.examples.chart-overlays::samples.s11"
                    item
                        id "ddn.examples.chart-overlays::samples.s12"
                mark "point"
                x "metadata.x_record.kb"
                x_type "number"
                y "metadata.x_record.ms"
                trend
                    method "loess"
                    show true
                width 1120
                height 620
