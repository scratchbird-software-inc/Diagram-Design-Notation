    use "ddn.examples.sysmlreq::reqs.alloc" named "appearance:requirements:ddn.examples.sysmlreq::reqs.alloc"
        with
            id "appearance:requirements:ddn.examples.sysmlreq::reqs.alloc"


view "packages" as "sysml.package@1"
    with
        id "packages"
        title "Model packages"
        selection
            include
                item
                    id "ddn.examples.sysmlreq::pkgs.plant"
                item
                    id "ddn.examples.sysmlreq::pkgs.pumps"
                item
                    id "ddn.examples.sysmlreq::pkgs.safety"
                item
                    id "ddn.examples.sysmlreq::pkgs.imp"
                item
                    id "ddn.examples.sysmlreq::pkgs.mrg"
                item
                    id "ddn.examples.sysmlreq::pkgs.acc"
            exclude
                item
                    id "ddn.examples.sysmlreq::reqs.derive"
                item
                    id "ddn.examples.sysmlreq::reqs.satisfy"
                item
                    id "ddn.examples.sysmlreq::reqs.satisfy2"
                item
                    id "ddn.examples.sysmlreq::reqs.verify"
                item
                    id "ddn.examples.sysmlreq::reqs.refine"
                item
                    id "ddn.examples.sysmlreq::reqs.trace"
                item
                    id "ddn.examples.sysmlreq::reqs.copy"
                item
                    id "ddn.examples.sysmlreq::reqs.master"
                item
                    id "ddn.examples.sysmlreq::reqs.contains"
                item
                    id "ddn.examples.sysmlreq::reqs.alloc"
        layout
            algorithm "layered"
            gap 112
            row_gap 112
        background
            color "#f6f8fc"
        publication
            id "publication:packages"

    use "ddn.examples.sysmlreq::pkgs.plant" named "appearance:packages:ddn.examples.sysmlreq::pkgs.plant"
        with
            id "appearance:packages:ddn.examples.sysmlreq::pkgs.plant"

    use "ddn.examples.sysmlreq::pkgs.pumps" named "appearance:packages:ddn.examples.sysmlreq::pkgs.pumps"
