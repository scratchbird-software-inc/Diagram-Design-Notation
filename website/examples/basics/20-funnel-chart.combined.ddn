ddn "0.5";

module "ddn.examples.funnel-chart";
// Synthetic sales-pipeline dataset: five funnel stages, one value per stage.
// All data is synthetic.
records pipeline {
    columns: stage, value, unit;
    label_column: stage;
    row s1: "Visits", 1200, "deals";
    row s2: "Signups", 480, "deals";
    row s3: "Trials", 210, "deals";
    row s4: "Qualified", 96, "deals";
    row s5: "Closed", 42, "deals";
}

view funnel "Synthetic sales pipeline / funnel" {
    data: [@pipeline]; format: @ddn.examples.shared.styles.technical;
    projection { kind:chart; profile:"chart.funnel@1"; records:[@pipeline.s1, @pipeline.s2, @pipeline.s3, @pipeline.s4, @pipeline.s5]; mark:funnel; x:"x_record.stage"; y:"x_record.value"; unit:"deals"; width:1120px; height:620px; }
    publication { size: content; fit: none; overflow: error; minimum_text: 8pt; }
}

module "ddn.examples.shared";
format styles {
    notation core;
    style classic;
    style hand { look: handDrawn; font: handwriting; roughness: 1.8; hachure: true; }
    style neo { look: neo; }
    style dark { theme: dark; }
    style neutral { theme: neutral; font: mono; }
    style forest { look: handDrawn; theme: forest; font: handwriting; roughness: 1.8; hachure: true; }
    layout wires { algorithm: grid; gap: 80px; }
    display detailed;
    display compact { fields: none; maturity: none; badges: none; }
    publication screen { size: content; width: 1360px; height: 860px; margin: 30px; overflow: warn; }
    publication paper { size: a4; orientation: landscape; margin: 8mm; minimum_text: 7pt; overflow: warn; }
    legend words { width: 280px; }
    legend numbers { mode: numbers; width: 280px; }
    bundle technical {
        notation: @core;
        style: @classic;
        layout: @wires;
        display: @detailed;
        publication: @screen;
        legend: @words;
    }
}
