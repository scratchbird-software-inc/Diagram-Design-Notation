view "histogram" as "chart.histogram@1"
    with
        id "histogram"
        title "Response times / histogram"
        selection
            include empty list
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.distribution-charts::latency.a1"
                    item
                        id "ddn.examples.distribution-charts::latency.a2"
                    item
                        id "ddn.examples.distribution-charts::latency.a3"
