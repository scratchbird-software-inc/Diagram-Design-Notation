version ddn-next-1

publication "publication:histogram"
    with
        id "publication:histogram"
        title "Response times / histogram"
        targets
            item
                target
                    id "histogram"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


