                    item
                        id "ddn.examples.distribution-charts::latency.b6"
                    item
                        id "ddn.examples.distribution-charts::latency.b7"
                    item
                        id "ddn.examples.distribution-charts::latency.b8"
                    item
                        id "ddn.examples.distribution-charts::latency.b9"
                    item
                        id "ddn.examples.distribution-charts::latency.b10"
                    item
                        id "ddn.examples.distribution-charts::latency.c1"
                    item
                        id "ddn.examples.distribution-charts::latency.c2"
                    item
                        id "ddn.examples.distribution-charts::latency.c3"
                    item
                        id "ddn.examples.distribution-charts::latency.c4"
                    item
                        id "ddn.examples.distribution-charts::latency.c5"
                    item
                        id "ddn.examples.distribution-charts::latency.c6"
                    item
                        id "ddn.examples.distribution-charts::latency.c7"
                    item
                        id "ddn.examples.distribution-charts::latency.c8"
