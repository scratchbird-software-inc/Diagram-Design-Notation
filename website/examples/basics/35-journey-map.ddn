version ddn-next-1

publication "publication:returns"
    with
        id "publication:returns"
        title "Returns journey / synthetic"
        targets
            item
                target
                    id "returns"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


element "ddn.examples.journey-map::journey.ph_receive" as "note"
    with
        id "ddn.examples.journey-map::journey.ph_receive"
        title "Receive phase"
        description "Synthetic phase goal: the customer sends the unwanted item back with minimal effort."
        content
            text "Synthetic phase goal: the customer sends the unwanted item back with minimal effort."
        draft
            text "Synthetic phase goal: the customer sends the unwanted item back with minimal effort."


element "ddn.examples.journey-map::journey.ph_inspect" as "note"
    with
        id "ddn.examples.journey-map::journey.ph_inspect"
        title "Inspect phase"
        description "Synthetic phase goal: the returned item is checked and triaged quickly."
        content
            text "Synthetic phase goal: the returned item is checked and triaged quickly."
        draft
            text "Synthetic phase goal: the returned item is checked and triaged quickly."


element "ddn.examples.journey-map::journey.ph_decide" as "note"
    with
        id "ddn.examples.journey-map::journey.ph_decide"
        title "Decide phase"
        description "Synthetic phase goal: a fair refund-or-replace decision is made transparently."
        content
            text "Synthetic phase goal: a fair refund-or-replace decision is made transparently."
        draft
            text "Synthetic phase goal: a fair refund-or-replace decision is made transparently."


element "ddn.examples.journey-map::journey.ph_refund" as "note"
    with
        id "ddn.examples.journey-map::journey.ph_refund"
        title "Refund phase"
        description "Synthetic phase goal: money or a replacement reaches the customer without chasing."
        content
            text "Synthetic phase goal: money or a replacement reaches the customer without chasing."
        draft
            text "Synthetic phase goal: money or a replacement reaches the customer without chasing."


element "ddn.examples.journey-map::journey.act_receive" as "note"
    with
        id "ddn.examples.journey-map::journey.act_receive"
        title "Action / receive"
        description "Synthetic: customer prints the prepaid label and drops the parcel at a corner shop."
        content
            text "Synthetic: customer prints the prepaid label and drops the parcel at a corner shop."
        draft
            text "Synthetic: customer prints the prepaid label and drops the parcel at a corner shop."


element "ddn.examples.journey-map::journey.act_inspect" as "note"
    with
        id "ddn.examples.journey-map::journey.act_inspect"
        title "Action / inspect"
        description "Synthetic: customer waits while the warehouse scans and grades the returned item."
        content
            text "Synthetic: customer waits while the warehouse scans and grades the returned item."
        draft
            text "Synthetic: customer waits while the warehouse scans and grades the returned item."


element "ddn.examples.journey-map::journey.act_decide" as "note"
    with
        id "ddn.examples.journey-map::journey.act_decide"
        title "Action / decide"
        description "Synthetic: customer reads the decision email and accepts the proposed refund."
        content
            text "Synthetic: customer reads the decision email and accepts the proposed refund."
        draft
            text "Synthetic: customer reads the decision email and accepts the proposed refund."


element "ddn.examples.journey-map::journey.act_refund" as "note"
    with
        id "ddn.examples.journey-map::journey.act_refund"
        title "Action / refund"
        description "Synthetic: customer sees the refund land on the original card and archives the receipt."
        content
            text "Synthetic: customer sees the refund land on the original card and archives the receipt."
        draft
            text "Synthetic: customer sees the refund land on the original card and archives the receipt."


element "ddn.examples.journey-map::journey.tp_receive" as "note"
    with
        id "ddn.examples.journey-map::journey.tp_receive"
        title "Touchpoint / receive"
        description "Synthetic: returns portal with order lookup and a QR code for the drop-off point."
        content
            text "Synthetic: returns portal with order lookup and a QR code for the drop-off point."
        draft
            text "Synthetic: returns portal with order lookup and a QR code for the drop-off point."


element "ddn.examples.journey-map::journey.tp_inspect" as "note"
    with
        id "ddn.examples.journey-map::journey.tp_inspect"
        title "Touchpoint / inspect"
        description "Synthetic: tracking page shows the parcel arrived and inspection has started."
        content
            text "Synthetic: tracking page shows the parcel arrived and inspection has started."
        draft
            text "Synthetic: tracking page shows the parcel arrived and inspection has started."


element "ddn.examples.journey-map::journey.tp_decide" as "note"
    with
        id "ddn.examples.journey-map::journey.tp_decide"
        title "Touchpoint / decide"
        description "Synthetic: decision email explains the outcome with photos from the inspection."
        content
            text "Synthetic: decision email explains the outcome with photos from the inspection."
        draft
            text "Synthetic: decision email explains the outcome with photos from the inspection."


element "ddn.examples.journey-map::journey.tp_refund" as "note"
    with
        id "ddn.examples.journey-map::journey.tp_refund"
        title "Touchpoint / refund"
        description "Synthetic: bank statement line and a closing confirmation message in the portal."
        content
            text "Synthetic: bank statement line and a closing confirmation message in the portal."
        draft
            text "Synthetic: bank statement line and a closing confirmation message in the portal."


element "ddn.examples.journey-map::journey.opp_receive" as "note"
    with
        id "ddn.examples.journey-map::journey.opp_receive"
        title "Opportunity / receive"
        description "Synthetic opportunity: prefill the returns form from the order history to cut retyping."
        content
            text "Synthetic opportunity: prefill the returns form from the order history to cut retyping."
        draft
            text "Synthetic opportunity: prefill the returns form from the order history to cut retyping."


element "ddn.examples.journey-map::journey.opp_inspect" as "note"
    with
        id "ddn.examples.journey-map::journey.opp_inspect"
        title "Opportunity / inspect"
        description "Synthetic opportunity: publish typical inspection times so waiting feels predictable."
        content
            text "Synthetic opportunity: publish typical inspection times so waiting feels predictable."
        draft
            text "Synthetic opportunity: publish typical inspection times so waiting feels predictable."


element "ddn.examples.journey-map::journey.opp_decide" as "note"
    with
        id "ddn.examples.journey-map::journey.opp_decide"
        title "Opportunity / decide"
        description "Synthetic opportunity: offer a one-click appeal path when a refund is declined."
        content
            text "Synthetic opportunity: offer a one-click appeal path when a refund is declined."
        draft
            text "Synthetic opportunity: offer a one-click appeal path when a refund is declined."


element "ddn.examples.journey-map::journey.opp_refund" as "note"
    with
        id "ddn.examples.journey-map::journey.opp_refund"
        title "Opportunity / refund"
        description "Synthetic opportunity: instant refund to wallet instead of a five-day card settlement."
        content
            text "Synthetic opportunity: instant refund to wallet instead of a five-day card settlement."
        draft
            text "Synthetic opportunity: instant refund to wallet instead of a five-day card settlement."


element "ddn.examples.journey-map::journey.em_receive" as "record"
    with
        id "ddn.examples.journey-map::journey.em_receive"
        title "Emotion / receive"
        metadata
            x_record
                phase "receive"
                value 2
                description "Synthetic: annoyed that the item failed, mildly relieved the return label was easy."


element "ddn.examples.journey-map::journey.em_inspect" as "record"
    with
        id "ddn.examples.journey-map::journey.em_inspect"
        title "Emotion / inspect"
        metadata
            x_record
                phase "inspect"
                value 3
                description "Synthetic: neutral while waiting, reassured by the visible tracking updates."


element "ddn.examples.journey-map::journey.em_decide" as "record"
    with
        id "ddn.examples.journey-map::journey.em_decide"
        title "Emotion / decide"
        metadata
            x_record
                phase "decide"
                value 4
                description "Synthetic: pleased the decision arrived with clear evidence and no argument."


element "ddn.examples.journey-map::journey.em_refund" as "record"
    with
        id "ddn.examples.journey-map::journey.em_refund"
        title "Emotion / refund"
        metadata
            x_record
                phase "refund"
                value 5
                description "Synthetic: delighted the refund landed ahead of the promised date."


element "returns::panel::phase-receive" as "note"
    with
        id "returns::panel::phase-receive"
        title "RECEIVE"
        metadata
            x_record
                id "phase-receive"
                row 0
                column 0
                rowspan 1
                colspan 1
                items
                    item
                        id "ddn.examples.journey-map::journey.ph_receive"


