view "returns" as "panels.journey@1"
    with
        id "returns"
        title "Returns journey / synthetic"
        selection
            include empty list
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        projection
            options
                columns 4
                panels
                    item
                        target
                            id "returns::panel::phase-receive"
                        kind "text"
                        title "RECEIVE"
                    item
                        target
                            id "returns::panel::phase-inspect"
                        kind "text"
                        title "INSPECT"
                    item
                        target
                            id "returns::panel::phase-decide"
                        kind "text"
                        title "DECIDE"
                    item
                        target
                            id "returns::panel::phase-refund"
                        kind "text"
                        title "REFUND"
                    item
                        target
                            id "returns::panel::actions-receive"
                        kind "text"
                        title "ACTIONS"
                    item
                        target
                            id "returns::panel::actions-inspect"
                        kind "text"
                        title "ACTIONS"
                    item
                        target
                            id "returns::panel::actions-decide"
                        kind "text"
                        title "ACTIONS"
                    item
                        target
                            id "returns::panel::actions-refund"
                        kind "text"
                        title "ACTIONS"
                    item
                        target
                            id "returns::panel::touchpoints-receive"
                        kind "text"
                        title "TOUCHPOINTS"
                    item
                        target
                            id "returns::panel::touchpoints-inspect"
                        kind "text"
                        title "TOUCHPOINTS"
                    item
                        target
                            id "returns::panel::touchpoints-decide"
                        kind "text"
                        title "TOUCHPOINTS"
                    item
                        target
                            id "returns::panel::touchpoints-refund"
                        kind "text"
                        title "TOUCHPOINTS"
                    item
                        target
                            id "returns::panel::opportunities-receive"
                        kind "text"
                        title "OPPORTUNITIES"
                    item
                        target
                            id "returns::panel::opportunities-inspect"
                        kind "text"
                        title "OPPORTUNITIES"
                    item
                        target
                            id "returns::panel::opportunities-decide"
                        kind "text"
                        title "OPPORTUNITIES"
                    item
                        target
                            id "returns::panel::opportunities-refund"
                        kind "text"
                        title "OPPORTUNITIES"
                    item
                        target
                            id "returns::panel::emotions"
                        kind "text"
                        title "EMOTIONS (1..5)"
