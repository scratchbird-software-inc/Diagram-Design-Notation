        metadata
            x_record
                id "emotions"
                row 4
                column 0
                rowspan 1
                colspan 4
                items
                    item
                        id "ddn.examples.journey-map::journey.em_receive"
                    item
                        id "ddn.examples.journey-map::journey.em_inspect"
                    item
                        id "ddn.examples.journey-map::journey.em_decide"
