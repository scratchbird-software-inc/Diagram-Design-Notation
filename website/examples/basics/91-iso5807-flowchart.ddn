version ddn-next-1

publication "publication:chart"
    with
        id "publication:chart"
        title "ISO 5807 warehouse flow"
        targets
            item
                target
                    id "chart"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.iso5807::m.start" as "flow.start"
    with
        id "ddn.examples.iso5807::m.start"
        title "start"


element "ddn.examples.iso5807::m.manual" as "flow.manualinput"
    with
        id "ddn.examples.iso5807::m.manual"
        title "Enter shelf counts"


element "ddn.examples.iso5807::m.prep" as "flow.preparation"
    with
        id "ddn.examples.iso5807::m.prep"
        title "Load picking rules"


element "ddn.examples.iso5807::m.op" as "flow.manualop"
    with
        id "ddn.examples.iso5807::m.op"
        title "Pick by hand"


element "ddn.examples.iso5807::m.disp" as "flow.display"
    with
        id "ddn.examples.iso5807::m.disp"
        title "Show tote ID"


element "ddn.examples.iso5807::m.wait" as "flow.delay"
    with
        id "ddn.examples.iso5807::m.wait"
        title "Cure time"


element "ddn.examples.iso5807::m.loopstart" as "flow.loopstart"
    with
        id "ddn.examples.iso5807::m.loopstart"
        title "For each tote"


element "ddn.examples.iso5807::m.card" as "flow.card"
    with
        id "ddn.examples.iso5807::m.card"
        title "Read card"


element "ddn.examples.iso5807::m.coll" as "flow.collate"
    with
        id "ddn.examples.iso5807::m.coll"
        title "Collate lines"


element "ddn.examples.iso5807::m.sort" as "flow.sort"
    with
        id "ddn.examples.iso5807::m.sort"
        title "Sort by bin"


element "ddn.examples.iso5807::m.mrg" as "flow.isomerge"
    with
        id "ddn.examples.iso5807::m.mrg"
        title "mrg"


element "ddn.examples.iso5807::m.xtr" as "flow.isoextract"
    with
        id "ddn.examples.iso5807::m.xtr"
        title "xtr"


element "ddn.examples.iso5807::m.par" as "flow.parallelmode"
    with
        id "ddn.examples.iso5807::m.par"
        title "Parallel packing"


element "ddn.examples.iso5807::m.loopend" as "flow.loopend"
    with
        id "ddn.examples.iso5807::m.loopend"
        title "Next tote"


element "ddn.examples.iso5807::m.fin" as "flow.end"
    with
        id "ddn.examples.iso5807::m.fin"
        title "fin"


relation "ddn.examples.iso5807::m.f1" as "flow.next"
    with
        id "ddn.examples.iso5807::m.f1"
        title "Control passes to"
        endpoints
            item
                definition
                    id "ddn.examples.iso5807::m.start"
            item
                definition
                    id "ddn.examples.iso5807::m.manual"


