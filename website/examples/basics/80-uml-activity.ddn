version ddn-next-1

publication "publication:pins"
    with
        id "publication:pins"
        title "UML activity / pins, decision and merge"
        targets
            item
                target
                    id "pins"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:interrupts"
    with
        id "publication:interrupts"
        title "UML activity / signals, interrupts, exceptions"
        targets
            item
                target
                    id "interrupts"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.umlact::fulfil.start" as "flow.start"
    with
        id "ddn.examples.umlact::fulfil.start"
        title "start"


element "ddn.examples.umlact::fulfil.take.order_in" as "core::Port"
    with
        id "ddn.examples.umlact::fulfil.take.order_in"
        title "order_in"
        metadata
            x_pin
                set "request"
        content
            owner
                id "ddn.examples.umlact::fulfil.take"
            direction "input"


element "ddn.examples.umlact::fulfil.take.order_out" as "core::Port"
    with
        id "ddn.examples.umlact::fulfil.take.order_out"
        title "order_out"
        metadata
            x_pin
                streaming true
        content
            owner
                id "ddn.examples.umlact::fulfil.take"
            direction "output"


element "ddn.examples.umlact::fulfil.take" as "flow.process"
    with
        id "ddn.examples.umlact::fulfil.take"
        title "Take order"
        members
            item
                id "ddn.examples.umlact::fulfil.take.order_in"
            item
                id "ddn.examples.umlact::fulfil.take.order_out"


element "ddn.examples.umlact::fulfil.dec" as "flow.decision"
    with
        id "ddn.examples.umlact::fulfil.dec"
        title "dec"


element "ddn.examples.umlact::fulfil.mrg" as "flow.merge"
    with
        id "ddn.examples.umlact::fulfil.mrg"
        title "mrg"


element "ddn.examples.umlact::fulfil.pack" as "flow.process"
    with
        id "ddn.examples.umlact::fulfil.pack"
        title "Pack"


element "ddn.examples.umlact::fulfil.ship" as "flow.process"
    with
        id "ddn.examples.umlact::fulfil.ship"
        title "Ship"


element "ddn.examples.umlact::fulfil.ffin" as "flow.flowfinal"
    with
        id "ddn.examples.umlact::fulfil.ffin"
        title "ffin"


element "ddn.examples.umlact::fulfil.fin" as "flow.end"
    with
        id "ddn.examples.umlact::fulfil.fin"
        title "fin"


relation "ddn.examples.umlact::fulfil.e1" as "uml.flow"
    with
        id "ddn.examples.umlact::fulfil.e1"
        title "Activity edge"
        endpoints
            item
                definition
                    id "ddn.examples.umlact::fulfil.start"
            item
                definition
                    id "ddn.examples.umlact::fulfil.take"
                member
                    id "ddn.examples.umlact::fulfil.take.order_in"


relation "ddn.examples.umlact::fulfil.e2" as "uml.flow"
    with
        id "ddn.examples.umlact::fulfil.e2"
        title "Activity edge"
        endpoints
            item
                definition
                    id "ddn.examples.umlact::fulfil.take"
                member
                    id "ddn.examples.umlact::fulfil.take.order_out"
            item
                definition
                    id "ddn.examples.umlact::fulfil.dec"


relation "ddn.examples.umlact::fulfil.e3" as "uml.flow"
    with
        id "ddn.examples.umlact::fulfil.e3"
        title "in stock"
        metadata
