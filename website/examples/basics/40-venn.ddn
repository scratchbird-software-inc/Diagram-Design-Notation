version ddn-next-1

publication "publication:overlap"
    with
        id "publication:overlap"
        title "Feature overlap / venn"
        targets
            item
                target
                    id "overlap"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666
            overflow "report"


element "ddn.examples.venn::features.f_offline" as "note"
    with
        id "ddn.examples.venn::features.f_offline"
        title "Offline sync"
        description "Synthetic: works without connectivity."
        metadata
            x_sets
                item "atlas"
        content
            text "Synthetic: works without connectivity."
        draft
            text "Synthetic: works without connectivity."


element "ddn.examples.venn::features.f_sso" as "note"
    with
        id "ddn.examples.venn::features.f_sso"
        title "SSO login"
        description "Synthetic: single sign-on for teams."
        metadata
            x_sets
                item "beacon"
        content
            text "Synthetic: single sign-on for teams."
        draft
            text "Synthetic: single sign-on for teams."


element "ddn.examples.venn::features.f_sdk" as "note"
    with
        id "ddn.examples.venn::features.f_sdk"
        title "Public SDK"
        description "Synthetic: embeddable developer kit."
        metadata
            x_sets
                item "cipher"
        content
            text "Synthetic: embeddable developer kit."
        draft
            text "Synthetic: embeddable developer kit."


element "ddn.examples.venn::features.f_audit" as "note"
    with
        id "ddn.examples.venn::features.f_audit"
        title "Audit log"
        description "Synthetic: immutable activity trail."
        metadata
            x_sets
                item "atlas"
                item "beacon"
        content
            text "Synthetic: immutable activity trail."
        draft
            text "Synthetic: immutable activity trail."


element "ddn.examples.venn::features.f_share" as "note"
    with
        id "ddn.examples.venn::features.f_share"
        title "Shared workspaces"
        description "Synthetic: multi-team spaces."
        metadata
            x_sets
                item "atlas"
                item "beacon"
        content
            text "Synthetic: multi-team spaces."
        draft
            text "Synthetic: multi-team spaces."


element "ddn.examples.venn::features.f_embed" as "note"
    with
        id "ddn.examples.venn::features.f_embed"
        title "Embeddable widget"
        description "Synthetic: drop-in UI component."
        metadata
            x_sets
                item "atlas"
                item "cipher"
        content
            text "Synthetic: drop-in UI component."
        draft
            text "Synthetic: drop-in UI component."


element "ddn.examples.venn::features.f_export" as "note"
    with
        id "ddn.examples.venn::features.f_export"
        title "CSV export"
        description "Synthetic: one-click data export."
        metadata
            x_sets
                item "beacon"
                item "cipher"
        content
            text "Synthetic: one-click data export."
        draft
            text "Synthetic: one-click data export."


element "ddn.examples.venn::features.f_search" as "note"
    with
        id "ddn.examples.venn::features.f_search"
        title "Full-text search"
        description "Synthetic: ranked search across content."
        metadata
            x_sets
                item "atlas"
                item "beacon"
                item "cipher"
        content
            text "Synthetic: ranked search across content."
        draft
            text "Synthetic: ranked search across content."


element "overlap::panel::atlas" as "note"
    with
        id "overlap::panel::atlas"
        title "ATLAS"
        metadata
            x_record
                id "atlas"
                row 0
                column 0
                rowspan 1
                colspan 1
                items
                    item
                        id "ddn.examples.venn::features.f_offline"
                    item
                        id "ddn.examples.venn::features.f_audit"
                    item
                        id "ddn.examples.venn::features.f_share"
                    item
                        id "ddn.examples.venn::features.f_embed"
                    item
                        id "ddn.examples.venn::features.f_search"


element "overlap::panel::beacon" as "note"
    with
        id "overlap::panel::beacon"
        title "BEACON"
        metadata
            x_record
                id "beacon"
                row 1
                column 0
                rowspan 1
                colspan 1
                items
                    item
                        id "ddn.examples.venn::features.f_sso"
                    item
                        id "ddn.examples.venn::features.f_audit"
                    item
                        id "ddn.examples.venn::features.f_share"
                    item
                        id "ddn.examples.venn::features.f_export"
                    item
                        id "ddn.examples.venn::features.f_search"


element "overlap::panel::cipher" as "note"
    with
        id "overlap::panel::cipher"
        title "CIPHER"
        metadata
            x_record
                id "cipher"
                row 2
                column 0
                rowspan 1
                colspan 1
                items
                    item
                        id "ddn.examples.venn::features.f_sdk"
                    item
                        id "ddn.examples.venn::features.f_embed"
                    item
                        id "ddn.examples.venn::features.f_export"
                    item
                        id "ddn.examples.venn::features.f_search"


view "overlap" as "panels.venn@1"
    with
        id "overlap"
        title "Feature overlap / venn"
        selection
            include empty list
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        projection
            options
                columns 1
                panels
                    item
                        target
                            id "overlap::panel::atlas"
                        kind "text"
                        title "ATLAS"
                    item
                        target
                            id "overlap::panel::beacon"
                        kind "text"
                        title "BEACON"
                    item
                        target
                            id "overlap::panel::cipher"
                        kind "text"
                        title "CIPHER"
