version ddn-next-1

publication "publication:treemap"
    with
        id "publication:treemap"
        title "Synthetic storage by domain and table / treemap"
        targets
            item
                target
                    id "treemap"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.examples.treemap::storage.r1" as "record"
    with
        id "ddn.examples.treemap::storage.r1"
        title "analytics.events"
        metadata
            x_record
                path "analytics.events"
                value 55
                unit "GB"


element "ddn.examples.treemap::storage.r2" as "record"
    with
        id "ddn.examples.treemap::storage.r2"
        title "analytics.sessions"
        metadata
            x_record
                path "analytics.sessions"
                value 25
                unit "GB"


element "ddn.examples.treemap::storage.r3" as "record"
    with
        id "ddn.examples.treemap::storage.r3"
        title "core.orders"
        metadata
            x_record
                path "core.orders"
                value 40
                unit "GB"


element "ddn.examples.treemap::storage.r4" as "record"
    with
        id "ddn.examples.treemap::storage.r4"
        title "core.customers"
        metadata
            x_record
                path "core.customers"
                value 20
                unit "GB"


element "ddn.examples.treemap::storage.r5" as "record"
    with
        id "ddn.examples.treemap::storage.r5"
        title "ops.logs"
        metadata
            x_record
                path "ops.logs"
                value 30
                unit "GB"


element "ddn.examples.treemap::storage.r6" as "record"
    with
        id "ddn.examples.treemap::storage.r6"
        title "ops.metrics"
        metadata
            x_record
                path "ops.metrics"
                value 10
                unit "GB"


view "treemap" as "chart.treemap@1"
    with
        id "treemap"
        title "Synthetic storage by domain and table / treemap"
        selection
            include empty list
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.treemap::storage.r1"
                    item
                        id "ddn.examples.treemap::storage.r2"
                    item
                        id "ddn.examples.treemap::storage.r3"
                    item
                        id "ddn.examples.treemap::storage.r4"
                    item
                        id "ddn.examples.treemap::storage.r5"
                    item
                        id "ddn.examples.treemap::storage.r6"
                mark "treemap"
                x "metadata.x_record.path"
                y "metadata.x_record.value"
                unit "GB"
                width 1120
                height 620
