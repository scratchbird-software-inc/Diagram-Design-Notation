view "objects" as "uml.object@1"
    with
        id "objects"
        title "Synthetic snapshot / objects"
        selection
            include
                item
                    id "ddn.examples.object::model.customer"
                item
                    id "ddn.examples.object::model.order"
                item
                    id "ddn.examples.object::model.sample_customer"
                item
                    id "ddn.examples.object::model.sample_order"
                item
                    id "ddn.examples.object::model.placed"
        layout
            algorithm "layered"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        publication
            id "publication:objects"

    use "ddn.examples.object::model.customer" named "appearance:objects:ddn.examples.object::model.customer"
        with
