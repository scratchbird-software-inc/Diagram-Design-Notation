version ddn-next-1

publication "publication:timing"
    with
        id "publication:timing"
        title "Synthetic traffic lights / timing (seconds)"
        targets
            item
                target
                    id "timing"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.examples.timing::signals.controller" as "application"
    with
        id "ddn.examples.timing::signals.controller"
        title "Controller"
        metadata
            x_states
                item
                    at 0
                    state "red"
                item
                    at 25
                    state "green"
                item
                    at 55
                    state "amber"


element "ddn.examples.timing::signals.pedestrian_signal" as "application"
    with
        id "ddn.examples.timing::signals.pedestrian_signal"
        title "Pedestrian signal"
        metadata
            x_states
                item
                    at 0
                    state "wait"
                item
                    at 25
                    state "walk"
                item
                    at 45
                    state "wait"


view "timing" as "uml.timing@1"
    with
        id "timing"
        title "Synthetic traffic lights / timing (seconds)"
        selection
            include
                item
                    id "ddn.examples.timing::signals.controller"
                item
                    id "ddn.examples.timing::signals.pedestrian_signal"
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        publication
            id "publication:timing"

    use "ddn.examples.timing::signals.controller" named "appearance:timing:ddn.examples.timing::signals.controller"
        with
            id "appearance:timing:ddn.examples.timing::signals.controller"

    use "ddn.examples.timing::signals.pedestrian_signal" named "appearance:timing:ddn.examples.timing::signals.pedestrian_signal"
        with
            id "appearance:timing:ddn.examples.timing::signals.pedestrian_signal"
