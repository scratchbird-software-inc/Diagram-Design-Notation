ddn "0.5";

module "ddn.examples.mind-map";
// Synthetic meeting brainstorm for the mindmap.basic@1 profile.
data ideas {
    object root "Q3 launch brainstorm" { kind: object; description: "Synthetic workshop capture: what ships in Q3, in what order, and what could still sink it. Everything below is a branch of this one question."; }
    object pricing "Pricing" { kind: object; description: "Two tiers is the working bet: free for individuals, team for groups. Annual discount only on the team tier. Usage caps instead of per-seat maths. Grandfather the beta cohort quietly."; }
    object onboarding "Onboarding" { kind: object; description: "First-run path for a brand-new account, start to first value. Sign up with the synthetic sample workspace already loaded. Tour the catalogue before any real data. Import a small file and see the same diagram update. Invite a teammate and watch roles land. Find the undo before finding trouble. Save a first view worth sharing. Confirm the welcome checklist closes itself. Measure time to the first shared link. Note every stumble for the next sprint review."; }
    object risks "Risks" { kind: object; description: "Scope creep on the sample tour. Performance on very large maps."; }
    object marketing "Marketing" { kind: object; }
    term tiers "Usage tiers";
    term discount "Annual discount";
    term tour "Sample data tour";
    term creep "Scope creep";
    assoc r1 @root -> @pricing;
    assoc r2 @root -> @onboarding;
    assoc r3 @root -> @risks;
    assoc r4 @root -> @marketing;
    assoc r5 @pricing -> @tiers;
    assoc r6 @pricing -> @discount;
    assoc r7 @onboarding -> @tour;
    assoc r8 @risks -> @creep;
}

format options {
    layout mind { algorithm: mindmap; routing: curved; root: @ideas.root; hierarchy: [assoc]; }
}

view mindmap "Synthetic brainstorm / mind map" {
    data: [@ideas]; format: @ddn.examples.shared.styles.technical; layout: @options.mind;
    projection { kind: graph; profile: "mindmap.basic@1"; }
    publication { size: content; fit: none; overflow: error; minimum_text: 8pt; }
}

module "ddn.examples.shared";
format styles {
    notation core;
    style classic;
    style hand { look: handDrawn; font: handwriting; roughness: 1.8; hachure: true; }
    style neo { look: neo; }
    style dark { theme: dark; }
    style neutral { theme: neutral; font: mono; }
    style forest { look: handDrawn; theme: forest; font: handwriting; roughness: 1.8; hachure: true; }
    layout wires { algorithm: grid; gap: 80px; }
    display detailed;
    display compact { fields: none; maturity: none; badges: none; }
    publication screen { size: content; width: 1360px; height: 860px; margin: 30px; overflow: warn; }
    publication paper { size: a4; orientation: landscape; margin: 8mm; minimum_text: 7pt; overflow: warn; }
    legend words { width: 280px; }
    legend numbers { mode: numbers; width: 280px; }
    bundle technical {
        notation: @core;
        style: @classic;
        layout: @wires;
        display: @detailed;
        publication: @screen;
        legend: @words;
    }
}
