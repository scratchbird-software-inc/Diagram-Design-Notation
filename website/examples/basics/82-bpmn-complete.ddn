version ddn-next-1

publication "publication:process"
    with
        id "publication:process"
        title "Process"
        targets
            item
                target
                    id "process"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 8


publication "publication:collaboration"
    with
        id "publication:collaboration"
        title "Collaboration"
        targets
            item
                target
                    id "collaboration"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:choreography"
    with
        id "publication:choreography"
        title "Choreography"
        targets
            item
                target
                    id "choreography"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 8


publication "publication:conversation"
    with
        id "publication:conversation"
        title "Conversation"
        targets
            item
                target
                    id "conversation"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 8


element "ddn.examples.bpmn::proc.start" as "flow.start"
    with
        id "ddn.examples.bpmn::proc.start"
        title "Order received"
        metadata
            x_event
                type "message"


element "ddn.examples.bpmn::proc.review" as "flow.process"
    with
        id "ddn.examples.bpmn::proc.review"
        title "Review order"
        metadata
            x_activity
                markers
                    item "loop"


element "ddn.examples.bpmn::proc.escalate" as "flow.intermediate"
    with
        id "ddn.examples.bpmn::proc.escalate"
        title "escalate"
        metadata
            x_event
                type "escalation"
                position "boundary"
                interrupting false
                on
                    id "ddn.examples.bpmn::proc.review"


element "ddn.examples.bpmn::proc.dec" as "flow.gateway"
    with
        id "ddn.examples.bpmn::proc.dec"
        title "dec"
        metadata
            x_gateway
                type "exclusive"


element "ddn.examples.bpmn::proc.pack" as "flow.process"
    with
        id "ddn.examples.bpmn::proc.pack"
        title "Pack"
        metadata
            x_activity
                markers
                    item "parallel"


element "ddn.examples.bpmn::proc.call" as "flow.process"
    with
        id "ddn.examples.bpmn::proc.call"
        title "Billing"
        metadata
            x_activity
                call true


element "ddn.examples.bpmn::proc.tx" as "flow.subprocess"
    with
        id "ddn.examples.bpmn::proc.tx"
        title "Reserve stock"
        metadata
            x_activity
                transaction true


element "ddn.examples.bpmn::proc.adhoc" as "flow.process"
    with
        id "ddn.examples.bpmn::proc.adhoc"
        title "Fix up"
        metadata
            x_activity
                adhoc true


element "ddn.examples.bpmn::proc.evsub" as "flow.subprocess"
    with
        id "ddn.examples.bpmn::proc.evsub"
        title "Timeout handler"
        metadata
            x_activity
                event_subprocess true


element "ddn.examples.bpmn::proc.data" as "flow.dataobject"
    with
        id "ddn.examples.bpmn::proc.data"
        title "Order data"


element "ddn.examples.bpmn::proc.din" as "flow.datainput"
    with
        id "ddn.examples.bpmn::proc.din"
        title "Credit check"


element "ddn.examples.bpmn::proc.dout" as "flow.dataoutput"
    with
        id "ddn.examples.bpmn::proc.dout"
        title "Invoice"
        metadata
            x_io
                set true


element "ddn.examples.bpmn::proc.store" as "flow.datastore"
    with
        id "ddn.examples.bpmn::proc.store"
        title "Order store"


element "ddn.examples.bpmn::proc.grp" as "flow.group"
    with
        id "ddn.examples.bpmn::proc.grp"
        title "Notes"


element "ddn.examples.bpmn::proc.cancel_end" as "flow.end"
    with
        id "ddn.examples.bpmn::proc.cancel_end"
        title "Cancelled"
        metadata
            x_event
                type "cancel"


element "ddn.examples.bpmn::proc.done" as "flow.end"
    with
        id "ddn.examples.bpmn::proc.done"
        title "Shipped"
        metadata
            x_event
                type "terminate"


relation "ddn.examples.bpmn::proc.f1" as "uml.flow"
    with
        id "ddn.examples.bpmn::proc.f1"
        title "Activity edge"
        endpoints
            item
                definition
                    id "ddn.examples.bpmn::proc.start"
            item
                definition
                    id "ddn.examples.bpmn::proc.review"


relation "ddn.examples.bpmn::proc.f2" as "uml.flow"
    with
        id "ddn.examples.bpmn::proc.f2"
        title "Activity edge"
        endpoints
            item
                definition
                    id "ddn.examples.bpmn::proc.review"
            item
