                    id "ddn.examples.bpmn::proc.dec"


relation "ddn.examples.bpmn::proc.f3" as "uml.flow"
    with
        id "ddn.examples.bpmn::proc.f3"
        title "ok"
        endpoints
            item
                definition
                    id "ddn.examples.bpmn::proc.dec"
            item
                definition
                    id "ddn.examples.bpmn::proc.pack"
        qualifiers
            source
                mark "slash"
        notes
            item
                title "Additional source details"
                text
                    {
                      "source_mark": "slash"
                    }
                format "plain"


relation "ddn.examples.bpmn::proc.f4" as "uml.flow"
    with
        id "ddn.examples.bpmn::proc.f4"
        title "big"
        properties
            source_mark "diamond"
        endpoints
            item
                definition
                    id "ddn.examples.bpmn::proc.dec"
            item
                definition
                    id "ddn.examples.bpmn::proc.tx"
        qualifiers
            source
                mark "diamond"


