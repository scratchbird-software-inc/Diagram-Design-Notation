                unit "index"


view "choropleth" as "geo.choropleth@1"
    with
        id "choropleth"
        title "Synthetic adoption index / world choropleth"
        selection
            include empty list
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.geo-choropleth::indicators.c840"
                    item
                        id "ddn.examples.geo-choropleth::indicators.c156"
                    item
                        id "ddn.examples.geo-choropleth::indicators.c356"
                    item
                        id "ddn.examples.geo-choropleth::indicators.c276"
                    item
                        id "ddn.examples.geo-choropleth::indicators.c076"
                    item
                        id "ddn.examples.geo-choropleth::indicators.c566"
                    item
                        id "ddn.examples.geo-choropleth::indicators.c392"
                    item
                        id "ddn.examples.geo-choropleth::indicators.c036"
                    item
                        id "ddn.examples.geo-choropleth::indicators.c124"
                    item
                        id "ddn.examples.geo-choropleth::indicators.c710"
                    item
                        id "ddn.examples.geo-choropleth::indicators.c752"
                    item
                        id "ddn.examples.geo-choropleth::indicators.c484"
                mark "choropleth"
                geography "assets/geo/world-110m.json"
                method "equalEarth"
                x "metadata.x_record.id"
                value "metadata.x_record.value"
                unit "index"
                width 1120
                height 640
