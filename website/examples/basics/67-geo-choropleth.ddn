version ddn-next-1

asset "assets/geo/world-110m.json" as resource from "../../assets/geo/world-110m.json"
    with
        id "geography::assets/geo/world-110m.json"
        media_type "application/geo+json"


publication "publication:choropleth"
    with
        id "publication:choropleth"
        title "Synthetic adoption index / world choropleth"
        targets
            item
                target
                    id "choropleth"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.examples.geo-choropleth::indicators.c840" as "record"
    with
        id "ddn.examples.geo-choropleth::indicators.c840"
        title "United States"
        metadata
            x_record
                id "840"
                value 86
                unit "index"


element "ddn.examples.geo-choropleth::indicators.c156" as "record"
    with
        id "ddn.examples.geo-choropleth::indicators.c156"
        title "China"
        metadata
            x_record
                id "156"
                value 74
                unit "index"


element "ddn.examples.geo-choropleth::indicators.c356" as "record"
    with
        id "ddn.examples.geo-choropleth::indicators.c356"
        title "India"
        metadata
            x_record
                id "356"
                value 58
                unit "index"


element "ddn.examples.geo-choropleth::indicators.c276" as "record"
    with
        id "ddn.examples.geo-choropleth::indicators.c276"
        title "Germany"
