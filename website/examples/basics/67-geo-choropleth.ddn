    with
        id "ddn.examples.geo-choropleth::indicators.c076"
        title "Brazil"
        metadata
            x_record
                id "076"
                value 49
                unit "index"


element "ddn.examples.geo-choropleth::indicators.c566" as "record"
    with
        id "ddn.examples.geo-choropleth::indicators.c566"
        title "Nigeria"
        metadata
            x_record
                id "566"
                value 31
                unit "index"


element "ddn.examples.geo-choropleth::indicators.c392" as "record"
    with
        id "ddn.examples.geo-choropleth::indicators.c392"
        title "Japan"
        metadata
            x_record
                id "392"
                value 78
                unit "index"


element "ddn.examples.geo-choropleth::indicators.c036" as "record"
    with
        id "ddn.examples.geo-choropleth::indicators.c036"
        title "Australia"
        metadata
            x_record
                id "036"
                value 69
                unit "index"


element "ddn.examples.geo-choropleth::indicators.c124" as "record"
    with
        id "ddn.examples.geo-choropleth::indicators.c124"
        title "Canada"
        metadata
            x_record
                id "124"
                value 77
                unit "index"


element "ddn.examples.geo-choropleth::indicators.c710" as "record"
    with
        id "ddn.examples.geo-choropleth::indicators.c710"
        title "South Africa"
        metadata
            x_record
                id "710"
                value 42
                unit "index"


element "ddn.examples.geo-choropleth::indicators.c752" as "record"
    with
        id "ddn.examples.geo-choropleth::indicators.c752"
        title "Sweden"
        metadata
