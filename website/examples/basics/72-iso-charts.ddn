version ddn-next-1

publication "publication:iso_bar"
    with
        id "publication:iso_bar"
        title "Synthetic tier throughput / iso bar"
        targets
            item
                target
                    id "iso_bar"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


