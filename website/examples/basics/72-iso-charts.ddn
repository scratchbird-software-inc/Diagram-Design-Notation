view "iso_bar" as "chart.basic@1"
    with
        id "iso_bar"
        title "Synthetic tier throughput / iso bar"
        selection
            include empty list
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.iso-charts::capacity.web"
                    item
                        id "ddn.examples.iso-charts::capacity.api"
                    item
                        id "ddn.examples.iso-charts::capacity.db"
                    item
                        id "ddn.examples.iso-charts::capacity.cache"
                mark "bar"
                x "metadata.x_record.tier"
                y "metadata.x_record.value"
                unit "req/s"
                iso true
                depth "metadata.x_record.load"
                width 1120
                height 640


