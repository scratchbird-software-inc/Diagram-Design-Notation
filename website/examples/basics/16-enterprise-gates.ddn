version ddn-next-1

publication "publication:external"
    with
        id "publication:external"
        title "External gates / required evidence"
        targets
            item
                target
                    id "external"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


publication "publication:software"
    with
        id "publication:software"
        title "Software changes / independent review checklist"
        targets
            item
                target
                    id "software"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            width
                value 1360
                unit "px"
            height
                value 860
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.enterprise.readiness::gates.issue001" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue001"
        title "Automatic grid routes through an unrelated object"
        description "Native obstacle-aware router; A→C avoids intervening B. Pins and infeasible clearances fail explicitly."
        metadata
            x_requirement
                id "ERP-DDN-001"
                owner "DDN layout maintainer"
                acceptance "Native core routes the three-node counterexample without any unrelated box intersection; test adversarial ports and dense fields."
                state "required"


element "ddn.enterprise.readiness::gates.issue002" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue002"
        title "Shared connector tracks and callout interference remain"
        description "Independent endpoint lanes, reserved ports and callout corridors; independent full-corpus scanner is now an error gate."
        metadata
            x_requirement
                id "ERP-DDN-002"
                owner "DDN renderer maintainer / technical writer"
                acceptance "Distinguish shared port stubs from unrelated shared trunks, then require unique visible signatures and zero unrelated-callout masking across the corpus."
                state "required"


element "ddn.enterprise.readiness::gates.issue003" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue003"
        title "Relationship endpoint compatibility is not enforced"
        description "Every relation has executable endpoint-kind/member/self constraints. Invalid known kind pairs fail before drawing."
        metadata
            x_requirement
                id "ERP-DDN-003"
                owner "Language/compiler maintainer"
                acceptance "Reject invalid endpoint-kind pairs and preserve valid vendor-extension fallbacks without silently guessing."
                state "required"


element "ddn.enterprise.readiness::gates.issue004" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue004"
        title "Extension business metadata is preserved but not validated"
        description "Registered typed x_erp and other extension validators reject malformed data. Unknown extensions are warned or rejected by strict mode."
        metadata
            x_requirement
                id "ERP-DDN-004"
                owner "Language/ERP schema reviewers"
                acceptance "Reject malformed typed metadata, unknown semantics and invalid compound references, with field-level diagnostics."
                state "required"


element "ddn.enterprise.readiness::gates.issue005" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue005"
        title "Requested domain display is ignored"
        description "Domain/datatype display resolves names without changing model identities."
        metadata
            x_requirement
                id "ERP-DDN-005"
                owner "DDN renderer maintainer"
                acceptance "A visible domain badge/text resolves to the correct stable domain; toggling it preserves model hash."
                state "required"


element "ddn.enterprise.readiness::gates.issue006" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue006"
        title "fit:none with overflow:error can silently clip content"
        description "Every implemented fit mode checks bounds and final text size; embedding/inline sizes are checked. Unsupported pagination is rejected."
        metadata
            x_requirement
                id "ERP-DDN-006"
                owner "Publication maintainer"
                acceptance "Reject or reflow every out-of-bounds element/label under overflow:error; no hidden clipping in print."
                state "required"


element "ddn.enterprise.readiness::gates.issue007" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue007"
        title "Scalable fonts and accurate text measurement remain unsupported"
        description "Variable base sizes and browser/pinned measurements are implemented; unknown runs have explicit warnings or fail under metrics:required. Cross-machine font/bidi qualification remains external."
        metadata
            x_requirement
                id "ERP-DDN-007"
                owner "Typography/accessibility reviewer"
                acceptance "Measure resolved fonts and actual text runs; verify final embedding scale, Unicode shaping and no overflow in Chrome and Firefox."
                state "required"


element "ddn.enterprise.readiness::gates.issue008" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue008"
        title "Hidden detail remains in a full semantic export"
        description "Shared allowlist export projector is used by SVG, JSON, CLI and editor. Hidden private source is not mistaken for public output."
        metadata
            x_requirement
                id "ERP-DDN-008"
                owner "Security/privacy reviewer"
                acceptance "Authorized export closure excludes protected fields, examples and metadata from SVG/JSON/source/tooltips, with negative tests."
                state "required"


element "ddn.enterprise.readiness::gates.issue009" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue009"
        title "Nested field syntax is not yet executable"
        description "Recursive fields have stable path/parent/depth identities and member endpoints. Variant/presence/null declarations remain explicit."
        metadata
            x_requirement
                id "ERP-DDN-009"
                owner "Language maintainer"
                acceptance "Validate/render nested arrays, variants and optional/null states with stable field-level endpoints."
                state "required"


element "ddn.enterprise.readiness::gates.issue010" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue010"
        title "Layered layout appears in the specification but is rejected"
        description "Native grid/manual/layered/tree/mindmap/grouped algorithms; executable capability manifest prevents unsupported enum drift."
        metadata
            x_requirement
                id "ERP-DDN-010"
                owner "Specification editor"
                acceptance "Every documented enum value has an implemented conformance level or explicit unsupported status."
                state "required"


element "ddn.enterprise.readiness::gates.issue011" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue011"
        title "Derived datasets were initially labeled authoritative"
        description "Corrected role/workload mapping; regression checks now cover projections and analytic facts."
        metadata
            x_requirement
                id "ERP-MOD-011"
                owner "Data architect"
                acceptance "Re-run case-checks; inspect analytical run/evidence roles separately from business facts."
                state "required"


element "ddn.enterprise.readiness::gates.issue012" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue012"
        title "Finished-goods sample drifted from loaded labor costing"
        description "Corrected source/generator and explicit expected stock value630 check."
        metadata
            x_requirement
                id "ERP-MOD-012"
                owner "Cost accountant"
                acceptance "Changing labor input must update fixture and samples or fail validation."
                state "required"


element "ddn.enterprise.readiness::gates.issue013" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue013"
        title "Minute fields shared an elapsed-seconds domain"
        description "Added explicit elapsed-minute domain; named minute fields now bind it."
        metadata
            x_requirement
                id "ERP-MOD-013"
                owner "Manufacturing/data architect"
                acceptance "Verify every duration interface declares conversion; case-check minutes-domain test remains green."
                state "required"


element "ddn.enterprise.readiness::gates.issue014" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue014"
        title "Same-company keys do not cover all cross-entity affinity rules"
        description "DDN x_affinity records explicit comparisons and enforcement responsibility; fixture checks are available. Target-engine race/affinity enforcement is still unverified."
        metadata
            x_requirement
                id "ERP-MOD-014"
                owner "DBA / controller"
                acceptance "Negative tests for cross-company cost centre, wrong period/book, wrong warehouse owner and intentional intercompany exception."
                state "required"


element "ddn.enterprise.readiness::gates.issue015" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue015"
        title "Cross-database references require durable reconciliation"
        description "DDN x_reconciliation requires idempotency, state outcomes, timeout, compensation and evidence. Real cross-service recovery remains unverified."
        metadata
            x_requirement
                id "ERP-MOD-015"
                owner "Distributed-systems / workforce architect"
                acceptance "Inject outage, stale reference, revoked employment and duplicate acceptance; ensure no unmatched labor/payroll/ledger effect."
                state "required"


element "ddn.enterprise.readiness::gates.issue016" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue016"
        title "Jurisdictional accounting/payroll/privacy policies not approved"
        description "Explicit required gate: approved jurisdiction policies and genuine expert evidence are absent; no diagram can manufacture them."
        metadata
            x_requirement
                id "ERP-POL-016"
                owner "Controller / payroll specialist / privacy counsel"
                acceptance "Approve versioned jurisdiction matrix and independent calculation/evidence suites; document exclusions explicitly."
                state "required"


element "ddn.enterprise.readiness::gates.issue017" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue017"
        title "Full temporal/uniqueness/mutation enforcement is not implemented"
        description "DDN x_constraint declares uniqueness, half-open interval and immutable-state contracts with fixture checks. Production database migrations remain review-only."
        metadata
            x_requirement
                id "ERP-MOD-017"
                owner "DBA / data architect"
                acceptance "Execute migrations against selected engine; mutation/property tests for interval overlap, history correction and posted-line immutability."
                state "required"


element "ddn.enterprise.readiness::gates.issue018" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue018"
        title "No distributed load, broker, bank or restore drill has run"
        description "Required operational evidence remains absent. No live broker, bank, load or restore drill is claimed."
        metadata
            x_requirement
                id "ERP-OPS-018"
                owner "SRE / integration owner"
                acceptance "Measured failover fencing, recovery consistency, broker restart, bank-unknown-outcome reconciliation and peak contention tests."
                state "required"


element "ddn.enterprise.readiness::gates.issue019" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue019"
        title "UI/report requirements are not finished executable applications"
        description "Typed x_ui/x_report can validate field/command/grain/cutoff contracts. The ERP screens and reports remain specifications/wireframes, not finished applications."
        metadata
            x_requirement
                id "ERP-APP-019"
                owner "UX / report owner / application architect"
                acceptance "Authorize and test commands end-to-end; reconcile each production report at fixed source cuts; keyboard/assistive testing."
                state "required"


element "ddn.enterprise.readiness::gates.issue020" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue020"
        title "DFD steps are not an executable workflow or formal balanced DFD certification"
        description "Balanced port/payload contracts and bounded branch/guard/retry fixtures added. Not an orchestration runtime or formal DFD certification."
        metadata
            x_requirement
                id "ERP-DDN-020"
                owner "Process analyst / DDN standards reviewer"
                acceptance "Guard/branch/loop and boundary-balance fixtures including missing, duplicated and incompatible ports."
                state "required"


element "ddn.enterprise.readiness::gates.issue021" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue021"
        title "Mind-map and obstacle avoidance use a case-specific hint generator"
        description "Native mindmap/tree/layered placement replaces the case-only helper. Current enterprise sources contain no generated placement/waypoint blocks."
        metadata
            x_requirement
                id "ERP-DDN-021"
                owner "DDN layout maintainer"
                acceptance "Native reusable layout presets, deterministic stability and explicit failure diagnostics across unrelated inputs."
                state "required"


element "ddn.enterprise.readiness::gates.issue022" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue022"
        title "Hash-chain fixture is not tamper-proof evidence custody"
        description "x_custody makes independent anchor/key/retention/hold/evidence responsibilities explicit; real custody and privileged-administrator testing remain required."
        metadata
            x_requirement
                id "ERP-SEC-022"
                owner "Auditor / security engineer"
                acceptance "Adversarial administrator exercise plus independently verified retention/hold/export custody evidence."
                state "required"


element "ddn.enterprise.readiness::gates.issue023" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue023"
        title "Specialized financial/manufacturing algorithms remain bounded"
        description "Specialized algorithms remain subject to scoped fixtures and policy approval; labels are not implementation evidence."
        metadata
            x_requirement
                id "ERP-FIN-023"
                owner "Controller / manufacturing specialist"
                acceptance "Approved policies and adversarial numeric examples for every in-scope specialized operation."
                state "required"


element "ddn.enterprise.readiness::gates.issue024" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue024"
        title "No independent professional signoff yet"
        description "Independent reviewer slots remain blank. Author tests do not sign on behalf of accountants, SREs, auditors or privacy counsel."
        metadata
            x_requirement
                id "ERP-REV-024"
                owner "Review chair"
                acceptance "Each mandatory role signs exact model/spec/code hash and records accepted residual risk; unresolved critical items block production."
                state "required"


element "ddn.enterprise.readiness::gates.issue025" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue025"
        title "Whole-model A4 output correctly rejected"
        description "Readability guard retained. Bounded linked views replace illegible whole-model paper output."
        metadata
            x_requirement
                id "ERP-DDN-025"
                owner "Technical writer"
                acceptance "Retain rejection fixture and verify additional page/fit modes under ERP-DDN-006."
                state "required"


element "ddn.enterprise.readiness::gates.issue026" as "rule"
    with
        id "ddn.enterprise.readiness::gates.issue026"
        title "Findings filter option was malformed during initial build"
        description "Corrected the HTML source and added explicit count/filter browser regression checks. Normal HTTP navigation is independently blocked by the test environment and is not counted as application success."
        metadata
            x_requirement
                id "ERP-WEB-026"
                owner "Web editor maintainer"
                acceptance "All 26 findings selectable; nine external gates, 11 reference-verified fixes and one scoped typography item remain separately filterable in the 0.3 review site."
                state "required"


view "external" as "ddn@1"
    with
        id "external"
        title "External gates / required evidence"
        selection
            include
                item
                    id "ddn.enterprise.readiness::gates.issue014"
                item
                    id "ddn.enterprise.readiness::gates.issue015"
                item
                    id "ddn.enterprise.readiness::gates.issue016"
                item
                    id "ddn.enterprise.readiness::gates.issue017"
                item
                    id "ddn.enterprise.readiness::gates.issue018"
                item
                    id "ddn.enterprise.readiness::gates.issue019"
                item
                    id "ddn.enterprise.readiness::gates.issue022"
                item
                    id "ddn.enterprise.readiness::gates.issue023"
                item
                    id "ddn.enterprise.readiness::gates.issue024"
        layout
            algorithm "grid"
            gap 80
        legend
            width 280
        background
            color "#f6f8fc"
        publication
            id "publication:external"

    use "ddn.enterprise.readiness::gates.issue014" named "appearance:external:ddn.enterprise.readiness::gates.issue014"
        with
            id "appearance:external:ddn.enterprise.readiness::gates.issue014"
            body "notes"

    use "ddn.enterprise.readiness::gates.issue015" named "appearance:external:ddn.enterprise.readiness::gates.issue015"
        with
            id "appearance:external:ddn.enterprise.readiness::gates.issue015"
            body "notes"

    use "ddn.enterprise.readiness::gates.issue016" named "appearance:external:ddn.enterprise.readiness::gates.issue016"
        with
            id "appearance:external:ddn.enterprise.readiness::gates.issue016"
            body "notes"

    use "ddn.enterprise.readiness::gates.issue017" named "appearance:external:ddn.enterprise.readiness::gates.issue017"
        with
            id "appearance:external:ddn.enterprise.readiness::gates.issue017"
            body "notes"

    use "ddn.enterprise.readiness::gates.issue018" named "appearance:external:ddn.enterprise.readiness::gates.issue018"
        with
            id "appearance:external:ddn.enterprise.readiness::gates.issue018"
            body "notes"

    use "ddn.enterprise.readiness::gates.issue019" named "appearance:external:ddn.enterprise.readiness::gates.issue019"
        with
            id "appearance:external:ddn.enterprise.readiness::gates.issue019"
            body "notes"

    use "ddn.enterprise.readiness::gates.issue022" named "appearance:external:ddn.enterprise.readiness::gates.issue022"
        with
            id "appearance:external:ddn.enterprise.readiness::gates.issue022"
            body "notes"

    use "ddn.enterprise.readiness::gates.issue023" named "appearance:external:ddn.enterprise.readiness::gates.issue023"
        with
            id "appearance:external:ddn.enterprise.readiness::gates.issue023"
            body "notes"

    use "ddn.enterprise.readiness::gates.issue024" named "appearance:external:ddn.enterprise.readiness::gates.issue024"
        with
            id "appearance:external:ddn.enterprise.readiness::gates.issue024"
            body "notes"


