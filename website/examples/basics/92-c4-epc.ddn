version ddn-next-1

publication "publication:deployment"
    with
        id "publication:deployment"
        title "Shop deployment"
        targets
            item
                target
                    id "deployment"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:dynamic"
    with
        id "publication:dynamic"
        title "Browse dynamic"
        targets
            item
                target
                    id "dynamic"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:epc"
    with
        id "publication:epc"
        title "Fulfillment EPC"
        targets
            item
                target
                    id "epc"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.c4epc::dep.cdn" as "uml.node"
    with
        id "ddn.examples.c4epc::dep.cdn"
        title "Edge node"
        metadata
            x_c4tag
                tags
                    item "infra"
                    item "edge"


element "ddn.examples.c4epc::dep.appbox" as "uml.device"
    with
        id "ddn.examples.c4epc::dep.appbox"
        title "Shop server"


element "ddn.examples.c4epc::dep.db" as "uml.device"
    with
        id "ddn.examples.c4epc::dep.db"
        title "Database host"


element "ddn.examples.c4epc::dep.war" as "uml.artifact"
    with
        id "ddn.examples.c4epc::dep.war"
        title "shop.war"


relation "ddn.examples.c4epc::dep.deploy" as "uml.deploy"
    with
        id "ddn.examples.c4epc::dep.deploy"
        title "«deploy»"
        endpoints
            item
                definition
                    id "ddn.examples.c4epc::dep.war"
            item
                definition
                    id "ddn.examples.c4epc::dep.appbox"


relation "ddn.examples.c4epc::dep.path1" as "uml.commpath"
    with
        id "ddn.examples.c4epc::dep.path1"
        title "Communication path"
        metadata
            x_endlabels
                target
                    multiplicity "1..2"
        endpoints
            item
                definition
                    id "ddn.examples.c4epc::dep.cdn"
            item
                definition
                    id "ddn.examples.c4epc::dep.appbox"


relation "ddn.examples.c4epc::dep.path2" as "uml.commpath"
    with
        id "ddn.examples.c4epc::dep.path2"
        title "Communication path"
        endpoints
            item
                definition
                    id "ddn.examples.c4epc::dep.appbox"
            item
                definition
                    id "ddn.examples.c4epc::dep.db"


element "ddn.examples.c4epc::dyn.cust" as "c4.person"
    with
        id "ddn.examples.c4epc::dyn.cust"
        title "Customer"


element "ddn.examples.c4epc::dyn.web" as "c4.container"
    with
        id "ddn.examples.c4epc::dyn.web"
        title "Web app"
        metadata
            x_c4tag
                tags
                    item "web"


element "ddn.examples.c4epc::dyn.api" as "c4.container"
    with
        id "ddn.examples.c4epc::dyn.api"
        title "API service"


relation "ddn.examples.c4epc::dyn.m1" as "uml.message"
    with
        id "ddn.examples.c4epc::dyn.m1"
        title "browse catalog"
        metadata
            x_message
                seq "1"
        endpoints
            item
                definition
                    id "ddn.examples.c4epc::dyn.cust"
            item
                definition
                    id "ddn.examples.c4epc::dyn.web"


relation "ddn.examples.c4epc::dyn.m2" as "uml.message"
    with
        id "ddn.examples.c4epc::dyn.m2"
        title "query products"
        metadata
            x_message
                seq "2"
        endpoints
            item
                definition
                    id "ddn.examples.c4epc::dyn.web"
            item
                definition
                    id "ddn.examples.c4epc::dyn.api"


relation "ddn.examples.c4epc::dyn.m3" as "uml.message"
    with
        id "ddn.examples.c4epc::dyn.m3"
        title "product list"
        metadata
            x_message
                seq "2.1"
            x_return true
        endpoints
            item
                definition
                    id "ddn.examples.c4epc::dyn.api"
            item
                definition
                    id "ddn.examples.c4epc::dyn.web"


relation "ddn.examples.c4epc::dyn.m4" as "uml.message"
    with
        id "ddn.examples.c4epc::dyn.m4"
        title "render page"
        metadata
            x_message
                seq "3"
        endpoints
            item
                definition
                    id "ddn.examples.c4epc::dyn.web"
            item
                definition
                    id "ddn.examples.c4epc::dyn.cust"


element "ddn.examples.c4epc::e.ev" as "epk.event"
    with
        id "ddn.examples.c4epc::e.ev"
        title "Order received"


element "ddn.examples.c4epc::e.check" as "epk.function"
    with
        id "ddn.examples.c4epc::e.check"
        title "Check stock"


element "ddn.examples.c4epc::e.c1" as "epk.connector"
    with
        id "ddn.examples.c4epc::e.c1"
        title "c1"
        metadata
            x_epc
                operator "and"


element "ddn.examples.c4epc::e.reserve" as "epk.function"
    with
        id "ddn.examples.c4epc::e.reserve"
        title "Reserve items"


element "ddn.examples.c4epc::e.pick" as "epk.function"
    with
        id "ddn.examples.c4epc::e.pick"
        title "Pick items"


element "ddn.examples.c4epc::e.c2" as "epk.connector"
    with
        id "ddn.examples.c4epc::e.c2"
        title "c2"
        metadata
            x_epc
                operator "and"


element "ddn.examples.c4epc::e.ev2" as "epk.event"
    with
        id "ddn.examples.c4epc::e.ev2"
        title "Order ready"


element "ddn.examples.c4epc::e.ship" as "epk.function"
    with
        id "ddn.examples.c4epc::e.ship"
        title "Ship order"


element "ddn.examples.c4epc::e.ev3" as "epk.event"
    with
        id "ddn.examples.c4epc::e.ev3"
        title "Order shipped"


element "ddn.examples.c4epc::e.wh" as "epk.orgunit"
    with
        id "ddn.examples.c4epc::e.wh"
        title "Warehouse"


element "ddn.examples.c4epc::e.picker" as "epk.role"
    with
        id "ddn.examples.c4epc::e.picker"
        title "Picker"


element "ddn.examples.c4epc::e.list" as "epk.infoobject"
    with
        id "ddn.examples.c4epc::e.list"
        title "Pick list"


element "ddn.examples.c4epc::e.billing" as "epk.processlink"
    with
        id "ddn.examples.c4epc::e.billing"
        title "Billing process"


relation "ddn.examples.c4epc::e.n1" as "epk.next"
    with
        id "ddn.examples.c4epc::e.n1"
        title "Control passes to"
        endpoints
            item
                definition
                    id "ddn.examples.c4epc::e.ev"
            item
                definition
                    id "ddn.examples.c4epc::e.check"


