    use "ddn.examples.c4epc::dep.path2" named "appearance:deployment:ddn.examples.c4epc::dep.path2"
        with
            id "appearance:deployment:ddn.examples.c4epc::dep.path2"


view "dynamic" as "c4.dynamic@1"
    with
