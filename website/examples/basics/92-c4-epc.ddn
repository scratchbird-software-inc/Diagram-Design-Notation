view "deployment" as "c4.deployment@1"
    with
        id "deployment"
        title "Shop deployment"
        selection
            include
                item
                    id "ddn.examples.c4epc::dep.cdn"
                item
                    id "ddn.examples.c4epc::dep.appbox"
                item
                    id "ddn.examples.c4epc::dep.db"
                item
                    id "ddn.examples.c4epc::dep.war"
                item
                    id "ddn.examples.c4epc::dep.deploy"
                item
                    id "ddn.examples.c4epc::dep.path1"
                item
                    id "ddn.examples.c4epc::dep.path2"
            exclude
                item
                    id "ddn.examples.c4epc::dyn.m1"
                item
                    id "ddn.examples.c4epc::dyn.m2"
                item
                    id "ddn.examples.c4epc::dyn.m3"
                item
                    id "ddn.examples.c4epc::dyn.m4"
                item
                    id "ddn.examples.c4epc::e.n1"
                item
                    id "ddn.examples.c4epc::e.n2"
                item
                    id "ddn.examples.c4epc::e.n3"
                item
                    id "ddn.examples.c4epc::e.n4"
                item
                    id "ddn.examples.c4epc::e.n5"
                item
                    id "ddn.examples.c4epc::e.n6"
                item
                    id "ddn.examples.c4epc::e.n7"
                item
                    id "ddn.examples.c4epc::e.n8"
                item
                    id "ddn.examples.c4epc::e.n9"
                item
                    id "ddn.examples.c4epc::e.a1"
                item
                    id "ddn.examples.c4epc::e.a2"
                item
                    id "ddn.examples.c4epc::e.i1"
                item
                    id "ddn.examples.c4epc::e.i2"
                item
                    id "ddn.examples.c4epc::e.l1"
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        regions
            item
                id "ddn.examples.c4epc::deployment.rack"
                name "Shop server"
                scope
                    id "ddn.examples.c4epc::dep.appbox"
                members
                    item
                        id "ddn.examples.c4epc::dep.war"
        publication
            id "publication:deployment"

    use "ddn.examples.c4epc::dep.cdn" named "appearance:deployment:ddn.examples.c4epc::dep.cdn"
        with
            id "appearance:deployment:ddn.examples.c4epc::dep.cdn"

    use "ddn.examples.c4epc::dep.appbox" named "appearance:deployment:ddn.examples.c4epc::dep.appbox"
        with
            id "appearance:deployment:ddn.examples.c4epc::dep.appbox"

    use "ddn.examples.c4epc::dep.db" named "appearance:deployment:ddn.examples.c4epc::dep.db"
        with
            id "appearance:deployment:ddn.examples.c4epc::dep.db"

    use "ddn.examples.c4epc::dep.war" named "appearance:deployment:ddn.examples.c4epc::dep.war"
        with
            id "appearance:deployment:ddn.examples.c4epc::dep.war"

    use "ddn.examples.c4epc::dep.deploy" named "appearance:deployment:ddn.examples.c4epc::dep.deploy"
        with
            id "appearance:deployment:ddn.examples.c4epc::dep.deploy"

    use "ddn.examples.c4epc::dep.path1" named "appearance:deployment:ddn.examples.c4epc::dep.path1"
