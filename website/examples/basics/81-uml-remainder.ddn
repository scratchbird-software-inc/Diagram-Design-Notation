element "ddn.examples.umlrem::tim.bus" as "service"
    with
        id "ddn.examples.umlrem::tim.bus"
        title "Bus"
        metadata
            x_timeconstraint
                item "{0..40}"
            x_states
                item
                    at 0
                    state "idle"
                item
                    at 10
                    state "idle"
                item
                    at 20
                    state "busy"
                    duration "{20..30}"


element "ddn.examples.umlrem::tim.card" as "application"
    with
        id "ddn.examples.umlrem::tim.card"
        title "Card"
        metadata
            x_states
                item
                    at 5
                    state "out"
                    slew "{2}"
                item
                    at 25
                    state "in"


relation "ddn.examples.umlrem::tim.tm" as "uml.message"
    with
        id "ddn.examples.umlrem::tim.tm"
        title "swipe"
        metadata
            x_message
                at 15
        endpoints
            item
                definition
                    id "ddn.examples.umlrem::tim.card"
            item
                definition
                    id "ddn.examples.umlrem::tim.bus"


element "ddn.examples.umlrem::uc.sys" as "uml.subject"
    with
        id "ddn.examples.umlrem::uc.sys"
        title "Shop"


element "ddn.examples.umlrem::uc.buyer" as "uml.actor"
    with
        id "ddn.examples.umlrem::uc.buyer"
        title "Buyer"


element "ddn.examples.umlrem::uc.checkout" as "uml.usecase"
    with
        id "ddn.examples.umlrem::uc.checkout"
        title "Checkout"
        metadata
            x_usecase
                subjects
                    item
                        id "ddn.examples.umlrem::uc.sys"
                extension_points
                    item "payment"


element "ddn.examples.umlrem::uc.rush" as "uml.usecase"
    with
        id "ddn.examples.umlrem::uc.rush"
        title "Rush order"
        metadata
            x_usecase
                subjects
                    item
                        id "ddn.examples.umlrem::uc.sys"


relation "ddn.examples.umlrem::uc.u1" as "uml.uses"
    with
        id "ddn.examples.umlrem::uc.u1"
        title "Participates in"
        endpoints
            item
                definition
                    id "ddn.examples.umlrem::uc.buyer"
            item
                definition
                    id "ddn.examples.umlrem::uc.checkout"


relation "ddn.examples.umlrem::uc.u2" as "uml.extend"
    with
        id "ddn.examples.umlrem::uc.u2"
        title "rush extends"
        metadata
            x_usecase
                extension_point "payment"
                condition "basket > 200"
        endpoints
            item
                definition
                    id "ddn.examples.umlrem::uc.rush"
            item
                definition
                    id "ddn.examples.umlrem::uc.checkout"


view "objects" as "uml.object@2"
    with
        id "objects"
        title "Objects"
        selection
            include
                item
                    id "ddn.examples.umlrem::obj.customer"
                item
                    id "ddn.examples.umlrem::obj.ada"
                item
                    id "ddn.examples.umlrem::obj.bob"
                item
                    id "ddn.examples.umlrem::obj.link1"
            exclude
                item
                    id "ddn.examples.umlrem::pkg.imp"
                item
                    id "ddn.examples.umlrem::prof.ext"
