element "ddn.examples.umlrem::comm.ui" as "application"
    with
        id "ddn.examples.umlrem::comm.ui"
        title "UI"


element "ddn.examples.umlrem::comm.svc" as "service"
    with
        id "ddn.examples.umlrem::comm.svc"
        title "Service"


relation "ddn.examples.umlrem::comm.m1" as "uml.message"
    with
        id "ddn.examples.umlrem::comm.m1"
        title "request"
        metadata
            x_message
                seq "1"
                time "{t1}"
            x_fragment
                operator "alt"
                operands
                    item
                        guard "ok"
                        messages
                            item
                                id "ddn.examples.umlrem::comm.m1"
                    item
                        guard "else"
                        messages
                            item
                                id "ddn.examples.umlrem::comm.m2"
        endpoints
            item
                definition
                    id "ddn.examples.umlrem::comm.ui"
            item
                definition
                    id "ddn.examples.umlrem::comm.svc"


relation "ddn.examples.umlrem::comm.m2" as "uml.message"
    with
        id "ddn.examples.umlrem::comm.m2"
        title "fail"
        metadata
            x_message
                seq "2"
                duration "{0..2s}"
        endpoints
            item
                definition
                    id "ddn.examples.umlrem::comm.svc"
            item
                definition
                    id "ddn.examples.umlrem::comm.ui"


