    with
        id "ddn.examples.umlrem::io.start"
        title "Start"


element "ddn.examples.umlrem::io.pay" as "flow.process"
    with
        id "ddn.examples.umlrem::io.pay"
        title "Pay"
        metadata
            x_subdiagram
                view "detail"
            x_use
                arguments
                    item "order"
                gates
                    item "in"
                    item "out"


element "ddn.examples.umlrem::io.end" as "flow.end"
    with
        id "ddn.examples.umlrem::io.end"
        title "End"


relation "ddn.examples.umlrem::io.t1" as "flow.next"
    with
        id "ddn.examples.umlrem::io.t1"
        title "Control passes to"
        endpoints
            item
                definition
                    id "ddn.examples.umlrem::io.start"
            item
                definition
                    id "ddn.examples.umlrem::io.pay"


relation "ddn.examples.umlrem::io.t2" as "flow.next"
    with
        id "ddn.examples.umlrem::io.t2"
        title "Control passes to"
        endpoints
            item
                definition
                    id "ddn.examples.umlrem::io.pay"
            item
                definition
                    id "ddn.examples.umlrem::io.end"


