view "components" as "uml.composite@1"
    with
        id "components"
        title "UML component / ports and assembly"
        selection
            include
                item
                    id "ddn.examples.umlcomp::shop.storefront"
                item
                    id "ddn.examples.umlcomp::shop.warehouse"
                item
                    id "ddn.examples.umlcomp::shop.accounts"
                item
                    id "ddn.examples.umlcomp::shop.assembly"
                item
                    id "ddn.examples.umlcomp::shop.delegate"
                item
                    id "ddn.examples.umlcomp::shop.billing"
            exclude
                item
                    id "ddn.examples.umlcomp::structure.c1"
        layout
            center "pins"
            gap 112
            row_gap 112
            algorithm "auto"
        background
            color "#f6f8fc"
        publication
            id "publication:components"

    use "ddn.examples.umlcomp::shop.storefront" named "appearance:components:ddn.examples.umlcomp::shop.storefront"
        with
            id "appearance:components:ddn.examples.umlcomp::shop.storefront"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.umlcomp::shop.warehouse" named "appearance:components:ddn.examples.umlcomp::shop.warehouse"
        with
            id "appearance:components:ddn.examples.umlcomp::shop.warehouse"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.umlcomp::shop.accounts" named "appearance:components:ddn.examples.umlcomp::shop.accounts"
        with
            id "appearance:components:ddn.examples.umlcomp::shop.accounts"

    use "ddn.examples.umlcomp::shop.assembly" named "appearance:components:ddn.examples.umlcomp::shop.assembly"
        with
            id "appearance:components:ddn.examples.umlcomp::shop.assembly"

    use "ddn.examples.umlcomp::shop.delegate" named "appearance:components:ddn.examples.umlcomp::shop.delegate"
        with
            id "appearance:components:ddn.examples.umlcomp::shop.delegate"

    use "ddn.examples.umlcomp::shop.billing" named "appearance:components:ddn.examples.umlcomp::shop.billing"
        with
            id "appearance:components:ddn.examples.umlcomp::shop.billing"


view "structures" as "uml.composite@1"
    with
        id "structures"
        title "UML composite structure / parts and connectors"
        selection
            include
                item
                    id "ddn.examples.umlcomp::structure.order"
                item
                    id "ddn.examples.umlcomp::structure.fulfil"
                item
                    id "ddn.examples.umlcomp::structure.planning"
                item
                    id "ddn.examples.umlcomp::structure.c1"
            exclude
                item
                    id "ddn.examples.umlcomp::shop.assembly"
                item
                    id "ddn.examples.umlcomp::shop.delegate"
                item
                    id "ddn.examples.umlcomp::shop.billing"
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        publication
            id "publication:structures"

    use "ddn.examples.umlcomp::structure.order" named "appearance:structures:ddn.examples.umlcomp::structure.order"
        with
            id "appearance:structures:ddn.examples.umlcomp::structure.order"
            body "columns"
