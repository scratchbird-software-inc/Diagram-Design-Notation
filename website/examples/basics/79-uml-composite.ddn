                    item null
                    item null
                    item null


element "ddn.examples.umlcomp::shop.accounts" as "uml.interface"
    with
        id "ddn.examples.umlcomp::shop.accounts"
        title "Accounts"


relation "ddn.examples.umlcomp::shop.assembly" as "uml.assembly"
    with
        id "ddn.examples.umlcomp::shop.assembly"
        title "Assembly connector"
        endpoints
            item
                definition
                    id "ddn.examples.umlcomp::shop.storefront"
                member
                    id "ddn.examples.umlcomp::shop.storefront.orders_if"
            item
                definition
                    id "ddn.examples.umlcomp::shop.warehouse"
                member
                    id "ddn.examples.umlcomp::shop.warehouse.orders_in"


relation "ddn.examples.umlcomp::shop.delegate" as "uml.delegation"
    with
        id "ddn.examples.umlcomp::shop.delegate"
        title "Delegation connector"
        endpoints
            item
                definition
                    id "ddn.examples.umlcomp::shop.storefront"
                member
                    id "ddn.examples.umlcomp::shop.storefront.web"
            item
                definition
                    id "ddn.examples.umlcomp::shop.storefront"
                member
                    id "ddn.examples.umlcomp::shop.storefront.cart"


relation "ddn.examples.umlcomp::shop.billing" as "uml.provided"
    with
        id "ddn.examples.umlcomp::shop.billing"
        title "Provided interface"
        endpoints
            item
                definition
                    id "ddn.examples.umlcomp::shop.storefront"
            item
                definition
                    id "ddn.examples.umlcomp::shop.accounts"


