relation "ddn.examples.umlcomp::structure.c1" as "uml.connector"
    with
        id "ddn.examples.umlcomp::structure.c1"
        title "Connector"
        metadata
            x_endlabels
                source
                    role "buyer"
                    multiplicity "1"
                target
                    role "picking"
                    multiplicity "0..1"
        endpoints
            item
                definition
                    id "ddn.examples.umlcomp::structure.order"
                member
                    id "ddn.examples.umlcomp::structure.order.customer"
            item
                definition
                    id "ddn.examples.umlcomp::structure.fulfil"
                member
