element "ddn.examples.umlcomp::shop.warehouse" as "uml.component"
    with
        id "ddn.examples.umlcomp::shop.warehouse"
        title "Warehouse"
        members
            item
                id "ddn.examples.umlcomp::shop.warehouse.stock"
            item
                id "ddn.examples.umlcomp::shop.warehouse.orders_in"
        data
            columns
                item
                    id "field"
                    label "field"
                item
                    id "type"
                    label "type"
                item
                    id "domain"
                    label "domain"
                item
                    id "constraint"
                    label "constraint"
                item
                    id "key"
                    label "key"
                item
                    id "comment"
                    label "comment"
            rows
