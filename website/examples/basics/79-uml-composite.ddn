version ddn-next-1

publication "publication:components"
    with
        id "publication:components"
        title "UML component / ports and assembly"
        targets
            item
                target
                    id "components"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:structures"
    with
        id "publication:structures"
        title "UML composite structure / parts and connectors"
        targets
            item
                target
                    id "structures"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.umlcomp::shop.storefront.cart" as "field"
    with
        id "ddn.examples.umlcomp::shop.storefront.cart"
        title "cart"
        metadata
            x_part
                classifier "declared-classifier:Cart"
                multiplicity "1"
        content
            parent
                id "ddn.examples.umlcomp::shop.storefront"
            ordinal 0


element "ddn.examples.umlcomp::shop.storefront.web" as "core::Port"
    with
        id "ddn.examples.umlcomp::shop.storefront.web"
        title "web"
        content
            owner
                id "ddn.examples.umlcomp::shop.storefront"
            direction "input"


element "ddn.examples.umlcomp::shop.storefront.orders_if" as "core::Port"
    with
        id "ddn.examples.umlcomp::shop.storefront.orders_if"
        title "orders_if"
        content
            owner
                id "ddn.examples.umlcomp::shop.storefront"
            direction "output"


element "ddn.examples.umlcomp::shop.storefront" as "uml.component"
    with
        id "ddn.examples.umlcomp::shop.storefront"
        title "Storefront"
        members
            item
                id "ddn.examples.umlcomp::shop.storefront.cart"
            item
                id "ddn.examples.umlcomp::shop.storefront.web"
            item
                id "ddn.examples.umlcomp::shop.storefront.orders_if"
        data
            columns
                item
                    id "field"
                    label "field"
                item
                    id "type"
                    label "type"
                item
                    id "domain"
                    label "domain"
                item
                    id "constraint"
                    label "constraint"
                item
                    id "key"
                    label "key"
                item
                    id "comment"
                    label "comment"
            rows
                item
                    item "cart"
                    item null
                    item null
                    item null
                    item null
                    item null


element "ddn.examples.umlcomp::shop.warehouse.stock" as "field"
    with
        id "ddn.examples.umlcomp::shop.warehouse.stock"
        title "stock"
        metadata
            x_part
                classifier "declared-classifier:Stock"
                multiplicity "0..*"
        content
            parent
                id "ddn.examples.umlcomp::shop.warehouse"
            ordinal 0


element "ddn.examples.umlcomp::shop.warehouse.orders_in" as "core::Port"
    with
        id "ddn.examples.umlcomp::shop.warehouse.orders_in"
        title "orders_in"
        content
            owner
                id "ddn.examples.umlcomp::shop.warehouse"
