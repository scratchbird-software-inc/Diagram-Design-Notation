relation "ddn.examples.umlclass::fleet.employs" as "uml.association"
    with
        id "ddn.examples.umlclass::fleet.employs"
        title "employs"
        metadata
            x_endlabels
                source
                    role "employer"
                    multiplicity "1"
                    qualifier "employeeId"
                target
                    role "employee"
                    multiplicity "0..*"
        endpoints
            item
                definition
                    id "ddn.examples.umlclass::fleet.company"
            item
                definition
                    id "ddn.examples.umlclass::fleet.person"
        qualifiers
            target
                mark "hollow-diamond"
        notes
            item
                title "Additional source details"
                text
                    {
                      "target_mark": "hollow_diamond"
                    }
                format "plain"


