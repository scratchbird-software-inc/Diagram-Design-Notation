view "strategic" as "uaf.strategic@1"
    with
        id "strategic"
        title "St — Strategic"
        selection
            include
                item
                    id "ddn.examples.uaf::st.cap"
                item
                    id "ddn.examples.uaf::st.cap2"
                item
                    id "ddn.examples.uaf::st.goal"
                item
                    id "ddn.examples.uaf::st.vision"
                item
                    id "ddn.examples.uaf::st.phase"
                item
                    id "ddn.examples.uaf::st.d1"
                item
                    id "ddn.examples.uaf::st.s1"
                item
                    id "ddn.examples.uaf::st.m1"
            exclude
                item
                    id "ddn.examples.uaf::op.p1"
                item
                    id "ddn.examples.uaf::op.p2"
                item
                    id "ddn.examples.uaf::op.m1"
                item
                    id "ddn.examples.uaf::op.n1"
                item
                    id "ddn.examples.uaf::svc.e1"
                item
                    id "ddn.examples.uaf::svc.m1"
                item
                    id "ddn.examples.uaf::svc.c1"
                item
                    id "ddn.examples.uaf::sys.p1"
                item
                    id "ddn.examples.uaf::sys.m1"
                item
                    id "ddn.examples.uaf::sys.s1"
                item
                    id "ddn.examples.uaf::per.a1"
