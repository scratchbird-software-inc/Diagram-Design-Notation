                title "Additional source details"
                text
                    {
                      "meaning": "Identifies a customer in the registry"
                    }
                format "plain"


element "ddn.examples.customer-data::model.customers" as "sample"
    with
        id "ddn.examples.customer-data::model.customers"
        title "Synthetic customer records"
        properties
            mode "synthetic"
            columns
                item
