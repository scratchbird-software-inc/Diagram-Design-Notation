                item
                    id "ddn.examples.customer-data::model.customer.display_name"
                item
                    id "ddn.examples.customer-data::model.customer.status"
            rows
                item
                    item "C001"
                    item "Customer A"
                    item "Active"
                item
                    item "C002"
                    item "Customer B"
                    item "Suspended"
        data
            columns
                item
                    id "column-0"
                    label "customer_id"
                item
                    id "column-1"
                    label "display_name"
                item
                    id "column-2"
                    label "status"
            rows
                item
                    item "C001"
                    item "Customer A"
