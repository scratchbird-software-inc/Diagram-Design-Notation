view "overview" as "ddn@1"
    with
        id "overview"
        title "Customer data / a shared model"
        selection
            include
                item
                    id "urn:ddn:example:customer"
                item
                    id "ddn.examples.customer-data::model.order"
                item
                    id "ddn.examples.customer-data::model.customer_identifier"
                item
                    id "ddn.examples.customer-data::model.customers"
                item
                    id "ddn.examples.customer-data::model.order_customer"
                item
                    id "ddn.examples.customer-data::model.customer_domain"
                item
                    id "ddn.examples.customer-data::model.order_domain"
        layout
            algorithm "grid"
            gap 80
        legend
            mode "numbers"
            width 280
            keys
                model.order_customer "7"
                model.customer_domain "12"
                model.order_domain "18"
        background
            color "#f6f8fc"
        publication
            id "publication:overview"

    use "urn:ddn:example:customer" named "appearance:overview:urn:ddn:example:customer"
        with
            id "appearance:overview:urn:ddn:example:customer"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.customer-data::model.order" named "appearance:overview:ddn.examples.customer-data::model.order"
        with
            id "appearance:overview:ddn.examples.customer-data::model.order"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.examples.customer-data::model.customer_identifier" named "appearance:overview:ddn.examples.customer-data::model.customer_identifier"
        with
            id "appearance:overview:ddn.examples.customer-data::model.customer_identifier"
            body "notes"

    use "ddn.examples.customer-data::model.customers" named "appearance:overview:ddn.examples.customer-data::model.customers"
        with
            id "appearance:overview:ddn.examples.customer-data::model.customers"
            body "columns"

    use "ddn.examples.customer-data::model.order_customer" named "appearance:overview:ddn.examples.customer-data::model.order_customer"
        with
            id "appearance:overview:ddn.examples.customer-data::model.order_customer"

    use "ddn.examples.customer-data::model.customer_domain" named "appearance:overview:ddn.examples.customer-data::model.customer_domain"
        with
            id "appearance:overview:ddn.examples.customer-data::model.customer_domain"

    use "ddn.examples.customer-data::model.order_domain" named "appearance:overview:ddn.examples.customer-data::model.order_domain"
        with
            id "appearance:overview:ddn.examples.customer-data::model.order_domain"


