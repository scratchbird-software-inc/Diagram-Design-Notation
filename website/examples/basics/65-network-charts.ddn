version ddn-next-1

publication "publication:arc"
    with
        id "publication:arc"
        title "Service calls / arc diagram"
        targets
            item
                target
                    id "arc"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:force"
    with
        id "publication:force"
        title "Service calls / force-directed"
        targets
            item
                target
                    id "force"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:edgebundle"
    with
        id "publication:edgebundle"
        title "Deployment routes / edge bundling"
        targets
            item
                target
                    id "edgebundle"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


element "ddn.examples.network-charts::calls.e1" as "record"
    with
        id "ddn.examples.network-charts::calls.e1"
        title "web → api"
        metadata
            x_record
                from "web"
                to "api"
                n 320
                unit "req/min"


