view "arc" as "chart.arc@1"
    with
        id "arc"
        title "Service calls / arc diagram"
        selection
            include empty list
        layout
            center "pins"
            algorithm "auto"
        background
            color "#f6f8fc"
        projection
            options
                records
                    item
                        id "ddn.examples.network-charts::calls.e1"
                    item
                        id "ddn.examples.network-charts::calls.e2"
                    item
                        id "ddn.examples.network-charts::calls.e3"
                    item
                        id "ddn.examples.network-charts::calls.e4"
                    item
                        id "ddn.examples.network-charts::calls.e5"
                    item
                        id "ddn.examples.network-charts::calls.e6"
                    item
                        id "ddn.examples.network-charts::calls.e7"
                    item
                        id "ddn.examples.network-charts::calls.e8"
                mark "arc"
                x "metadata.x_record.from"
                target "metadata.x_record.to"
                y "metadata.x_record.n"
                unit "req/min"
                width 1120
                height 620


