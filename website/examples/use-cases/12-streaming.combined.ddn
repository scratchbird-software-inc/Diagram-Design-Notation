ddn "0.5";

module "ddn.usecases.views.streaming";
// How can one change stream feed independent projections?
// Fixed teaching layout: coordinates belong to this view only.
view diagram "12 / Event publication and consumers" {
    data: [@ddn.usecases.flow.stream, @ddn.usecases.commerce.tables, @ddn.usecases.commerce.domains];
    format: @ddn.usecases.formats.shared.technical;
    style: @ddn.usecases.formats.shared.classic;
    layout: @ddn.usecases.formats.shared.teaching;
    select: [@ddn.usecases.flow.stream.source, @ddn.usecases.flow.stream.capture, @ddn.usecases.flow.stream.topic, @ddn.usecases.flow.stream.hist_job, @ddn.usecases.flow.stream.search_job, @ddn.usecases.flow.stream.history, @ddn.usecases.flow.stream.search];
    publication { width: 1640px; height: 1090px; }
    legend { keys: { "stream.r_capture": 1, "stream.r_publish": 2, "stream.r_history_delivery": 3, "stream.r_search_delivery": 4, "stream.r_history_write": 5, "stream.r_search_write": 6 }; }
    display { fields: none; badges: none; }

}

module "ddn.usecases.commerce";
// All names, records and architectures in this catalogue are synthetic teaching examples.

data concepts {
    entity customer "Customer";
    entity order "Order";
    entity shipment "Shipment";
    assoc r_places "places" @customer [one] -> @order [zeromany];
    assoc r_ships "fulfilled by" @order [one] -> @shipment [zeromany];
}

data domains {
    domain customer_id "Customer identifier" {
        kind: domain;
        meaning: "Identifies a customer in the registry.";
        representation: undecided;
    }
    domain order_id "Order identifier" {
        kind: domain;
        meaning: "Identifies an order in the order book.";
        representation: undecided;
    }
}

data tables {
    table customer "Customer" {
        level: definition;
        workload: [oltp];
        role: authoritative;
        description: "Authority for the customer registry, not for every customer attribute in all systems.";
        fields {
            customer_id { key: primary; domain: @domains.customer_id; }
            display_name;
            status;
        }
    }
    table orders "Orders" {
        level: definition;
        workload: [oltp];
        fields {
            order_id { key: primary; domain: @domains.order_id; }
            customer_id { domain: @domains.customer_id; }
            ordered_at;
        }
    }
    table line "Order line" {
        level: definition;
        workload: [oltp];
        fields {
            line_id { key: primary; }
            order_id;
            sku;
            quantity;
        }
    }
    ref r_line_order @line.order_id [many] -> @orders.order_id [one] {
        enforcement: undecided;
    }
    ref r_order_customer @orders.customer_id [zeromany] -> @customer.customer_id [one] {
        enforcement: undecided;
    }
}

module "ddn.usecases.flow";
// All names, records and architectures in this catalogue are synthetic teaching examples.

data dfd {
    dataset incoming "Incoming orders";
    activity validate "Validate orders" {
        description: "Transform and validate; no implied transaction boundary.";
    }
    dataset accepted "Accepted orders";
    read r_input @incoming -> @validate;
    write r_output @validate -> @accepted;
}

data stream {
    table source "Customer / production" {
        level: instance;
        role: authoritative;
        workload: [oltp];
    }
    activity capture "Capture changes";
    topic topic "customer.changed" {
        workload: [streaming];
    }
    activity hist_job "Build customer history";
    activity search_job "Build customer search";
    history history "Customer history" {
        temporal: bitemporal;
        role: derived;
    }
    search_index search "Customer search" {
        role: derived;
    }
    instance r_source_definition @source -> @ddn.usecases.commerce.tables.customer;
    capture r_capture @source -> @capture {
        capture: cdc;
    }
    publish r_publish @capture -> @topic {
        transport: "Kafka";
    }
    deliver r_history_delivery @topic -> @hist_job {
        scope: "history consumer";
    }
    deliver r_search_delivery @topic -> @search_job {
        scope: "search consumer";
    }
    write r_history_write @hist_job -> @history;
    write r_search_write @search_job -> @search;
}

module "ddn.usecases.formats";
format shared {
    notation core;
    style classic;
    style sketch { look: handDrawn; roughness: 1.8; hachure: true; }
    style neo { look: neo; }
    layout row { algorithm: grid; gap: 120px; }
    layout column { algorithm: grid; columns: 1; gap: 120px; direction: down; }
    layout teaching { algorithm: manual; gap: 120px; }
    display full;
    display compact { fields: none; maturity: none; }
    publication figure { size: content; width: 1580px; height: 440px; margin: 30px; }
    legend numbered { mode: numbers; width: 340px; }
    bundle technical {
        notation: @core;
        style: @classic;
        layout: @row;
        display: @full;
        publication: @figure;
        legend: @numbered;
    }
}
