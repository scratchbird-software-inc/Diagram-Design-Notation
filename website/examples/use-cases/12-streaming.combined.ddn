ddn "0.5";

module "ddn.usecases.views.streaming";
// How can one change stream feed independent projections?
// Fixed teaching layout: coordinates belong to this view only.
view diagram "12 / Event publication and consumers" {
    data: [@ddn.usecases.flow.stream, @ddn.usecases.commerce.tables, @ddn.usecases.commerce.domains];
    format: @ddn.usecases.formats.shared.technical;
    style: @ddn.usecases.formats.shared.classic;
    layout: @ddn.usecases.formats.shared.teaching;
    select: [@ddn.usecases.flow.stream.source, @ddn.usecases.flow.stream.capture, @ddn.usecases.flow.stream.topic, @ddn.usecases.flow.stream.hist_job, @ddn.usecases.flow.stream.search_job, @ddn.usecases.flow.stream.history, @ddn.usecases.flow.stream.search];
    publication { width: 1640px; height: 1090px; }
    legend { keys: { "stream.r_capture": 1, "stream.r_publish": 2, "stream.r_history_delivery": 3, "stream.r_search_delivery": 4, "stream.r_history_write": 5, "stream.r_search_write": 6 }; }
    display { fields: none; badges: none; }

}

module "ddn.usecases.commerce";
// All names, records and architectures in this catalogue are synthetic teaching examples.

data concepts {
    object customer "Customer" {
        kind: entity;
    }
    object order "Order" {
        kind: entity;
    }
    object shipment "Shipment" {
        kind: entity;
    }
    relation r_places "places" @customer -> @order { kind: assoc; source_mark: one; target_mark: zeromany; }
    relation r_ships "fulfilled by" @order -> @shipment { kind: assoc; source_mark: one; target_mark: zeromany; }
}

data domains {
    domain customer_id "Customer identifier" {
        kind: domain;
        meaning: "Identifies a customer in the registry.";
        representation: undecided;
    }
    domain order_id "Order identifier" {
        kind: domain;
        meaning: "Identifies an order in the order book.";
        representation: undecided;
    }
}

data tables {
    object customer "Customer" {
        kind: table;
        level: definition;
        workload: [oltp];
        role: authoritative;
        description: "Authority for the customer registry, not for every customer attribute in all systems.";
        fields {
            field customer_id { key: primary; domain: @domains.customer_id; }
            field display_name;
            field status;
        }
    }
    object orders "Orders" {
        kind: table;
        level: definition;
        workload: [oltp];
        fields {
            field order_id { key: primary; domain: @domains.order_id; }
            field customer_id { domain: @domains.customer_id; }
            field ordered_at;
        }
    }
    object line "Order line" {
        kind: table;
        level: definition;
        workload: [oltp];
        fields {
            field line_id { key: primary; }
            field order_id;
            field sku;
            field quantity;
        }
    }
    relation r_line_order @line.order_id -> @orders.order_id { kind: ref; source_mark: many; target_mark: one; enforcement: undecided; }
    relation r_order_customer @orders.customer_id -> @customer.customer_id { kind: ref; source_mark: zeromany; target_mark: one; enforcement: undecided; }
}

module "ddn.usecases.flow";
// All names, records and architectures in this catalogue are synthetic teaching examples.

data dfd {
    object incoming "Incoming orders" {
        kind: dataset;
    }
    object validate "Validate orders" {
        kind: activity;
        description: "Transform and validate; no implied transaction boundary.";
    }
    object accepted "Accepted orders" {
        kind: dataset;
    }
    relation r_input @incoming -> @validate { kind: read; }
    relation r_output @validate -> @accepted { kind: write; }
}

data stream {
    object source "Customer / production" {
        kind: table;
        level: instance;
        role: authoritative;
        workload: [oltp];
    }
    object capture "Capture changes" {
        kind: activity;
    }
    object topic "customer.changed" {
        kind: topic;
        workload: [streaming];
    }
    object hist_job "Build customer history" {
        kind: activity;
    }
    object search_job "Build customer search" {
        kind: activity;
    }
    object history "Customer history" {
        kind: history;
        temporal: bitemporal;
        role: derived;
    }
    object search "Customer search" {
        kind: search_index;
        role: derived;
    }
    relation r_source_definition @source -> @ddn.usecases.commerce.tables.customer { kind: instance; }
    relation r_capture @source -> @capture { kind: capture; capture: cdc; }
    relation r_publish @capture -> @topic { kind: publish; transport: "Kafka"; }
    relation r_history_delivery @topic -> @hist_job { kind: deliver; scope: "history consumer"; }
    relation r_search_delivery @topic -> @search_job { kind: deliver; scope: "search consumer"; }
    relation r_history_write @hist_job -> @history { kind: write; }
    relation r_search_write @search_job -> @search { kind: write; }
}

module "ddn.usecases.formats";
format shared {
    notation core;
    style classic;
    style sketch { look: handDrawn; roughness: 1.8; hachure: true; }
    style neo { look: neo; }
    layout row { algorithm: grid; gap: 120px; }
    layout column { algorithm: grid; columns: 1; gap: 120px; direction: down; }
    layout teaching { algorithm: manual; gap: 120px; }
    display full;
    display compact { fields: none; maturity: none; }
    publication figure { size: content; width: 1580px; height: 440px; margin: 30px; }
    legend numbered { mode: numbers; width: 340px; }
    bundle technical {
        notation: @core;
        style: @classic;
        layout: @row;
        display: @full;
        publication: @figure;
        legend: @numbered;
    }
}
