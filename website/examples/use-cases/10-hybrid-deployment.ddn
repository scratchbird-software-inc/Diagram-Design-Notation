                    id "ddn.usecases.deployment::model.cloud"


relation "ddn.usecases.deployment::model.r_replication" as "replicate"
    with
        id "ddn.usecases.deployment::model.r_replication"
        title "replicates to"
        endpoints
            item
                definition
                    id "ddn.usecases.deployment::model.primary"
            item
                definition
                    id "ddn.usecases.deployment::model.follower"


view "diagram" as "ddn@1"
    with
        id "diagram"
        title "10 / Shards, copies and placement"
        selection
            include
                item
                    id "ddn.usecases.commerce::tables.orders"
                item
                    id "ddn.usecases.deployment::model.shard"
                item
                    id "ddn.usecases.deployment::model.primary"
                item
                    id "ddn.usecases.deployment::model.follower"
                item
                    id "ddn.usecases.deployment::model.local"
                item
                    id "ddn.usecases.deployment::model.cloud"
                item
                    id "ddn.usecases.deployment::model.r_part"
                item
                    id "ddn.usecases.deployment::model.r_primary_fragment"
                item
                    id "ddn.usecases.deployment::model.r_follower_fragment"
                item
                    id "ddn.usecases.deployment::model.r_primary_host"
                item
                    id "ddn.usecases.deployment::model.r_follower_host"
                item
                    id "ddn.usecases.deployment::model.r_replication"
            exclude
                item
                    id "ddn.usecases.commerce::tables.r_line_order"
                item
                    id "ddn.usecases.commerce::tables.r_order_customer"
        layout
            algorithm "manual"
            gap 120
        display
            fields "none"
            badges "none"
        legend
            mode "numbers"
            width 340
            keys
                model.r_part "1"
                model.r_primary_fragment "2"
                model.r_follower_fragment "3"
                model.r_primary_host "4"
                model.r_follower_host "5"
                model.r_replication "6"
        background
            color "#f6f8fc"
        regions
            item
                id "ddn.usecases.views.hybrid-deployment::diagram.local"
                name "ON-PREMISES / placement view"
                members
                    item
                        id "ddn.usecases.deployment::model.primary"
                    item
                        id "ddn.usecases.deployment::model.local"
            item
                id "ddn.usecases.views.hybrid-deployment::diagram.cloud"
                name "CLOUD / placement view"
                members
                    item
                        id "ddn.usecases.deployment::model.follower"
                    item
                        id "ddn.usecases.deployment::model.cloud"
        publication
            id "publication:diagram"

    use "ddn.usecases.commerce::tables.orders" named "appearance:diagram:ddn.usecases.commerce::tables.orders"
        with
            id "appearance:diagram:ddn.usecases.commerce::tables.orders"
            body "title"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.usecases.deployment::model.shard" named "appearance:diagram:ddn.usecases.deployment::model.shard"
        with
            id "appearance:diagram:ddn.usecases.deployment::model.shard"

    use "ddn.usecases.deployment::model.primary" named "appearance:diagram:ddn.usecases.deployment::model.primary"
        with
            id "appearance:diagram:ddn.usecases.deployment::model.primary"

    use "ddn.usecases.deployment::model.follower" named "appearance:diagram:ddn.usecases.deployment::model.follower"
        with
            id "appearance:diagram:ddn.usecases.deployment::model.follower"

    use "ddn.usecases.deployment::model.local" named "appearance:diagram:ddn.usecases.deployment::model.local"
        with
            id "appearance:diagram:ddn.usecases.deployment::model.local"

    use "ddn.usecases.deployment::model.cloud" named "appearance:diagram:ddn.usecases.deployment::model.cloud"
        with
            id "appearance:diagram:ddn.usecases.deployment::model.cloud"

    use "ddn.usecases.deployment::model.r_part" named "appearance:diagram:ddn.usecases.deployment::model.r_part"
        with
            id "appearance:diagram:ddn.usecases.deployment::model.r_part"

    use "ddn.usecases.deployment::model.r_primary_fragment" named "appearance:diagram:ddn.usecases.deployment::model.r_primary_fragment"
        with
            id "appearance:diagram:ddn.usecases.deployment::model.r_primary_fragment"

    use "ddn.usecases.deployment::model.r_follower_fragment" named "appearance:diagram:ddn.usecases.deployment::model.r_follower_fragment"
        with
            id "appearance:diagram:ddn.usecases.deployment::model.r_follower_fragment"

    use "ddn.usecases.deployment::model.r_primary_host" named "appearance:diagram:ddn.usecases.deployment::model.r_primary_host"
        with
            id "appearance:diagram:ddn.usecases.deployment::model.r_primary_host"

    use "ddn.usecases.deployment::model.r_follower_host" named "appearance:diagram:ddn.usecases.deployment::model.r_follower_host"
        with
            id "appearance:diagram:ddn.usecases.deployment::model.r_follower_host"

    use "ddn.usecases.deployment::model.r_replication" named "appearance:diagram:ddn.usecases.deployment::model.r_replication"
        with
            id "appearance:diagram:ddn.usecases.deployment::model.r_replication"
