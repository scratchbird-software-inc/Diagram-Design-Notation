        properties
            source_mark "zeromany"
            target_mark "one"
        endpoints
            item
                definition
                    id "ddn.usecases.commerce::tables.orders"
                member
                    id "ddn.usecases.commerce::tables.orders.customer_id"
            item
                definition
                    id "ddn.usecases.commerce::tables.customer"
                member
                    id "ddn.usecases.commerce::tables.customer.customer_id"


relation "ddn.usecases.deployment::model.r_part" as "part"
    with
        id "ddn.usecases.deployment::model.r_part"
        title "partitioned into"
        endpoints
            item
                definition
                    id "ddn.usecases.commerce::tables.orders"
            item
                definition
                    id "ddn.usecases.deployment::model.shard"


relation "ddn.usecases.deployment::model.r_primary_fragment" as "realizes"
    with
        id "ddn.usecases.deployment::model.r_primary_fragment"
        title "realizes partition"
        endpoints
            item
                definition
                    id "ddn.usecases.deployment::model.primary"
            item
                definition
                    id "ddn.usecases.deployment::model.shard"


relation "ddn.usecases.deployment::model.r_follower_fragment" as "realizes"
    with
        id "ddn.usecases.deployment::model.r_follower_fragment"
        title "realizes partition"
        endpoints
            item
                definition
                    id "ddn.usecases.deployment::model.follower"
            item
                definition
                    id "ddn.usecases.deployment::model.shard"


relation "ddn.usecases.deployment::model.r_primary_host" as "placed"
    with
        id "ddn.usecases.deployment::model.r_primary_host"
        title "placed on"
        endpoints
            item
