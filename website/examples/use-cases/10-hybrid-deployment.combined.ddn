ddn "0.5";

module "ddn.usecases.views.hybrid-deployment";
// Which fragment is copied, and where are its copies?
// Fixed teaching layout: coordinates belong to this view only.
view diagram "10 / Shards, copies and placement" {
    data: [@ddn.usecases.commerce.tables, @ddn.usecases.deployment.model, @ddn.usecases.commerce.domains];
    format: @ddn.usecases.formats.shared.technical;
    style: @ddn.usecases.formats.shared.classic;
    layout: @ddn.usecases.formats.shared.teaching;
    select: [@ddn.usecases.commerce.tables.orders, @ddn.usecases.deployment.model.shard, @ddn.usecases.deployment.model.primary, @ddn.usecases.deployment.model.follower, @ddn.usecases.deployment.model.local, @ddn.usecases.deployment.model.cloud];
    publication { width: 1600px; height: 1080px; }
    legend { keys: { "model.r_part": 1, "model.r_primary_fragment": 2, "model.r_follower_fragment": 3, "model.r_primary_host": 4, "model.r_follower_host": 5, "model.r_replication": 6 }; }
    display { fields: none; badges: none; }

    frame local "ON-PREMISES / placement view" { members: [@ddn.usecases.deployment.model.primary, @ddn.usecases.deployment.model.local]; }
    frame cloud "CLOUD / placement view" { members: [@ddn.usecases.deployment.model.follower, @ddn.usecases.deployment.model.cloud]; }
}

module "ddn.usecases.commerce";
// All names, records and architectures in this catalogue are synthetic teaching examples.

data concepts {
    object customer "Customer" {
        kind: entity;
    }
    object order "Order" {
        kind: entity;
    }
    object shipment "Shipment" {
        kind: entity;
    }
    relation r_places "places" @customer -> @order { kind: assoc; source_mark: one; target_mark: zeromany; }
    relation r_ships "fulfilled by" @order -> @shipment { kind: assoc; source_mark: one; target_mark: zeromany; }
}

data domains {
    domain customer_id "Customer identifier" {
        kind: domain;
        meaning: "Identifies a customer in the registry.";
        representation: undecided;
    }
    domain order_id "Order identifier" {
        kind: domain;
        meaning: "Identifies an order in the order book.";
        representation: undecided;
    }
}

data tables {
    object customer "Customer" {
        kind: table;
        level: definition;
        workload: [oltp];
        role: authoritative;
        description: "Authority for the customer registry, not for every customer attribute in all systems.";
        fields {
            field customer_id { key: primary; domain: @domains.customer_id; }
            field display_name;
            field status;
        }
    }
    object orders "Orders" {
        kind: table;
        level: definition;
        workload: [oltp];
        fields {
            field order_id { key: primary; domain: @domains.order_id; }
            field customer_id { domain: @domains.customer_id; }
            field ordered_at;
        }
    }
    object line "Order line" {
        kind: table;
        level: definition;
        workload: [oltp];
        fields {
            field line_id { key: primary; }
            field order_id;
            field sku;
            field quantity;
        }
    }
    relation r_line_order @line.order_id -> @orders.order_id { kind: ref; source_mark: many; target_mark: one; enforcement: undecided; }
    relation r_order_customer @orders.customer_id -> @customer.customer_id { kind: ref; source_mark: zeromany; target_mark: one; enforcement: undecided; }
}

module "ddn.usecases.deployment";
// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    object shard "Orders / shard A" {
        kind: shard;
        level: fragment;
    }
    object primary "Primary copy" {
        kind: replica;
        level: copy;
        role: primary;
        location: local;
    }
    object follower "Follower copy" {
        kind: replica;
        level: copy;
        role: follower;
        location: cloud;
    }
    object local "Local SQL service" {
        kind: service;
        level: instance;
        location: local;
    }
    object cloud "Cloud SQL service" {
        kind: service;
        level: instance;
        location: cloud;
    }
    relation r_part @ddn.usecases.commerce.tables.orders -> @shard { kind: part; }
    relation r_primary_fragment @primary -> @shard { kind: realizes; }
    relation r_follower_fragment @follower -> @shard { kind: realizes; }
    relation r_primary_host @primary -> @local { kind: placed; }
    relation r_follower_host @follower -> @cloud { kind: placed; }
    relation r_replication @primary -> @follower { kind: replicate; delivery: undecided; }
}

module "ddn.usecases.formats";
format shared {
    notation core;
    style classic;
    style sketch { look: handDrawn; roughness: 1.8; hachure: true; }
    style neo { look: neo; }
    layout row { algorithm: grid; gap: 120px; }
    layout column { algorithm: grid; columns: 1; gap: 120px; direction: down; }
    layout teaching { algorithm: manual; gap: 120px; }
    display full;
    display compact { fields: none; maturity: none; }
    publication figure { size: content; width: 1580px; height: 440px; margin: 30px; }
    legend numbered { mode: numbers; width: 340px; }
    bundle technical {
        notation: @core;
        style: @classic;
        layout: @row;
        display: @full;
        publication: @figure;
        legend: @numbered;
    }
}
