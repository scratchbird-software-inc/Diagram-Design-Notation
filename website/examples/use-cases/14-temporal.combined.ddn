ddn "0.5";

module "ddn.usecases.views.temporal";
// When did a fact apply, and when did we know it?
// Fixed teaching layout: coordinates belong to this view only.
view diagram "14 / Valid time and recorded time" {
    data: [@ddn.usecases.temporal.model];
    format: @ddn.usecases.formats.shared.technical;
    style: @ddn.usecases.formats.shared.classic;
    layout: @ddn.usecases.formats.shared.teaching;
    select: [@ddn.usecases.temporal.model.history, @ddn.usecases.temporal.model.example];
    publication { width: 1700px; height: 850px; }
    legend { keys: { "model.r_example": 1 }; }

}

module "ddn.usecases.formats";
format shared {
    notation core;
    style classic;
    style sketch { look: handDrawn; roughness: 1.8; hachure: true; }
    style neo { look: neo; }
    layout row { algorithm: grid; gap: 120px; }
    layout column { algorithm: grid; columns: 1; gap: 120px; direction: down; }
    layout teaching { algorithm: manual; gap: 120px; }
    display full;
    display compact { fields: none; maturity: none; }
    publication figure { size: content; width: 1580px; height: 440px; margin: 30px; }
    legend numbered { mode: numbers; width: 340px; }
    bundle technical {
        notation: @core;
        style: @classic;
        layout: @row;
        display: @full;
        publication: @figure;
        legend: @numbered;
    }
}

module "ddn.usecases.temporal";
// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    object history "Customer status history" {
        kind: history;
        temporal: bitemporal;
        time: { valid: "business-effective civil date", recorded: "warehouse-known civil date", retention: undecided };
        fields {
            field customer_id;
            field status;
            field valid_from;
            field valid_to;
            field recorded_from;
            field recorded_to;
        }
    }
    sample example "Correction received on March 5" {
        kind: sample;
        mode: synthetic;
        columns: [@history.customer_id, @history.status, @history.valid_from, @history.valid_to, @history.recorded_from, @history.recorded_to];
        rows: [["C001", "Active", "2026-03-01", null, "2026-03-01", "2026-03-05"], ["C001", "Active", "2026-03-01", "2026-03-03", "2026-03-05", null], ["C001", "Suspended", "2026-03-03", null, "2026-03-05", null]];
    }
    relation r_example @example -> @history { kind: example; }
}
