ddn "0.5";

module "ddn.usecases.views.whiteboard";
// What are the main things in this discussion?
// Automatic grid placement: no absolute positions or waypoints.
view diagram "01 / Whiteboard sketch" {
    data: [@ddn.usecases.sketch.model];
    format: @ddn.usecases.formats.shared.technical;
    style: @ddn.usecases.formats.shared.sketch;
    layout: @ddn.usecases.formats.shared.row;
    select: [@ddn.usecases.sketch.model.customer, @ddn.usecases.sketch.model.order, @ddn.usecases.sketch.model.shipment];
    publication { width: 1580px; height: 440px; }
    legend { keys: { "model.r_a": 1, "model.r_b": 2 }; }
}

module "ddn.usecases.formats";
format shared {
    notation core;
    style classic;
    style sketch { look: handDrawn; roughness: 1.8; hachure: true; }
    style neo { look: neo; }
    layout row { algorithm: grid; gap: 120px; }
    layout column { algorithm: grid; columns: 1; gap: 120px; direction: down; }
    layout teaching { algorithm: manual; gap: 120px; }
    display full;
    display compact { fields: none; maturity: none; }
    publication figure { size: content; width: 1580px; height: 440px; margin: 30px; }
    legend numbered { mode: numbers; width: 340px; }
    bundle technical {
        notation: @core;
        style: @classic;
        layout: @row;
        display: @full;
        publication: @figure;
        legend: @numbered;
    }
}

module "ddn.usecases.sketch";
// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    object customer "Customer" {
        kind: object;
    }
    object order "Order" {
        kind: object;
    }
    object shipment "Shipment" {
        kind: object;
    }
    relation r_a "places" @customer -> @order { kind: assoc; }
    relation r_b "fulfilled by" @order -> @shipment { kind: assoc; }
}
