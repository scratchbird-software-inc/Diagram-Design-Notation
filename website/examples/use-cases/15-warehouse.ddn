view "diagram" as "ddn@1"
    with
        id "diagram"
        title "15 / Dimensional warehouse"
        selection
            include
                item
                    id "ddn.usecases.warehouse::model.fact"
                item
                    id "ddn.usecases.warehouse::model.customer"
                item
                    id "ddn.usecases.warehouse::model.product"
                item
                    id "ddn.usecases.warehouse::model.date"
                item
                    id "ddn.usecases.warehouse::model.grain"
                item
                    id "ddn.usecases.warehouse::model.r_c"
                item
                    id "ddn.usecases.warehouse::model.r_p"
                item
                    id "ddn.usecases.warehouse::model.r_d"
        layout
            algorithm "manual"
            gap 120
        legend
            mode "numbers"
            width 340
            keys
                model.r_c "1"
                model.r_p "2"
                model.r_d "3"
        background
            color "#f6f8fc"
        publication
            id "publication:diagram"

    use "ddn.usecases.warehouse::model.fact" named "appearance:diagram:ddn.usecases.warehouse::model.fact"
