ddn "0.5";
module "ddn.usecases.security";

// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    dataset source "Contact records" {
        level: instance;
        fields {
            customer_id;
            email;
        }
    }
    activity mask "Aggregate + remove IDs";
    dataset export "Proposed cohort export" {
        level: instance;
        fields {
            cohort_id;
            count;
        }
    }
    security_zone restricted "Restricted processing";
    security_zone egress "Review before release";
    read r_input @source -> @mask;
    write r_output @mask -> @export;
}
