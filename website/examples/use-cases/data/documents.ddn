ddn "0.5";
module "ddn.usecases.documents";

// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    collection profiles "Customer profile" {
        fields {
            customer_id;
            contacts { shape: array; }
        }
    }
    array contacts "Contacts array" {
        description: "Embedded collection value, not an independently stored table.";
    }
    document contact "Contact item" {
        fields {
            kind;
            value;
            preferred { presence: optional; nullable: false; }
        }
    }
    emb r_a @profiles -> @contacts;
    mem r_b "item shape" @contacts -> @contact;
}
