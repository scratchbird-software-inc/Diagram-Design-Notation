ddn "0.5";
module "ddn.usecases.keyed";

// All names, records and architectures in this catalogue are synthetic teaching examples.

data kv {
    identity key "Session key" {
        description: "Scope: one active login session.";
    }
    key_value sessions "Session store";
    record value "Session value" {
        fields {
            user_id;
            expires_at;
            cart_id;
        }
    }
    ident r_a @key -> @sessions;
    mem r_b "value shape" @sessions -> @value;
}

data wide {
    domain key "Device identifier" {
        kind: domain;
        meaning: "Identifies the producing sensor.";
        representation: undecided;
    }
    wide_column readings "Readings by device" {
        workload: [streaming];
        fields {
            device_id { key: partition; }
            measured_at { key: clustering; }
            value;
        }
    }
    qry query "Latest device readings" {
        description: "Access pattern; not a claim that a database query has been executed.";
    }
    relation r_a @readings.device_id -> @key { kind: domain; }
    depends r_b @query -> @readings;
}
