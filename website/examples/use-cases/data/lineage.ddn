ddn "0.5";
module "ddn.usecases.lineage";
import "commerce.ddn" as commerce;

// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    dataset daily "Daily order totals" {
        role: derived;
        workload: [olap];
        fields {
            business_date;
            order_count;
        }
    }
    dashboard report "Operations dashboard";
    aggregates r_aggregate @commerce.tables.orders -> @daily;
    report r_report @daily -> @report;
}
