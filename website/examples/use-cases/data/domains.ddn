ddn "0.5";
module "ddn.usecases.domains";
import "commerce.ddn" as commerce;

// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    table support "Support ticket" {
        fields {
            ticket_id;
            account_ref;
        }
    }
    binding binding "Customer ID / SQL" {
        platform: "SQL target not selected";
        representation: undecided;
    }
    relation r_order_domain @commerce.tables.orders.customer_id -> @commerce.domains.customer_id { kind: domain; }
    candidate r_support_candidate @support.account_ref -> @commerce.domains.customer_id;
    binds r_binding @commerce.domains.customer_id -> @binding;
}
