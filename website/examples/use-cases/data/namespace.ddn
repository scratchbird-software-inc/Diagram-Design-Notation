ddn "0.5";
module "ddn.usecases.namespace";
import "commerce.ddn" as commerce;
import "sql.ddn" as sql;

// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    schema schema "sales schema";
    namespace r_orders_schema @commerce.tables.orders -> @schema;
    namespace r_routine_schema @sql.model.routine -> @schema;
    namespace r_view_schema @sql.model.view -> @schema;
}
