ddn "0.5";
module "ddn.usecases.vectors";

// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    dataset source "Product descriptions";
    activity embedding "Build embeddings" {
        description: "Record the embedding model and preprocessing version before implementation approval.";
    }
    vector index "Product vectors" {
        role: derived;
        fields {
            product_id;
            embedding;
            model_version;
        }
    }
    consumed r_input @source -> @embedding;
    generates r_output @embedding -> @index;
}
