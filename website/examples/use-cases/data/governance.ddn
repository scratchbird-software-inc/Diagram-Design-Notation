ddn "0.5";
module "ddn.usecases.governance";

// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    data_product product "Customer data product";
    dct contract "Customer export contract";
    team team "Customer data team";
    contract r_contract @product -> @contract;
    steward r_owner @contract -> @team {
        scope: "contract stewardship";
    }
}
