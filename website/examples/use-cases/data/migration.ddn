ddn "0.5";
module "ddn.usecases.migration";

// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    table legacy "Customer / legacy" {
        level: instance;
        maturity: deprecated;
        fields {
            id;
            full_name;
        }
    }
    activity convert "Map and reconcile";
    table target "Customer / target" {
        level: instance;
        maturity: draft;
        fields {
            customer_id;
            display_name;
        }
    }
    extract r_extract @legacy -> @convert;
    load r_load @convert -> @target;
}
