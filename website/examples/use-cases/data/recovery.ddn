ddn "0.5";
module "ddn.usecases.recovery";

// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    backup backup "Full backup artifact" {
        description: "A synthetic backup-artifact definition; test evidence would be a separate assertion.";
    }
    activity restore "Restore into isolation";
    database target "Restored database" {
        level: instance;
    }
    restore r_restore @backup -> @restore;
    write r_output @restore -> @target;
}
