ddn "0.5";
module "ddn.usecases.graph";

// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    graph_node customer "Customer node" {
        fields {
            customer_id;
            name;
        }
    }
    graph_edge purchased "PURCHASED edge" {
        fields {
            purchased_at;
            quantity;
        }
    }
    graph_node product "Product node" {
        fields {
            sku;
            title;
        }
    }
    assoc r_source "source node type" @customer -> @purchased;
    assoc r_target "target node type" @purchased -> @product;
}
