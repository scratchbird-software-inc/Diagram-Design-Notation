view "diagram" as "ddn@1"
    with
        id "diagram"
        title "22 / Navigable design documentation"
        selection
            include
                item
                    id "ddn.usecases.commerce::tables.orders"
                item
                    id "ddn.usecases.commerce::tables.customer"
                item
                    id "ddn.usecases.commerce::tables.r_order_customer"
                item
                    id "ddn.usecases.views.linked-documentation::diagram.logical"
                item
                    id "ddn.usecases.views.linked-documentation::diagram.business"
            exclude
                item
                    id "ddn.usecases.commerce::tables.r_line_order"
                item
                    id "ddn.usecases.commerce::concepts.r_places"
                item
                    id "ddn.usecases.commerce::concepts.r_ships"
        layout
            algorithm "grid"
            gap 120
        display
            fields "none"
            maturity "none"
        legend
            mode "numbers"
            width 340
            keys
                tables.r_order_customer "1"
        background
            color "#f6f8fc"
        publication
            id "publication:diagram"

    use "ddn.usecases.commerce::tables.orders" named "appearance:diagram:ddn.usecases.commerce::tables.orders"
        with
            id "appearance:diagram:ddn.usecases.commerce::tables.orders"
            body "title"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.usecases.commerce::tables.customer" named "appearance:diagram:ddn.usecases.commerce::tables.customer"
        with
            id "appearance:diagram:ddn.usecases.commerce::tables.customer"
            body "title"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.usecases.commerce::tables.r_order_customer" named "appearance:diagram:ddn.usecases.commerce::tables.r_order_customer"
        with
            id "appearance:diagram:ddn.usecases.commerce::tables.r_order_customer"

    use "ddn.usecases.views.linked-documentation::diagram.logical" named "appearance:diagram:ddn.usecases.views.linked-documentation::diagram.logical"
        with
            id "appearance:diagram:ddn.usecases.views.linked-documentation::diagram.logical"

    use "ddn.usecases.views.linked-documentation::diagram.business" named "appearance:diagram:ddn.usecases.views.linked-documentation::diagram.business"
        with
            id "appearance:diagram:ddn.usecases.views.linked-documentation::diagram.business"


