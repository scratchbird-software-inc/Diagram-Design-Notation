element "ddn.usecases.commerce::domains.customer_id" as "domain"
    with
        id "ddn.usecases.commerce::domains.customer_id"
        title "Customer identifier"
        content
            meaning "Identifies a customer in the registry."
        notes
            item
                title "Additional source details"
                text
                    {
                      "meaning": "Identifies a customer in the registry."
                    }
                format "plain"


element "ddn.usecases.commerce::domains.order_id" as "domain"
    with
        id "ddn.usecases.commerce::domains.order_id"
        title "Order identifier"
        content
            meaning "Identifies an order in the order book."
        notes
            item
                title "Additional source details"
                text
                    {
                      "meaning": "Identifies an order in the order book."
                    }
                format "plain"


relation "ddn.usecases.flow::stream.r_source_definition" as "instance"
    with
        id "ddn.usecases.flow::stream.r_source_definition"
        title "instance of"
        endpoints
            item
                definition
                    id "ddn.usecases.flow::stream.source"
            item
                definition
                    id "ddn.usecases.commerce::tables.customer"


relation "ddn.usecases.flow::stream.r_capture" as "capture"
    with
        id "ddn.usecases.flow::stream.r_capture"
        title "captures changes into"
        properties
            capture "cdc"
        endpoints
            item
                definition
                    id "ddn.usecases.flow::stream.source"
            item
                definition
                    id "ddn.usecases.flow::stream.capture"


relation "ddn.usecases.flow::stream.r_publish" as "publish"
    with
        id "ddn.usecases.flow::stream.r_publish"
        title "publishes to"
        properties
            transport "Kafka"
        endpoints
            item
                definition
                    id "ddn.usecases.flow::stream.capture"
            item
                definition
                    id "ddn.usecases.flow::stream.topic"


relation "ddn.usecases.flow::stream.r_history_delivery" as "deliver"
    with
        id "ddn.usecases.flow::stream.r_history_delivery"
        title "delivers to"
        properties
            scope "history consumer"
        endpoints
            item
                definition
                    id "ddn.usecases.flow::stream.topic"
            item
                definition
                    id "ddn.usecases.flow::stream.hist_job"


relation "ddn.usecases.flow::stream.r_search_delivery" as "deliver"
    with
        id "ddn.usecases.flow::stream.r_search_delivery"
        title "delivers to"
        properties
            scope "search consumer"
        endpoints
            item
                definition
                    id "ddn.usecases.flow::stream.topic"
            item
                definition
                    id "ddn.usecases.flow::stream.search_job"


relation "ddn.usecases.flow::stream.r_history_write" as "write"
    with
        id "ddn.usecases.flow::stream.r_history_write"
        title "writes output to"
        endpoints
            item
                definition
                    id "ddn.usecases.flow::stream.hist_job"
            item
                definition
                    id "ddn.usecases.flow::stream.history"


relation "ddn.usecases.flow::stream.r_search_write" as "write"
    with
        id "ddn.usecases.flow::stream.r_search_write"
        title "writes output to"
        endpoints
            item
                definition
                    id "ddn.usecases.flow::stream.search_job"
            item
                definition
                    id "ddn.usecases.flow::stream.search"


relation "ddn.usecases.commerce::tables.r_line_order" as "ref"
    with
        id "ddn.usecases.commerce::tables.r_line_order"
        title "references"
        properties
            source_mark "many"
            target_mark "one"
        endpoints
            item
                definition
                    id "ddn.usecases.commerce::tables.line"
                member
                    id "ddn.usecases.commerce::tables.line.order_id"
            item
                definition
                    id "ddn.usecases.commerce::tables.orders"
                member
                    id "ddn.usecases.commerce::tables.orders.order_id"


relation "ddn.usecases.commerce::tables.r_order_customer" as "ref"
    with
        id "ddn.usecases.commerce::tables.r_order_customer"
        title "references"
        properties
            source_mark "zeromany"
            target_mark "one"
        endpoints
            item
                definition
                    id "ddn.usecases.commerce::tables.orders"
                member
                    id "ddn.usecases.commerce::tables.orders.customer_id"
            item
                definition
                    id "ddn.usecases.commerce::tables.customer"
                member
                    id "ddn.usecases.commerce::tables.customer.customer_id"


view "diagram" as "ddn@1"
    with
        id "diagram"
        title "12 / Event publication and consumers"
        selection
            include
                item
                    id "ddn.usecases.flow::stream.source"
                item
                    id "ddn.usecases.flow::stream.capture"
                item
                    id "ddn.usecases.flow::stream.topic"
                item
                    id "ddn.usecases.flow::stream.hist_job"
                item
                    id "ddn.usecases.flow::stream.search_job"
                item
                    id "ddn.usecases.flow::stream.history"
                item
                    id "ddn.usecases.flow::stream.search"
                item
                    id "ddn.usecases.flow::stream.r_capture"
                item
                    id "ddn.usecases.flow::stream.r_publish"
                item
                    id "ddn.usecases.flow::stream.r_history_delivery"
                item
                    id "ddn.usecases.flow::stream.r_search_delivery"
                item
                    id "ddn.usecases.flow::stream.r_history_write"
                item
                    id "ddn.usecases.flow::stream.r_search_write"
            exclude
                item
                    id "ddn.usecases.flow::stream.r_source_definition"
                item
                    id "ddn.usecases.commerce::tables.r_line_order"
                item
                    id "ddn.usecases.commerce::tables.r_order_customer"
        layout
            algorithm "manual"
            gap 120
        display
            fields "none"
            badges "none"
        legend
            mode "numbers"
            width 340
            keys
                stream.r_capture "1"
                stream.r_publish "2"
                stream.r_history_delivery "3"
                stream.r_search_delivery "4"
                stream.r_history_write "5"
                stream.r_search_write "6"
        background
            color "#f6f8fc"
        publication
            id "publication:diagram"

    use "ddn.usecases.flow::stream.source" named "appearance:diagram:ddn.usecases.flow::stream.source"
        with
            id "appearance:diagram:ddn.usecases.flow::stream.source"

    use "ddn.usecases.flow::stream.capture" named "appearance:diagram:ddn.usecases.flow::stream.capture"
        with
            id "appearance:diagram:ddn.usecases.flow::stream.capture"

    use "ddn.usecases.flow::stream.topic" named "appearance:diagram:ddn.usecases.flow::stream.topic"
        with
            id "appearance:diagram:ddn.usecases.flow::stream.topic"

    use "ddn.usecases.flow::stream.hist_job" named "appearance:diagram:ddn.usecases.flow::stream.hist_job"
        with
            id "appearance:diagram:ddn.usecases.flow::stream.hist_job"

    use "ddn.usecases.flow::stream.search_job" named "appearance:diagram:ddn.usecases.flow::stream.search_job"
        with
            id "appearance:diagram:ddn.usecases.flow::stream.search_job"

    use "ddn.usecases.flow::stream.history" named "appearance:diagram:ddn.usecases.flow::stream.history"
        with
            id "appearance:diagram:ddn.usecases.flow::stream.history"

    use "ddn.usecases.flow::stream.search" named "appearance:diagram:ddn.usecases.flow::stream.search"
        with
            id "appearance:diagram:ddn.usecases.flow::stream.search"

    use "ddn.usecases.flow::stream.r_capture" named "appearance:diagram:ddn.usecases.flow::stream.r_capture"
        with
            id "appearance:diagram:ddn.usecases.flow::stream.r_capture"

    use "ddn.usecases.flow::stream.r_publish" named "appearance:diagram:ddn.usecases.flow::stream.r_publish"
        with
            id "appearance:diagram:ddn.usecases.flow::stream.r_publish"

    use "ddn.usecases.flow::stream.r_history_delivery" named "appearance:diagram:ddn.usecases.flow::stream.r_history_delivery"
        with
            id "appearance:diagram:ddn.usecases.flow::stream.r_history_delivery"

    use "ddn.usecases.flow::stream.r_search_delivery" named "appearance:diagram:ddn.usecases.flow::stream.r_search_delivery"
        with
            id "appearance:diagram:ddn.usecases.flow::stream.r_search_delivery"

    use "ddn.usecases.flow::stream.r_history_write" named "appearance:diagram:ddn.usecases.flow::stream.r_history_write"
        with
            id "appearance:diagram:ddn.usecases.flow::stream.r_history_write"

    use "ddn.usecases.flow::stream.r_search_write" named "appearance:diagram:ddn.usecases.flow::stream.r_search_write"
        with
            id "appearance:diagram:ddn.usecases.flow::stream.r_search_write"
