version ddn-next-1

publication "publication:diagram"
    with
        id "publication:diagram"
        title "12 / Event publication and consumers"
        targets
            item
                target
                    id "diagram"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1640
                unit "px"
            height
                value 1090
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.usecases.flow::stream.source" as "table"
    with
        id "ddn.usecases.flow::stream.source"
        title "Customer / production"
        facets
            workload
                item "OLTP"
            authority
                item "AUTH"
        properties
            level "instance"
            role "authoritative"
            workload
                item "oltp"
        metadata
            x_record
                layout_group "authoritative"


element "ddn.usecases.flow::stream.capture" as "activity"
    with
        id "ddn.usecases.flow::stream.capture"
        title "Capture changes"


element "ddn.usecases.flow::stream.topic" as "topic"
    with
        id "ddn.usecases.flow::stream.topic"
        title "customer.changed"
        facets
            workload
                item "STR"
        properties
            workload
                item "streaming"


element "ddn.usecases.flow::stream.hist_job" as "activity"
    with
        id "ddn.usecases.flow::stream.hist_job"
        title "Build customer history"


element "ddn.usecases.flow::stream.search_job" as "activity"
    with
        id "ddn.usecases.flow::stream.search_job"
        title "Build customer search"


element "ddn.usecases.flow::stream.history" as "history"
    with
        id "ddn.usecases.flow::stream.history"
        title "Customer history"
        facets
            authority
                item "DER"
            temporal
                item "BT"
        properties
            temporal "bitemporal"
            role "derived"
        metadata
            x_record
                layout_group "derived"


element "ddn.usecases.flow::stream.search" as "search_index"
    with
        id "ddn.usecases.flow::stream.search"
        title "Customer search"
        facets
            authority
                item "DER"
        properties
            role "derived"
        metadata
            x_record
                layout_group "derived"


element "ddn.usecases.commerce::tables.customer.customer_id" as "field"
    with
        id "ddn.usecases.commerce::tables.customer.customer_id"
        title "customer_id"
        properties
            key "primary"
            domain
                id "ddn.usecases.commerce::domains.customer_id"
        content
            parent
                id "ddn.usecases.commerce::tables.customer"
            ordinal 0
            domain
                id "ddn.usecases.commerce::domains.customer_id"
            key "primary"


element "ddn.usecases.commerce::tables.customer.display_name" as "field"
    with
        id "ddn.usecases.commerce::tables.customer.display_name"
        title "display_name"
        content
