                id "ddn.usecases.commerce::tables.customer"
            ordinal 1


element "ddn.usecases.commerce::tables.customer.status" as "field"
    with
        id "ddn.usecases.commerce::tables.customer.status"
        title "status"
        content
            parent
                id "ddn.usecases.commerce::tables.customer"
            ordinal 2


element "ddn.usecases.commerce::tables.customer" as "table"
    with
        id "ddn.usecases.commerce::tables.customer"
        title "Customer"
        description "Authority for the customer registry, not for every customer attribute in all systems."
        facets
            workload
                item "OLTP"
            authority
                item "AUTH"
        properties
            level "definition"
            workload
                item "oltp"
            role "authoritative"
        metadata
            x_record
                layout_group "authoritative"
        members
            item
                id "ddn.usecases.commerce::tables.customer.customer_id"
            item
                id "ddn.usecases.commerce::tables.customer.display_name"
            item
                id "ddn.usecases.commerce::tables.customer.status"
        data
            columns
                item
                    id "field"
                    label "field"
                item
                    id "type"
                    label "type"
                item
                    id "domain"
                    label "domain"
                item
                    id "constraint"
                    label "constraint"
                item
                    id "key"
                    label "key"
                item
                    id "comment"
                    label "comment"
            rows
                item
                    item "customer_id"
                    item null
                    item
                        id "ddn.usecases.commerce::domains.customer_id"
                    item null
                    item "primary"
                    item null
                item
                    item "display_name"
                    item null
                    item null
                    item null
                    item null
                    item null
                item
                    item "status"
                    item null
                    item null
                    item null
                    item null
                    item null


