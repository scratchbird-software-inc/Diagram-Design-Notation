ddn "0.5";

module "ddn.usecases.views.quality";
// What is the expected outcome for a concrete invalid input?
// Automatic grid placement: no absolute positions or waypoints.
view diagram "21 / Example-driven data quality" {
    data: [@ddn.usecases.quality.model];
    format: @ddn.usecases.formats.shared.technical;
    style: @ddn.usecases.formats.shared.classic;
    layout: @ddn.usecases.formats.shared.row;
    select: [@ddn.usecases.quality.model.input, @ddn.usecases.quality.model.check, @ddn.usecases.quality.model.expected];
    publication { width: 2130px; height: 440px; }
    legend { keys: { "model.r_input": 1, "model.r_result": 2 }; }
}

module "ddn.usecases.formats";
format shared {
    notation core;
    style classic;
    style sketch { look: handDrawn; roughness: 1.8; hachure: true; }
    style neo { look: neo; }
    layout row { algorithm: grid; gap: 120px; }
    layout column { algorithm: grid; columns: 1; gap: 120px; direction: down; }
    layout teaching { algorithm: manual; gap: 120px; }
    display full;
    display compact { fields: none; maturity: none; }
    publication figure { size: content; width: 1580px; height: 440px; margin: 30px; }
    legend numbered { mode: numbers; width: 340px; }
    bundle technical {
        notation: @core;
        style: @classic;
        layout: @row;
        display: @full;
        publication: @figure;
        legend: @numbered;
    }
}

module "ddn.usecases.quality";
// All names, records and architectures in this catalogue are synthetic teaching examples.

data model {
    object shape "Status record" {
        kind: record;
        fields {
            field customer_id;
            field status { presence: required; nullable: false; }
        }
    }
    sample input "Input / intentional invalid value" {
        kind: sample;
        mode: synthetic;
        columns: [@shape.customer_id, @shape.status];
        rows: [["C001", "Active"], ["C002", null]];
    }
    object check "Reject null status" {
        kind: activity;
        description: "A documented expectation; this diagram renderer does not execute the validation.";
    }
    sample expected "Expected accepted rows" {
        kind: sample;
        mode: synthetic;
        columns: [@shape.customer_id, @shape.status];
        rows: [["C001", "Active"]];
    }
    relation r_input @input -> @check { kind: read; }
    relation r_result "expected accepted output" @check -> @expected { kind: write; }
}
