relation "ddn.usecases.temporal::model.r_example" as "example"
    with
        id "ddn.usecases.temporal::model.r_example"
        title "illustrates"
        endpoints
            item
                definition
                    id "ddn.usecases.temporal::model.example"
            item
                definition
                    id "ddn.usecases.temporal::model.history"


view "diagram" as "ddn@1"
    with
        id "diagram"
        title "14 / Valid time and recorded time"
        selection
            include
                item
                    id "ddn.usecases.temporal::model.history"
                item
                    id "ddn.usecases.temporal::model.example"
                item
                    id "ddn.usecases.temporal::model.r_example"
        layout
            algorithm "manual"
            gap 120
        legend
            mode "numbers"
            width 340
            keys
                model.r_example "1"
        background
            color "#f6f8fc"
        publication
            id "publication:diagram"

    use "ddn.usecases.temporal::model.history" named "appearance:diagram:ddn.usecases.temporal::model.history"
        with
            id "appearance:diagram:ddn.usecases.temporal::model.history"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.usecases.temporal::model.example" named "appearance:diagram:ddn.usecases.temporal::model.example"
        with
            id "appearance:diagram:ddn.usecases.temporal::model.example"
            body "columns"

    use "ddn.usecases.temporal::model.r_example" named "appearance:diagram:ddn.usecases.temporal::model.r_example"
        with
            id "appearance:diagram:ddn.usecases.temporal::model.r_example"
