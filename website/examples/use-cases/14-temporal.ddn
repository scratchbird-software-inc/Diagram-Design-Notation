version ddn-next-1

publication "publication:diagram"
    with
        id "publication:diagram"
        title "14 / Valid time and recorded time"
        targets
            item
                target
                    id "diagram"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1700
                unit "px"
            height
                value 850
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.usecases.temporal::model.history.customer_id" as "field"
    with
        id "ddn.usecases.temporal::model.history.customer_id"
        title "customer_id"
        content
            parent
                id "ddn.usecases.temporal::model.history"
            ordinal 0


element "ddn.usecases.temporal::model.history.status" as "field"
    with
        id "ddn.usecases.temporal::model.history.status"
        title "status"
        content
