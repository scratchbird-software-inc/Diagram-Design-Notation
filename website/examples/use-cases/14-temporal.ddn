        title "recorded_to"
        content
            parent
                id "ddn.usecases.temporal::model.history"
            ordinal 5


element "ddn.usecases.temporal::model.history" as "history"
    with
        id "ddn.usecases.temporal::model.history"
        title "Customer status history"
        facets
            temporal
                item "BT"
        properties
            temporal "bitemporal"
            time empty record
        members
