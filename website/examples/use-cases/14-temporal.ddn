            item
                id "ddn.usecases.temporal::model.history.recorded_from"
            item
                id "ddn.usecases.temporal::model.history.recorded_to"
        data
            columns
                item
                    id "field"
                    label "field"
                item
                    id "type"
                    label "type"
                item
                    id "domain"
                    label "domain"
                item
                    id "constraint"
                    label "constraint"
                item
                    id "key"
                    label "key"
                item
                    id "comment"
                    label "comment"
            rows
                item
                    item "customer_id"
                    item null
                    item null
                    item null
                    item null
                    item null
                item
                    item "status"
                    item null
                    item null
                    item null
                    item null
                    item null
                item
                    item "valid_from"
                    item null
                    item null
                    item null
                    item null
                    item null
                item
                    item "valid_to"
                    item null
                    item null
