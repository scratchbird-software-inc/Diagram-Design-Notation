version ddn-next-1

publication "publication:diagram"
    with
        id "publication:diagram"
        title "01 / Whiteboard sketch"
        targets
            item
                target
                    id "diagram"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1580
                unit "px"
            height
                value 440
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


element "ddn.usecases.sketch::model.customer" as "object"
    with
        id "ddn.usecases.sketch::model.customer"
        title "Customer"


element "ddn.usecases.sketch::model.order" as "object"
    with
        id "ddn.usecases.sketch::model.order"
        title "Order"


element "ddn.usecases.sketch::model.shipment" as "object"
    with
        id "ddn.usecases.sketch::model.shipment"
        title "Shipment"


relation "ddn.usecases.sketch::model.r_a" as "assoc"
    with
        id "ddn.usecases.sketch::model.r_a"
        title "places"
        endpoints
            item
                definition
                    id "ddn.usecases.sketch::model.customer"
            item
                definition
                    id "ddn.usecases.sketch::model.order"


relation "ddn.usecases.sketch::model.r_b" as "assoc"
    with
        id "ddn.usecases.sketch::model.r_b"
        title "fulfilled by"
        endpoints
            item
                definition
                    id "ddn.usecases.sketch::model.order"
            item
                definition
                    id "ddn.usecases.sketch::model.shipment"


view "diagram" as "ddn@1"
    with
        id "diagram"
        title "01 / Whiteboard sketch"
        selection
            include
                item
                    id "ddn.usecases.sketch::model.customer"
                item
                    id "ddn.usecases.sketch::model.order"
                item
                    id "ddn.usecases.sketch::model.shipment"
                item
                    id "ddn.usecases.sketch::model.r_a"
                item
                    id "ddn.usecases.sketch::model.r_b"
        style
            look "handdrawn"
            roughness 1.8
        layout
            algorithm "grid"
            gap 120
        legend
            mode "numbers"
            width 340
            keys
                model.r_a "1"
                model.r_b "2"
        background
            color "#f6f8fc"
        publication
            id "publication:diagram"

    use "ddn.usecases.sketch::model.customer" named "appearance:diagram:ddn.usecases.sketch::model.customer"
        with
            id "appearance:diagram:ddn.usecases.sketch::model.customer"

    use "ddn.usecases.sketch::model.order" named "appearance:diagram:ddn.usecases.sketch::model.order"
        with
            id "appearance:diagram:ddn.usecases.sketch::model.order"

    use "ddn.usecases.sketch::model.shipment" named "appearance:diagram:ddn.usecases.sketch::model.shipment"
        with
            id "appearance:diagram:ddn.usecases.sketch::model.shipment"

    use "ddn.usecases.sketch::model.r_a" named "appearance:diagram:ddn.usecases.sketch::model.r_a"
        with
            id "appearance:diagram:ddn.usecases.sketch::model.r_a"

    use "ddn.usecases.sketch::model.r_b" named "appearance:diagram:ddn.usecases.sketch::model.r_b"
        with
            id "appearance:diagram:ddn.usecases.sketch::model.r_b"
