        title "Customer ID / SQL"
        properties
            platform "SQL target not selected"


element "ddn.usecases.commerce::domains.customer_id" as "domain"
    with
        id "ddn.usecases.commerce::domains.customer_id"
        title "Customer identifier"
        content
            meaning "Identifies a customer in the registry."
        notes
            item
                title "Additional source details"
                text
                    {
                      "meaning": "Identifies a customer in the registry."
                    }
                format "plain"


element "ddn.usecases.commerce::domains.order_id" as "domain"
    with
        id "ddn.usecases.commerce::domains.order_id"
        title "Order identifier"
        content
            meaning "Identifies an order in the order book."
        notes
            item
                title "Additional source details"
                text
                    {
                      "meaning": "Identifies an order in the order book."
                    }
                format "plain"


relation "ddn.usecases.commerce::tables.r_line_order" as "ref"
    with
        id "ddn.usecases.commerce::tables.r_line_order"
        title "references"
        properties
            source_mark "many"
            target_mark "one"
        endpoints
            item
                definition
                    id "ddn.usecases.commerce::tables.line"
                member
                    id "ddn.usecases.commerce::tables.line.order_id"
            item
                definition
                    id "ddn.usecases.commerce::tables.orders"
                member
                    id "ddn.usecases.commerce::tables.orders.order_id"


relation "ddn.usecases.commerce::tables.r_order_customer" as "ref"
    with
        id "ddn.usecases.commerce::tables.r_order_customer"
        title "references"
        properties
            source_mark "zeromany"
            target_mark "one"
        endpoints
            item
                definition
                    id "ddn.usecases.commerce::tables.orders"
                member
                    id "ddn.usecases.commerce::tables.orders.customer_id"
            item
                definition
                    id "ddn.usecases.commerce::tables.customer"
                member
                    id "ddn.usecases.commerce::tables.customer.customer_id"


relation "ddn.usecases.domains::model.r_order_domain" as "domain"
    with
        id "ddn.usecases.domains::model.r_order_domain"
        title "uses semantic domain"
        endpoints
            item
                definition
                    id "ddn.usecases.commerce::tables.orders"
                member
                    id "ddn.usecases.commerce::tables.orders.customer_id"
            item
                definition
                    id "ddn.usecases.commerce::domains.customer_id"


relation "ddn.usecases.domains::model.r_support_candidate" as "candidate"
    with
        id "ddn.usecases.domains::model.r_support_candidate"
        title "candidate domain match"
        endpoints
            item
                definition
                    id "ddn.usecases.domains::model.support"
                member
                    id "ddn.usecases.domains::model.support.account_ref"
            item
                definition
                    id "ddn.usecases.commerce::domains.customer_id"


relation "ddn.usecases.domains::model.r_binding" as "binds"
    with
        id "ddn.usecases.domains::model.r_binding"
        title "has representation binding"
        endpoints
            item
                definition
                    id "ddn.usecases.commerce::domains.customer_id"
            item
                definition
                    id "ddn.usecases.domains::model.binding"


view "diagram" as "ddn@1"
    with
        id "diagram"
        title "08 / Domain discovery and binding"
        selection
            include
                item
                    id "ddn.usecases.commerce::tables.orders"
                item
                    id "ddn.usecases.domains::model.support"
                item
                    id "ddn.usecases.commerce::domains.customer_id"
                item
                    id "ddn.usecases.domains::model.binding"
                item
                    id "ddn.usecases.domains::model.r_order_domain"
                item
                    id "ddn.usecases.domains::model.r_support_candidate"
                item
                    id "ddn.usecases.domains::model.r_binding"
            exclude
                item
                    id "ddn.usecases.commerce::tables.r_line_order"
                item
                    id "ddn.usecases.commerce::tables.r_order_customer"
        layout
            algorithm "manual"
            gap 120
        legend
            mode "numbers"
            width 340
            keys
                model.r_order_domain "1"
                model.r_support_candidate "2"
                model.r_binding "3"
        background
            color "#f6f8fc"
        publication
            id "publication:diagram"

    use "ddn.usecases.commerce::tables.orders" named "appearance:diagram:ddn.usecases.commerce::tables.orders"
        with
            id "appearance:diagram:ddn.usecases.commerce::tables.orders"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.usecases.domains::model.support" named "appearance:diagram:ddn.usecases.domains::model.support"
        with
            id "appearance:diagram:ddn.usecases.domains::model.support"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.usecases.commerce::domains.customer_id" named "appearance:diagram:ddn.usecases.commerce::domains.customer_id"
        with
            id "appearance:diagram:ddn.usecases.commerce::domains.customer_id"
            body "notes"

    use "ddn.usecases.domains::model.binding" named "appearance:diagram:ddn.usecases.domains::model.binding"
        with
            id "appearance:diagram:ddn.usecases.domains::model.binding"

    use "ddn.usecases.domains::model.r_order_domain" named "appearance:diagram:ddn.usecases.domains::model.r_order_domain"
        with
            id "appearance:diagram:ddn.usecases.domains::model.r_order_domain"

    use "ddn.usecases.domains::model.r_support_candidate" named "appearance:diagram:ddn.usecases.domains::model.r_support_candidate"
        with
            id "appearance:diagram:ddn.usecases.domains::model.r_support_candidate"

    use "ddn.usecases.domains::model.r_binding" named "appearance:diagram:ddn.usecases.domains::model.r_binding"
        with
            id "appearance:diagram:ddn.usecases.domains::model.r_binding"
