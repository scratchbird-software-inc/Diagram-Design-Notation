version ddn-next-1

publication "publication:diagram"
    with
        id "publication:diagram"
        title "08 / Domain discovery and binding"
        targets
            item
                target
                    id "diagram"
                kind "view"
        format "svg"
        page
            size "content"
            width
                value 1730
                unit "px"
            height
                value 700
                unit "px"
            margin
                top 30
                right 30
                bottom 30
                left 30
            minimum_text 10.666666666666666


