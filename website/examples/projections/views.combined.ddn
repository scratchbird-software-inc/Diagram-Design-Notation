    projection { kind:chart;profile:"chart.basic@1";records:[@meridian.procurement.review.facts.m1, @meridian.procurement.review.facts.m2, @meridian.procurement.review.facts.m3, @meridian.procurement.review.facts.m4, @meridian.procurement.review.facts.m5, @meridian.procurement.review.facts.m6];mark:area;x:"x_record.month";y:"x_record.value";unit:"CAD";width:1120px;height:620px; }

}

view chart_pie "15 / Synthetic monthly value \u2014 pie" {
    data: [@meridian.procurement.review.facts];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:chart;profile:"chart.basic@1";records:[@meridian.procurement.review.facts.m1, @meridian.procurement.review.facts.m2, @meridian.procurement.review.facts.m3, @meridian.procurement.review.facts.m4, @meridian.procurement.review.facts.m5, @meridian.procurement.review.facts.m6];mark:pie;x:"x_record.month";y:"x_record.value";unit:"CAD";width:1120px;height:620px; }

}

view chart_donut "16 / Synthetic monthly value \u2014 donut" {
    data: [@meridian.procurement.review.facts];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:chart;profile:"chart.basic@1";records:[@meridian.procurement.review.facts.m1, @meridian.procurement.review.facts.m2, @meridian.procurement.review.facts.m3, @meridian.procurement.review.facts.m4, @meridian.procurement.review.facts.m5, @meridian.procurement.review.facts.m6];mark:donut;x:"x_record.month";y:"x_record.value";unit:"CAD";width:1120px;height:620px; }

