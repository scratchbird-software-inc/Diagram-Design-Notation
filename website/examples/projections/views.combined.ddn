view scatter "17 / Cost versus recorded value" {
    data: [@meridian.procurement.review.facts];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:chart;profile:"chart.basic@1";records:[@meridian.procurement.review.facts.m1, @meridian.procurement.review.facts.m2, @meridian.procurement.review.facts.m3, @meridian.procurement.review.facts.m4, @meridian.procurement.review.facts.m5, @meridian.procurement.review.facts.m6];mark:point;x:"x_record.cost";x_type:number;y:"x_record.value";size:"x_record.count";unit:"CAD"; }

}

view time_series "18 / UTC monthly observations" {
    data: [@meridian.procurement.review.facts];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:chart;profile:"chart.basic@1";records:[@meridian.procurement.review.facts.m1, @meridian.procurement.review.facts.m2, @meridian.procurement.review.facts.m3, @meridian.procurement.review.facts.m4, @meridian.procurement.review.facts.m5, @meridian.procurement.review.facts.m6];mark:line;x:"x_record.date";x_type:date;y:"x_record.value";unit:"CAD"; }

}

view record_table "19 / Shared observation table" {
    data: [@meridian.procurement.review.facts];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:table;profile:"table.records@1";records:[@meridian.procurement.review.facts.m1, @meridian.procurement.review.facts.m2, @meridian.procurement.review.facts.m3, @meridian.procurement.review.facts.m4, @meridian.procurement.review.facts.m5, @meridian.procurement.review.facts.m6];columns:[{key:"x_record.month",label:"Month"},{key:"x_record.value",label:"Recorded value (CAD)"},{key:"x_record.cost",label:"Illustrative cost (CAD)"},{key:"x_record.count",label:"Count"}]; }

}

view decision_table "20 / Declarative decision-table presentation" {
