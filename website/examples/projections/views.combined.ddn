ddn "0.5";

module "meridian.procurement.views";
view flowchart "01 / Purchasing control flow" {
    data: [@meridian.procurement.review.process];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:graph;profile:"flow.basic@1"; }

}

view responsibility_graph "02 / Shared responsibility assignments" {
    data: [@meridian.procurement.review.process, @meridian.procurement.review.roles, @meridian.procurement.review.responsibilities];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:graph;profile:"ddn@1"; }
    select: [@meridian.procurement.review.process.order, @meridian.procurement.review.process.receive, @meridian.procurement.review.process.post, @meridian.procurement.review.roles.buyer, @meridian.procurement.review.roles.manager, @meridian.procurement.review.roles.warehouse, @meridian.procurement.review.roles.controller];

}

view raci "03 / Model-derived RACI" {
    data: [@meridian.procurement.review.process, @meridian.procurement.review.roles, @meridian.procurement.review.responsibilities];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:matrix;profile:"matrix.raci@1";rows:[@meridian.procurement.review.process.order, @meridian.procurement.review.process.receive, @meridian.procurement.review.process.post];columns:[@meridian.procurement.review.roles.buyer, @meridian.procurement.review.roles.manager, @meridian.procurement.review.roles.warehouse, @meridian.procurement.review.roles.controller];relation:"analysis.assignment";value:"x_assignment.code"; }

}

view crud "04 / Model-derived CRUD" {
    data: [@meridian.procurement.review.process, @meridian.procurement.review.schema, @meridian.procurement.review.access];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:matrix;profile:"matrix.crud@1";rows:[@meridian.procurement.review.process.order, @meridian.procurement.review.process.receive, @meridian.procurement.review.process.post];columns:[@meridian.procurement.review.schema.supplier, @meridian.procurement.review.schema.po, @meridian.procurement.review.schema.receipt];relation:"analysis.access";value:"x_assignment.code"; }

}

view dfd_gane "05 / Numbered Gane\u2013Sarson-style DFD" {
    data: [@meridian.procurement.review.dfd];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:graph;profile:"dfd.gane_sarson@1"; }

}

view dfd_yourdon "06 / Yourdon-style DFD" {
    data: [@meridian.procurement.review.dfd];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:graph;profile:"dfd.yourdon@1"; }

}

view structure "07 / Declared class / interface subset" {
    data: [@meridian.procurement.review.classes];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:graph;profile:"uml.structure@1"; }

}

view usecases "08 / Actor and use-case subset" {
    data: [@meridian.procurement.review.usecases];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:graph;profile:"uml.usecase@1"; }

}

view requirements "09 / Requirement traceability" {
    data: [@meridian.procurement.review.requirements];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:graph;profile:"requirements.basic@1"; }

}

view erd "10 / Entity-field representation" {
    data: [@meridian.procurement.review.schema];
    format: @meridian.procurement.formats.shared.common;
    projection { kind:graph;profile:"ddn@1"; }

}

view chen "11 / Chen binary projection" {
    data: [@meridian.procurement.review.schema];
