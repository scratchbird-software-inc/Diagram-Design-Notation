    format: @meridian.procurement.formats.shared.common;
    projection { kind:chart;profile:"chart.basic@1";records:[@meridian.procurement.review.facts.m1, @meridian.procurement.review.facts.m2, @meridian.procurement.review.facts.m3, @meridian.procurement.review.facts.m4, @meridian.procurement.review.facts.m5, @meridian.procurement.review.facts.m6];mark:bar;x:"x_record.month";y:"x_record.value";unit:"CAD";width:1120px;height:620px; }

