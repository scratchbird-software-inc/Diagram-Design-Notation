element "meridian.procurement.review::process.start" as "flow.start"
    with
        id "meridian.procurement.review::process.start"
        title "Purchase request"


element "meridian.procurement.review::process.capture" as "flow.io"
    with
        id "meridian.procurement.review::process.capture"
        title "Capture requested items"


element "meridian.procurement.review::process.approve" as "flow.decision"
    with
        id "meridian.procurement.review::process.approve"
        title "Approval granted?"


element "meridian.procurement.review::process.order" as "flow.process"
    with
        id "meridian.procurement.review::process.order"
        title "Issue purchase order"
        metadata
            x_record
                start "2026-01-05"
                end "2026-01-07"
                status "Complete"


element "meridian.procurement.review::process.receive" as "flow.process"
    with
        id "meridian.procurement.review::process.receive"
        title "Receive and inspect"
        metadata
            x_record
                start "2026-01-08"
                end "2026-01-12"
                status "Complete"


element "meridian.procurement.review::process.invoice" as "flow.document"
    with
        id "meridian.procurement.review::process.invoice"
        title "Matched supplier invoice"


element "meridian.procurement.review::process.post" as "flow.subprocess"
    with
        id "meridian.procurement.review::process.post"
        title "Post authorized liability"
        metadata
            x_record
                start "2026-01-13"
                end "2026-01-16"
                status "Planned"


element "meridian.procurement.review::process.reject" as "flow.process"
    with
        id "meridian.procurement.review::process.reject"
        title "Return for correction"


element "meridian.procurement.review::process.close" as "flow.end"
    with
        id "meridian.procurement.review::process.close"
        title "Request closed"


relation "meridian.procurement.review::process.p01" as "flow.next"
    with
        id "meridian.procurement.review::process.p01"
        title "Request"
        endpoints
            item
                definition
                    id "meridian.procurement.review::process.start"
            item
                definition
                    id "meridian.procurement.review::process.capture"


relation "meridian.procurement.review::process.p02" as "flow.next"
    with
        id "meridian.procurement.review::process.p02"
        title "Submit"
        endpoints
            item
                definition
                    id "meridian.procurement.review::process.capture"
            item
                definition
                    id "meridian.procurement.review::process.approve"


relation "meridian.procurement.review::process.p03" as "flow.next"
    with
        id "meridian.procurement.review::process.p03"
        title "Approved"
        metadata
            x_diagram
                branch "approved"
        endpoints
            item
                definition
                    id "meridian.procurement.review::process.approve"
            item
                definition
                    id "meridian.procurement.review::process.order"


relation "meridian.procurement.review::process.p04" as "flow.next"
    with
        id "meridian.procurement.review::process.p04"
        title "Rejected"
        metadata
            x_diagram
                branch "rejected"
        endpoints
            item
                definition
                    id "meridian.procurement.review::process.approve"
            item
                definition
                    id "meridian.procurement.review::process.reject"


relation "meridian.procurement.review::process.p05" as "flow.next"
    with
        id "meridian.procurement.review::process.p05"
        title "Receive"
        endpoints
            item
                definition
                    id "meridian.procurement.review::process.order"
            item
                definition
                    id "meridian.procurement.review::process.receive"


relation "meridian.procurement.review::process.p06" as "flow.next"
    with
        id "meridian.procurement.review::process.p06"
        title "Match"
        endpoints
            item
                definition
                    id "meridian.procurement.review::process.receive"
            item
                definition
                    id "meridian.procurement.review::process.invoice"


relation "meridian.procurement.review::process.p07" as "flow.next"
    with
        id "meridian.procurement.review::process.p07"
        title "Authorize"
        endpoints
            item
                definition
                    id "meridian.procurement.review::process.invoice"
            item
                definition
                    id "meridian.procurement.review::process.post"


relation "meridian.procurement.review::process.p08" as "flow.next"
    with
        id "meridian.procurement.review::process.p08"
        title "Complete"
        endpoints
            item
                definition
                    id "meridian.procurement.review::process.post"
            item
                definition
                    id "meridian.procurement.review::process.close"


relation "meridian.procurement.review::process.p09" as "flow.next"
    with
        id "meridian.procurement.review::process.p09"
        title "Notify requester"
        endpoints
            item
                definition
                    id "meridian.procurement.review::process.reject"
            item
                definition
                    id "meridian.procurement.review::process.close"


