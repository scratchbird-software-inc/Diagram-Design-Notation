        title "associated with"
        endpoints
            item
                definition
                    id "ddn.gallery.looks::model.orders"
            item
                definition
                    id "ddn.gallery.looks::model.warehouse"


view "classic_default" as "ddn@1"
    with
        id "classic_default"
        title "Looks / classic × default"
        selection
            include
                item
                    id "ddn.gallery.looks::model.customer"
                item
                    id "ddn.gallery.looks::model.storefront"
                item
                    id "ddn.gallery.looks::model.orders"
                item
                    id "ddn.gallery.looks::model.ledger"
                item
                    id "ddn.gallery.looks::model.warehouse"
                item
                    id "ddn.gallery.looks::model.places"
                item
                    id "ddn.gallery.looks::model.confirms"
                item
                    id "ddn.gallery.looks::model.posts"
                item
                    id "ddn.gallery.looks::model.ships"
        layout
            algorithm "layered"
            gap 120
            row_gap 110
        display
            maturity "none"
            badges "none"
        legend
            width 260
        background
            color "#f6f8fc"
        publication
            id "publication:classic_default"

    use "ddn.gallery.looks::model.customer" named "appearance:classic_default:ddn.gallery.looks::model.customer"
        with
            id "appearance:classic_default:ddn.gallery.looks::model.customer"

    use "ddn.gallery.looks::model.storefront" named "appearance:classic_default:ddn.gallery.looks::model.storefront"
