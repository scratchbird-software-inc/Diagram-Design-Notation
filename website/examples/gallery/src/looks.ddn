element "ddn.gallery.looks::model.customer" as "uml.actor"
    with
        id "ddn.gallery.looks::model.customer"
        title "Customer"


element "ddn.gallery.looks::model.storefront" as "application"
    with
        id "ddn.gallery.looks::model.storefront"
        title "Online storefront"


element "ddn.gallery.looks::model.orders" as "application"
    with
        id "ddn.gallery.looks::model.orders"
        title "Order service"


element "ddn.gallery.looks::model.ledger.order_id" as "field"
    with
        id "ddn.gallery.looks::model.ledger.order_id"
        title "order_id"
        content
            parent
                id "ddn.gallery.looks::model.ledger"
            ordinal 0


element "ddn.gallery.looks::model.ledger.amount" as "field"
    with
        id "ddn.gallery.looks::model.ledger.amount"
        title "amount"
        content
            parent
                id "ddn.gallery.looks::model.ledger"
            ordinal 1


element "ddn.gallery.looks::model.ledger" as "table"
    with
        id "ddn.gallery.looks::model.ledger"
        title "Sales ledger"
        members
            item
                id "ddn.gallery.looks::model.ledger.order_id"
            item
                id "ddn.gallery.looks::model.ledger.amount"
        data
            columns
                item
                    id "field"
                    label "field"
                item
                    id "type"
                    label "type"
                item
                    id "domain"
                    label "domain"
                item
                    id "constraint"
                    label "constraint"
                item
                    id "key"
                    label "key"
                item
                    id "comment"
                    label "comment"
            rows
                item
                    item "order_id"
                    item null
                    item null
                    item null
                    item null
                    item null
                item
                    item "amount"
                    item null
                    item null
                    item null
                    item null
                    item null


element "ddn.gallery.looks::model.warehouse" as "flow.process"
    with
        id "ddn.gallery.looks::model.warehouse"
        title "Warehouse dispatch"


relation "ddn.gallery.looks::model.places" as "assoc"
    with
        id "ddn.gallery.looks::model.places"
        title "associated with"
        endpoints
            item
                definition
                    id "ddn.gallery.looks::model.customer"
            item
                definition
                    id "ddn.gallery.looks::model.storefront"


relation "ddn.gallery.looks::model.confirms" as "assoc"
    with
