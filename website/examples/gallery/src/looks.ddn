    use "ddn.gallery.looks::model.ledger" named "appearance:classic_default:ddn.gallery.looks::model.ledger"
        with
            id "appearance:classic_default:ddn.gallery.looks::model.ledger"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.gallery.looks::model.warehouse" named "appearance:classic_default:ddn.gallery.looks::model.warehouse"
        with
            id "appearance:classic_default:ddn.gallery.looks::model.warehouse"

