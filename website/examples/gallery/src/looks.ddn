ddn "0.4";
module "ddn.gallery.looks";

// Gallery look/palette sheet. One small order-to-cash graph rendered in every
// look (classic, handDrawn, neo) crossed with every palette theme
// (default, neutral, dark, night, forest, base).
data model {
    object customer "Customer" { kind: actor; }
    object storefront "Online storefront" { kind: application; }
    object orders "Order service" { kind: application; }
    object ledger "Sales ledger" { kind: table; fields { field order_id; field amount; } }
    object warehouse "Warehouse dispatch" { kind: process; }
    relation places @customer -> @storefront { kind: assoc; }
    relation confirms @storefront -> @orders { kind: assoc; }
    relation posts @orders -> @ledger { kind: assoc; }
    relation ships @orders -> @warehouse { kind: assoc; }
}

format gallery {
    layout flow_right { algorithm: layered; direction: right; routing: orthogonal; gap: 120px; row_gap: 110px; }
    display readable { kind: icon_token; fields: names; badges: none; maturity: none; }
    publication screen { size: content; fit: none; minimum_text: 8pt; }
    legend key { mode: text; placement: right; width: 260px; }
}

view classic_default "Looks / classic × default" {
    data: [@model]; layout: @gallery.flow_right; display: @gallery.readable; publication: @gallery.screen; legend: @gallery.key;
    style { look: classic; theme: default; }
}
view classic_neutral "Looks / classic × neutral" {
    data: [@model]; layout: @gallery.flow_right; display: @gallery.readable; publication: @gallery.screen; legend: @gallery.key;
    style { look: classic; theme: neutral; }
}
view classic_dark "Looks / classic × dark" {
    data: [@model]; layout: @gallery.flow_right; display: @gallery.readable; publication: @gallery.screen; legend: @gallery.key;
    style { look: classic; theme: dark; }
}
view classic_night "Looks / classic × night" {
    data: [@model]; layout: @gallery.flow_right; display: @gallery.readable; publication: @gallery.screen; legend: @gallery.key;
    style { look: classic; theme: night; }
