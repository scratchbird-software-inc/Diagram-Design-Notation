view classic_forest "Looks / classic × forest" {
    data: [@model]; layout: @gallery.flow_right; display: @gallery.readable; publication: @gallery.screen; legend: @gallery.key;
    style { look: classic; theme: forest; }
}
view classic_base "Looks / classic × base" {
    data: [@model]; layout: @gallery.flow_right; display: @gallery.readable; publication: @gallery.screen; legend: @gallery.key;
    style { look: classic; theme: base; }
