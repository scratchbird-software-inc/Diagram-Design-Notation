element "ddn.gallery.layouts::model.holding" as "context"
    with
        id "ddn.gallery.layouts::model.holding"
        title "Meridian Holdings"
        metadata
            x_record
                layout_group "group"
        notes
            item
                title "Additional source details"
                text
                    {
                      "role": "group"
                    }
                format "plain"


