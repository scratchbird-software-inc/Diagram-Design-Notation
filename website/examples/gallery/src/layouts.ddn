view "grid" as "ddn@1"
    with
        id "grid"
        title "Layouts / grid"
        selection
            include
                item
                    id "ddn.gallery.layouts::model.holding"
                item
                    id "ddn.gallery.layouts::model.energy"
                item
                    id "ddn.gallery.layouts::model.freight"
                item
                    id "ddn.gallery.layouts::model.media"
                item
                    id "ddn.gallery.layouts::model.wind"
                item
                    id "ddn.gallery.layouts::model.solar"
                item
                    id "ddn.gallery.layouts::model.own_e"
                item
                    id "ddn.gallery.layouts::model.own_f"
                item
                    id "ddn.gallery.layouts::model.own_m"
                item
                    id "ddn.gallery.layouts::model.split_w"
                item
                    id "ddn.gallery.layouts::model.split_s"
        layout
            algorithm "grid"
            gap 112
            row_gap 112
        display
            fields "none"
            maturity "none"
            badges "none"
        legend
            width 260
        background
            color "#f6f8fc"
        publication
            id "publication:grid"

    use "ddn.gallery.layouts::model.holding" named "appearance:grid:ddn.gallery.layouts::model.holding"
        with
            id "appearance:grid:ddn.gallery.layouts::model.holding"

    use "ddn.gallery.layouts::model.energy" named "appearance:grid:ddn.gallery.layouts::model.energy"
        with
            id "appearance:grid:ddn.gallery.layouts::model.energy"

    use "ddn.gallery.layouts::model.freight" named "appearance:grid:ddn.gallery.layouts::model.freight"
        with
