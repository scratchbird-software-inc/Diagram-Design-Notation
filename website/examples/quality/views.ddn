relation "meridian.quality.notations::flow.a" as "flow.next"
    with
        id "meridian.quality.notations::flow.a"
        title "Receive"
        endpoints
            item
                definition
                    id "meridian.quality.notations::flow.start"
            item
                definition
                    id "meridian.quality.notations::flow.inspect"


relation "meridian.quality.notations::flow.b" as "flow.next"
    with
        id "meridian.quality.notations::flow.b"
        title "Evaluate"
        endpoints
            item
                definition
                    id "meridian.quality.notations::flow.inspect"
            item
                definition
                    id "meridian.quality.notations::flow.decision"


relation "meridian.quality.notations::flow.pass" as "flow.next"
    with
        id "meridian.quality.notations::flow.pass"
        title "Accept"
        metadata
            x_diagram
                branch "accept"
        endpoints
            item
                definition
                    id "meridian.quality.notations::flow.decision"
            item
                definition
                    id "meridian.quality.notations::flow.store"


relation "meridian.quality.notations::flow.fail" as "flow.next"
    with
        id "meridian.quality.notations::flow.fail"
        title "Reject"
        metadata
            x_diagram
                branch "reject"
        endpoints
            item
                definition
                    id "meridian.quality.notations::flow.decision"
            item
                definition
                    id "meridian.quality.notations::flow.reject"


relation "meridian.quality.notations::flow.c" as "flow.next"
    with
        id "meridian.quality.notations::flow.c"
        title "Continue"
        endpoints
            item
                definition
                    id "meridian.quality.notations::flow.store"
            item
                definition
                    id "meridian.quality.notations::flow.out"


relation "meridian.quality.notations::flow.d" as "flow.next"
    with
        id "meridian.quality.notations::flow.d"
        title "Continue"
        endpoints
            item
                definition
                    id "meridian.quality.notations::flow.reject"
            item
                definition
                    id "meridian.quality.notations::flow.out"


relation "meridian.quality.notations::flow.e" as "flow.next"
    with
        id "meridian.quality.notations::flow.e"
        title "Resume"
        endpoints
            item
                definition
                    id "meridian.quality.notations::flow.in"
            item
                definition
                    id "meridian.quality.notations::flow.connector"


relation "meridian.quality.notations::flow.f" as "flow.next"
    with
        id "meridian.quality.notations::flow.f"
        title "Close"
        endpoints
            item
                definition
                    id "meridian.quality.notations::flow.connector"
            item
                definition
                    id "meridian.quality.notations::flow.end"


relation "meridian.quality.notations::flow.continuation" as "flow.continues"
    with
        id "meridian.quality.notations::flow.continuation"
        title "QC-A continuation"
        endpoints
            item
                definition
                    id "meridian.quality.notations::flow.out"
            item
                definition
                    id "meridian.quality.notations::flow.in"


relation "meridian.quality.notations::flow.annotation" as "flow.annotation"
    with
        id "meridian.quality.notations::flow.annotation"
        title "Evidence note"
        endpoints
            item
                definition
                    id "meridian.quality.notations::flow.note"
            item
                definition
                    id "meridian.quality.notations::flow.store"


