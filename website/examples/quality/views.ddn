relation "meridian.quality.review::lifecycle.investigated" as "state.transition"
    with
        id "meridian.quality.review::lifecycle.investigated"
        title "investigated"
        metadata
            x_transition
                event "investigated"
        endpoints
            item
                definition
                    id "meridian.quality.review::lifecycle.investigate"
            item
                definition
                    id "meridian.quality.review::lifecycle.correct"


relation "meridian.quality.review::lifecycle.verify_ok" as "state.transition"
    with
        id "meridian.quality.review::lifecycle.verify_ok"
        title "verify ok"
        metadata
            x_transition
                event "verify"
                guard
                    passed
                        op "eq"
                        value true
        endpoints
            item
                definition
                    id "meridian.quality.review::lifecycle.correct"
            item
                definition
                    id "meridian.quality.review::lifecycle.verified"


relation "meridian.quality.review::lifecycle.verify_fail" as "state.transition"
    with
        id "meridian.quality.review::lifecycle.verify_fail"
        title "verify fail"
        metadata
            x_transition
                event "verify"
                guard
                    passed
                        op "eq"
                        value false
        endpoints
            item
                definition
                    id "meridian.quality.review::lifecycle.correct"
            item
                definition
                    id "meridian.quality.review::lifecycle.investigate"


relation "meridian.quality.review::lifecycle.close" as "state.transition"
    with
        id "meridian.quality.review::lifecycle.close"
        title "close"
        metadata
            x_transition
                event "close"
        endpoints
            item
                definition
                    id "meridian.quality.review::lifecycle.verified"
            item
                definition
                    id "meridian.quality.review::lifecycle.closed"


element "passed" as "domain"
    with
        id "state-input:passed"
        title "passed"
        content
            allowed_values
                type "boolean"
                optional true


element "state-trace:lifecycle_trace:0" as "record"
    with
        id "state-trace:lifecycle_trace:0"
        title "Trace 1"
        metadata
            x_record
                events
                    item
                        event "submit"
                    item
                        event "accept"
                    item
                        event "investigated"
                    item
                        event "verify"
                        values
                            passed false
                    item
                        event "investigated"
                    item
                        event "verify"
                        values
                            passed true
                    item
                        event "close"
                expected
                    id "meridian.quality.review::lifecycle.closed"


