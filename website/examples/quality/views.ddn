            id "appearance:lifecycle_trace:meridian.quality.review::lifecycle.verify_ok"

    use "meridian.quality.review::lifecycle.verify_fail" named "appearance:lifecycle_trace:meridian.quality.review::lifecycle.verify_fail"
        with
            id "appearance:lifecycle_trace:meridian.quality.review::lifecycle.verify_fail"

    use "meridian.quality.review::lifecycle.close" named "appearance:lifecycle_trace:meridian.quality.review::lifecycle.close"
        with
            id "appearance:lifecycle_trace:meridian.quality.review::lifecycle.close"


