                item
                    id "ddn.live.pinned-patterns::network.document"
        layout
            algorithm "circular"
            center "pins"
            routing "curved"
            gap 112
            row_gap 112
        display
            maturity "none"
        legend
            mode "numbers"
            width 330
            keys
                network.submit "1"
                network.route "2"
                network.reserve "3"
                network.plan "4"
                network.persist "5"
                network.publish "6"
                network.history_projection "7"
                network.monitor "8"
                network.document "9"
        background
            color "#f6f8fc"
        publication
            id "publication:circular"

