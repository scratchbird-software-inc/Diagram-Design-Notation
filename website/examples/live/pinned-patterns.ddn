                item
                    id "ddn.live.pinned-patterns::network.submit"
                item
                    id "ddn.live.pinned-patterns::network.route"
                item
                    id "ddn.live.pinned-patterns::network.reserve"
                item
                    id "ddn.live.pinned-patterns::network.plan"
