            item
                target
                    id "pinned_crossing"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:obstacle"
    with
        id "publication:obstacle"
        title "Named field endpoints / route around an unrelated box"
