version ddn-next-1

publication "publication:automatic"
    with
        id "publication:automatic"
        title "Adaptive order flow / no positional coordinates"
        targets
            item
                target
                    id "automatic"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:ports_first"
    with
        id "publication:ports_first"
        title "1 / Move connection points before moving boxes"
        targets
            item
                target
                    id "ports_first"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:move_unpinned"
    with
        id "publication:move_unpinned"
        title "2 / Move unpinned nodes after connection-point trials"
        targets
            item
                target
                    id "move_unpinned"
                kind "view"
        format "svg"
        page
            size "content"
            fit "none"
            minimum_text 10.666666666666666


publication "publication:pinned_crossing"
    with
        id "publication:pinned_crossing"
        title "3 / Short pinned routes with explicit nonconnection marks"
