view "automatic" as "ddn@1"
    with
        id "automatic"
        title "Adaptive order flow / no positional coordinates"
        selection
            include
                item
                    id "ddn.live.adaptive-lab::pipeline.client"
                item
                    id "ddn.live.adaptive-lab::pipeline.validate"
                item
                    id "ddn.live.adaptive-lab::pipeline.catalog"
                item
                    id "ddn.live.adaptive-lab::pipeline.stock"
                item
                    id "ddn.live.adaptive-lab::pipeline.orders"
                item
                    id "ddn.live.adaptive-lab::pipeline.events"
                item
                    id "ddn.live.adaptive-lab::pipeline.reports"
                item
                    id "ddn.live.adaptive-lab::pipeline.submit"
                item
                    id "ddn.live.adaptive-lab::pipeline.lookup"
                item
                    id "ddn.live.adaptive-lab::pipeline.reserve"
                item
                    id "ddn.live.adaptive-lab::pipeline.persist"
                item
                    id "ddn.live.adaptive-lab::pipeline.publish"
                item
                    id "ddn.live.adaptive-lab::pipeline.project"
            exclude
                item
                    id "ddn.live.adaptive-lab::ports.r0"
                item
                    id "ddn.live.adaptive-lab::ports.r1"
                item
                    id "ddn.live.adaptive-lab::ports.r2"
                item
                    id "ddn.live.adaptive-lab::ports.r3"
                item
                    id "ddn.live.adaptive-lab::movement.r0"
                item
                    id "ddn.live.adaptive-lab::movement.r1"
                item
                    id "ddn.live.adaptive-lab::movement.r2"
                item
                    id "ddn.live.adaptive-lab::movement.r3"
                item
                    id "ddn.live.adaptive-lab::locked.horizontal"
                item
                    id "ddn.live.adaptive-lab::locked.vertical"
                item
                    id "ddn.live.adaptive-lab::blockers.a_c"
        style
            theme "night"
        layout
            center "pins"
            gap 90
            algorithm "auto"
        display
            maturity "none"
        legend
            mode "numbers"
            width 320
            keys
                pipeline.submit "1"
                pipeline.lookup "2"
                pipeline.reserve "3"
                pipeline.persist "4"
                pipeline.publish "5"
                pipeline.project "6"
        publication
            id "publication:automatic"

    use "ddn.live.adaptive-lab::pipeline.client" named "appearance:automatic:ddn.live.adaptive-lab::pipeline.client"
        with
            id "appearance:automatic:ddn.live.adaptive-lab::pipeline.client"

    use "ddn.live.adaptive-lab::pipeline.validate" named "appearance:automatic:ddn.live.adaptive-lab::pipeline.validate"
        with
            id "appearance:automatic:ddn.live.adaptive-lab::pipeline.validate"

    use "ddn.live.adaptive-lab::pipeline.catalog" named "appearance:automatic:ddn.live.adaptive-lab::pipeline.catalog"
        with
            id "appearance:automatic:ddn.live.adaptive-lab::pipeline.catalog"
            body "columns"
            column_visibility
                field "shown"
                type "hidden"
                domain "hidden"
                constraint "hidden"
                key "hidden"
                comment "hidden"
            table
                header false

    use "ddn.live.adaptive-lab::pipeline.stock" named "appearance:automatic:ddn.live.adaptive-lab::pipeline.stock"
