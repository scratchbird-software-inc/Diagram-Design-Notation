ddn "0.5";
module "tests.compact";
// B1-037 equivalence-gate fixture (compact side). Paired with model-verbose.ddn:
// both must build to the same semanticJSON, byte-identical SVG and identical
// validation outcomes.
// B1-041 phase 5: reuse definitions — named field group, relation property
// set, motion preset and an include-by-reference fragment.
fields audited { version: 1; created_at; updated_at { datatype: "timestamp"; } }
relation_props softref { enforcement: undecided; }
preset slow_pulse { motion: pulse; speed: 40; }
fragment note_pair { object note_src "Note source" {} object note_dst "Note sink" {} }
data model {
 use: @note_pair;
 table customer "Customer" {
  fields {
   use: @audited;
   customer_id { key: primary; datatype: "uuid"; }
   display_name "Display name";
   field email "Email" { nullable: true; }
   address { shape: object;
    fields { street; city; }
   }
  }
 }
 queue inbound "Inbound orders" {
  ports {
   input { direction: in; }
   port output "Output" { direction: out; }
  }
 }
 topic events;
 actor visitor "Site visitor" {}
 activity fulfil "Fulfil order";
 view customer_summary "Customer summary" {}
 domain money "Money";
 sample customers_sample { columns: [@customer.customer_id]; rows: [["c1"]]; }
 // B1-038 phase 2: verb-keyword relations (registry alias transfers_to ≡ kind:
 // flow; brackets ≡ source_mark/target_mark, omitted bracket ≡ omitted mark).
 transfers_to places @customer.customer_id -> @inbound.input { use: @slow_pulse; }
 assoc actor_link @visitor [one] -> @fulfil [zeromany];
 ref doc_link @note_src -> @note_dst { use: @softref; }
 // B1-038 phase 2: named batch — shared properties merge under per-entry ones.
 relations depends {
  enforcement: undecided;
  fulfil_dep "Fulfil dependency" @fulfil -> @inbound;
  summary_dep @customer_summary -> @customer { lane: hot; }
 }
}
view main "Main" {
 data: [@model];
 legend { mode: numbers; keys: { places: 3, actor_link: 9, fulfil_dep: 4, summary_dep: 5, doc_link: 7 }; }
 publication { size: content; fit: none; }
}
view subset "Subset" {
 data: [@model];
 select: [@model.customer, @model.inbound, @model.events];
}
// B1-039 phase 3: one-line view header ≡ canonical data + projection; the
// body merges exactly like canonical properties/groups.
view header "Header form": @model as "ddn@1" {
 select: [@model.customer];
 publication { size: content; fit: none; }
}
// B1-040 phase 4: keyed tabular records ≡ one canonical record object per row
// (missing/null keep their semantics; a missing label falls back to the row id).
records metrics {
 columns: label, value, unit;
 label_column: label;
 row m1: "Alpha", 10, "ms";
 row m2: "Beta", 20, "ms";
 row m3: missing, null, "ms" { note: "outlier"; };
}
view metrics_graph "Metrics / graph" {
 data: [@metrics];
 publication { size: content; fit: none; }
}
view metrics_chart "Metrics / chart" {
 data: [@metrics];
 projection { kind: chart; profile: "chart.basic@1"; records: [@metrics.m1, @metrics.m2]; mark: bar; x: "x_record.label"; y: "x_record.value"; unit: "ms"; width: 900px; height: 560px; }
 publication { size: content; fit: none; }
}
