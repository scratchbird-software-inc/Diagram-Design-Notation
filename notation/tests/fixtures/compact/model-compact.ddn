ddn "0.5";
module "tests.compact";
// B1-037 equivalence-gate fixture (compact side). Paired with model-verbose.ddn:
// both must build to the same semanticJSON, byte-identical SVG and identical
// validation outcomes.
data model {
 table customer "Customer" {
  fields {
   customer_id { key: primary; datatype: "uuid"; }
   display_name "Display name";
   field email "Email" { nullable: true; }
   address { shape: object;
    fields { street; city; }
   }
  }
 }
 queue inbound "Inbound orders" {
  ports {
   input { direction: in; }
   port output "Output" { direction: out; }
  }
 }
 topic events;
 actor visitor "Site visitor" {}
 activity fulfil "Fulfil order";
 view customer_summary "Customer summary" {}
 domain money "Money";
 sample customers_sample { columns: [@customer.customer_id]; rows: [["c1"]]; }
 // B1-038 phase 2: verb-keyword relations (registry alias transfers_to ≡ kind:
 // flow; brackets ≡ source_mark/target_mark, omitted bracket ≡ omitted mark).
 transfers_to places @customer.customer_id -> @inbound.input;
 assoc actor_link @visitor [one] -> @fulfil [zeromany];
 // B1-038 phase 2: named batch — shared properties merge under per-entry ones.
 relations depends {
  enforcement: undecided;
  fulfil_dep "Fulfil dependency" @fulfil -> @inbound;
  summary_dep @customer_summary -> @customer { lane: hot; }
 }
}
view main "Main" {
 data: [@model];
 legend { mode: numbers; keys: { places: 3, actor_link: 9, fulfil_dep: 4, summary_dep: 5 }; }
 publication { size: content; fit: none; }
}
view subset "Subset" {
 data: [@model];
 select: [@model.customer, @model.inbound, @model.events];
}
