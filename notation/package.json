  "license": "GPL-2.0-or-later",
  "main": "dist/ddn.global.js",
  "module": "dist/ddn.mjs",
  "types": "dist/ddn.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/ddn.d.mts",
        "default": "./dist/ddn.mjs"
      },
      "require": {
        "types": "./dist/ddn.d.ts",
        "default": "./dist/ddn.global.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/ddn-core.d.mts",
        "default": "./dist/ddn-core.mjs"
      },
      "require": {
        "types": "./dist/ddn-core.d.ts",
        "default": "./dist/ddn-core.js"
      }
    },
    "./graph": {
      "import": {
        "types": "./dist/ddn-graph.d.mts",
        "default": "./dist/ddn-graph.mjs"
      },
      "require": {
        "types": "./dist/ddn-graph.d.ts",
        "default": "./dist/ddn-graph.js"
      }
    },
    "./projections": {
      "import": {
        "types": "./dist/ddn-projections.d.mts",
        "default": "./dist/ddn-projections.mjs"
      },
      "require": {
        "types": "./dist/ddn-projections.d.ts",
        "default": "./dist/ddn-projections.js"
      }
    },
    "./quality": {
      "import": {
        "types": "./dist/ddn-quality.d.mts",
        "default": "./dist/ddn-quality.mjs"
      },
      "require": {
        "types": "./dist/ddn-quality.d.ts",
        "default": "./dist/ddn-quality.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "dist/*.js"
